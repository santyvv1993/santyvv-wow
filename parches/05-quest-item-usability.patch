+// El cliente pregunta, para un NPC de mision, cuales de esos items le sirven al jugador.
+// Formato de la respuesta verificado contra el volcado del cliente oficial (12.1.0.69933),
+// 74 de 74 muestras consumidas exactas (ver docs/ANALISIS-PAQUETES-PENDIENTES.md):
+//   PackedGuid QuestGiverGUID   (se refleja el del pedido)
+//   uint32     Result           (1 en las 74 muestras)
+//   uint32     ItemGuidCount
+//   PackedGuid ItemGUID
+//   uint8      IsUsable
+void WorldSession::HandleQueryQuestItemUsability(WorldPackets::Quest::QueryQuestItemUsability& packet)
+{
+    WorldPacket data(SMSG_QUEST_ITEM_USABILITY_RESPONSE, 20 + packet.ItemGuids.size() * 12);
+    data << packet.QuestGiverGUID;
+    data << uint32(1);
+    data << uint32(packet.ItemGuids.size());
+
+    for (ObjectGuid const& itemGuid : packet.ItemGuids)
+    {
+        data << itemGuid;
+
+        // La semantica exacta de la bandera esta pendiente de capturar (en el oficial las 74
+        // muestras venian en 0), asi que solo se marca lo verificable: que el jugador lo tenga.
+        bool usable = itemGuid.IsItem() && _player->GetItemByGuid(itemGuid) != nullptr;
+        data << uint8(usable ? 1 : 0);
+    }
+
+    SendPacket(&data);
+}
