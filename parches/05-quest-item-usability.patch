+void QueryQuestItemUsability::Read()
+{
+    _worldPacket >> QuestGiverGUID;
+
+    uint32 itemGuidCount = 0;
+    _worldPacket >> itemGuidCount;
+
+    // El conteo viene del cliente: se acota antes de reservar para que un paquete malformado
+    // no pida una reserva gigante.
+    if (itemGuidCount > 100)
+        itemGuidCount = 100;
+
+    ItemGuids.resize(itemGuidCount);
+    for (ObjectGuid& itemGuid : ItemGuids)
+        _worldPacket >> itemGuid;
+}
