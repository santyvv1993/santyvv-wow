+// Deposito y retiro de oro del banco de cuenta (el "banco de tropa" del cliente).
+// Estaban como Handle_NULL: el cliente mandaba el pedido y no pasaba nada. El formato del pedido
+// (guid del banquero + uint64 de cobre) y el de la respuesta (el servidor actualiza Coinage y
+// AccountBankCoinage del jugador) estan verificados contra la captura del oficial del 27-sep-2026.
+// El oro del banco NO lo persistia el core: lo guarda Player::SetAccountBankMoney en la tabla
+// character_account_bank, y se carga al entrar (Player::LoadAccountBankMoney).
+void WorldSession::HandleAccountBankDepositMoney(WorldPackets::Bank::AccountBankDepositMoney const& accountBankDepositMoney)
+{
+    if (!CanUseBank(accountBankDepositMoney.Banker))
+        return;
+
+    if (accountBankDepositMoney.Money == 0)
+        return;
+
+    if (!_player->HasEnoughMoney(accountBankDepositMoney.Money))
+    {
+        _player->SendEquipError(EQUIP_ERR_NOT_ENOUGH_MONEY, nullptr, nullptr);
+        return;
+    }
+
+    _player->ModifyMoney(-int64(accountBankDepositMoney.Money));
+    _player->SetAccountBankMoney(_player->GetAccountBankMoney() + accountBankDepositMoney.Money);
+}
+
+void WorldSession::HandleAccountBankWithdrawMoney(WorldPackets::Bank::AccountBankWithdrawMoney const& accountBankWithdrawMoney)
+{
+    if (!CanUseBank(accountBankWithdrawMoney.Banker))
+        return;
+
+    if (accountBankWithdrawMoney.Money == 0)
+        return;
+
+    if (_player->GetAccountBankMoney() < accountBankWithdrawMoney.Money)
+        return;
+
+    _player->SetAccountBankMoney(_player->GetAccountBankMoney() - accountBankWithdrawMoney.Money);
+    _player->ModifyMoney(int64(accountBankWithdrawMoney.Money));
+}
