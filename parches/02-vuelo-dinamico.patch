+// ----------------------------------------------------------------------------
+// el estado de vuelo
+// ----------------------------------------------------------------------------
+bool Mgr::CumpleRequisito(Player* jugador) const
+{
+    // Sin filas en vuelo_requisito no se exige nada (servidor de pruebas).
+    if (_requisitos.empty())
+        return true;
+
+    for (uint32 hechizo : _requisitos)
+        if (jugador->HasSpell(hechizo))
+            return true;
+
+    return false;
+}
+
+Modo Mgr::ModoDe(Player* jugador) const
+{
+    if (!jugador)
+        return Modo::Ninguno;
+
+    if (jugador->HasAura(AuraEstable()))
+        return Modo::Estable;
+    if (jugador->HasAura(AuraCielonautica()))
+        return Modo::Cielonautica;
+
+    return Modo::Ninguno;
+}
+
+bool Mgr::CapacidadEsVoladora(uint32 capacidadMontura) const
+{
+    // La capacidad que trae el propio hechizo de la montura dice si vuela.
+    if (MountCapabilityEntry const* capacidad = sMountCapabilityStore.LookupEntry(capacidadMontura))
+        return (capacidad->Flags & MOUNT_CAPABILITY_FLAG_FLYING) != 0;
+
+    // Montura sin capacidad declarada: manda la config (0 = se queda de tierra)
+    return ConfigNumero("volar_con_cualquier_montura", 0) != 0;
+}
+
+ReglaZona Mgr::ReglaDeZona(Player* jugador) const
+{
+    if (!jugador || _zonas.empty())
+        return ReglaZona::Todo;
+
+    // Se mira la zona del jugador y sus padres: una regla puesta en "Khaz Algar" alcanza a
+    // todas sus sub-zonas, asi una fila cubre la region entera.
+    for (uint32 areaId = jugador->GetAreaId(); areaId;)
+    {
+        auto it = _zonas.find(areaId);
+        if (it != _zonas.end())
+            return it->second.Regla;
+
+        AreaTableEntry const* area = sAreaTableStore.LookupEntry(areaId);
+        if (!area || int32(area->ParentAreaID) == int32(areaId) || area->ParentAreaID == 0)
+            break;
+
+        areaId = uint32(area->ParentAreaID);
+    }
+
+    return ReglaZona::Todo;
+}
+
+void Mgr::AplicarAlMontar(Unit* objetivo, uint32 capacidadMontura)
+{
+    if (!objetivo || !Habilitado())
+        return;
+
+    Player* jugador = objetivo->ToPlayer();
+    if (!jugador)
+        return;
+
+    // La montura vuela (setCanFly) para cualquiera que tenga la equitacion que declare la base.
+    if (!CumpleRequisito(jugador))
+        return;
+
+    // Montura de tierra: no se le enciende el vuelo. Lo decide la capacidad del hechizo, no el
+    // nombre de la montura (asi un caballo no sale volando).
+    if (!CapacidadEsVoladora(capacidadMontura))
+    {
+        TC_LOG_DEBUG("scripts.vuelo", "vuelo dinamico: {} monta una montura de tierra (capacidad {}): sin vuelo",
+            jugador->GetName(), capacidadMontura);
+        return;
+    }
+
+    // La zona puede prohibir el vuelo por completo o dejar solo el estatico.
+    ReglaZona regla = ReglaDeZona(jugador);
+    if (regla == ReglaZona::Nada)
+    {
+        TC_LOG_DEBUG("scripts.vuelo", "vuelo dinamico: {} monta pero la zona {} no permite volar",
+            jugador->GetName(), jugador->GetAreaId());
+        return;
+    }
+
+    objetivo->SetCanFly(true);
+
+    bool dinamico = ModoDe(jugador) != Modo::Estable && regla != ReglaZona::Estable;
+
+    if (!dinamico)
+    {
+        // Vuelo estable: sin inercia, sin doble salto y sin vigor (las capacidades 455/456/457
+        // del cliente exigen justamente esta aura para el vuelo estatico).
+        objetivo->SetCanAdvFly(false);
+        objetivo->SetCanDoubleJump(false);
+        objetivo->RemoveAura(AuraVigor());
+        FijarVelocidadDeVuelo(objetivo, false);
+        FijarRecorteAero(objetivo, false);
+        TC_LOG_DEBUG("scripts.vuelo", "vuelo dinamico: {} monta en modo estable (zona {})",
+            jugador->GetName(), jugador->GetAreaId());
+        return;
+    }
+
+    // Cielonautica: el paquete de parametros de vuelo (los 13 SMSG_MOVE_SET_ADV_FLYING_*) sale de
+    // SetFlightCapabilityID, y el Vigor es lo que habilita las habilidades activas en el cliente.
+    objetivo->SetCanAdvFly(true);
+    objetivo->SetCanDoubleJump(true);
+    objetivo->SetFlightCapabilityID(int32(CapVueloDinamico()), true);
+    FijarVelocidadDeVuelo(objetivo, true);
+    FijarRecorteAero(objetivo, true);
+
+    if (!jugador->HasAura(AuraVigor()))
+        jugador->CastSpell(jugador, AuraVigor(), true);
+
+    TC_LOG_DEBUG("scripts.vuelo", "vuelo dinamico: {} monta en cielonautica (cap {}, zona {})",
+        jugador->GetName(), CapVueloDinamico(), jugador->GetAreaId());
+}
+
+void Mgr::FijarReglaDeZona(uint32 areaId, ReglaZona regla, std::string const& nota)
+{
+    if (!areaId)
+        return;
+
+    // Se aplica ya en memoria (el comando tiene que verse al instante) y se persiste en la tabla.
+    if (regla == ReglaZona::Todo)
+    {
+        _zonas.erase(areaId);
+        WorldDatabase.PExecute("DELETE FROM vuelo_zona WHERE area_id = {}", areaId);
+
+        TC_LOG_INFO("scripts.vuelo", "vuelo dinamico: zona {} vuelve al vuelo normal (sin regla)", areaId);
+        return;
+    }
+
+    Zona zona;
+    zona.AreaId = areaId;
+    zona.Regla = regla;
+    zona.Nota = nota;
+    _zonas[areaId] = zona;
+
+    char const* texto = regla == ReglaZona::Estable ? "estable" : "nada";
+
+    WorldDatabase.PExecute(
+        "INSERT INTO vuelo_zona (area_id, permite, nota) VALUES ({}, '{}', '{}') "
+        "ON DUPLICATE KEY UPDATE permite = VALUES(permite), nota = VALUES(nota)",
+        areaId, texto, nota);
+
+    TC_LOG_INFO("scripts.vuelo", "vuelo dinamico: zona {} queda en '{}' ({})", areaId, texto, nota);
+}
+
+void Mgr::FijarVelocidadImpulso(TipoImpulso tipo, float velocidad)
+{
+    char const* texto = tipo == TipoImpulso::Ascenso ? "ascenso" : tipo == TipoImpulso::Giro ? "giro" : "avance";
+
+    // Se cambia toda la familia de una vez (los hechizos de la barra son copias del mismo).
+    uint32 tocados = 0;
+    for (auto& [hechizo, impulso] : _impulsos)
+        if (impulso.Tipo == tipo)
+        {
+            impulso.Velocidad = velocidad;
+            ++tocados;
+        }
+
+    WorldDatabase.PExecute("UPDATE vuelo_impulso SET velocidad = {} WHERE tipo = '{}'", velocidad, texto);
+
+    TC_LOG_INFO("scripts.vuelo", "vuelo dinamico: impulsos de tipo {} -> velocidad {} ({} hechizos)",
+        texto, velocidad, tocados);
+}
+
+void Mgr::AplicarReglaDeZona(Player* jugador, uint32 areaNueva)
+{
+    if (!jugador || !Habilitado() || _zonas.empty())
+        return;
+
+    // Sin montura no hay estado que ajustar: la regla se aplica al montar.
+    if (!jugador->IsMounted())
+        return;
+
+    ReglaZona regla = ReglaDeZona(jugador);
+
+    if (regla == ReglaZona::Todo)
+    {
+        // Saliendo de una zona restringida: se le devuelve el vuelo que pide su estilo.
+        if (ModoDe(jugador) != Modo::Estable)
+        {
+            jugador->SetCanFly(true);
+            jugador->SetCanAdvFly(true);
+            jugador->SetCanDoubleJump(true);
+            jugador->SetFlightCapabilityID(int32(CapVueloDinamico()), true);
+            FijarRecorteAero(jugador, true);
+            if (!jugador->HasAura(AuraVigor()))
+                jugador->CastSpell(jugador, AuraVigor(), true);
+        }
+
+        return;
+    }
+
+    if (regla == ReglaZona::Estable)
+    {
+        jugador->SetCanFly(true);
+        jugador->SetCanAdvFly(false);
+        jugador->SetCanDoubleJump(false);
+        jugador->RemoveAura(AuraVigor());
+        FijarRecorteAero(jugador, false);
+    }
+    else // Nada
+    {
+        jugador->SetCanAdvFly(false);
+        jugador->SetCanDoubleJump(false);
+        jugador->RemoveAura(AuraVigor());
+        FijarRecorteAero(jugador, false);
+        jugador->SetCanFly(false);
+    }
+
+    TC_LOG_INFO("scripts.vuelo", "vuelo dinamico: {} entra a la zona {} (area {}) y la montura queda en {}",
+        jugador->GetName(), areaNueva, jugador->GetAreaId(),
+        regla == ReglaZona::Nada ? "modo tierra" : "vuelo estable");
+}
+
+void Mgr::AplicarAlDesmontar(Unit* objetivo)
+{
+    if (!objetivo || !Habilitado())
+        return;
+
+    objetivo->RemoveAura(AuraVigor());
+    objetivo->SetCanAdvFly(false);
+    objetivo->SetCanDoubleJump(false);
+    FijarVelocidadDeVuelo(objetivo, false);
+    FijarRecorteAero(objetivo, false);
+
+    // No le apagues el vuelo si otra aura se lo esta dando (levitacion, formas de vuelo, etc.)
+    if (!objetivo->HasAuraType(SPELL_AURA_FLY) && !objetivo->HasAuraType(SPELL_AURA_MOUNTED))
+        objetivo->SetCanFly(false);
+}
+
+void Mgr::PonerAlDia(Player* jugador)
+{
+    if (!jugador || !Habilitado())
+        return;
+
+    if (jugador->GetLevel() < NivelMinimo())
+        return;
+
+    // 1) aprender lo que falte (el nivel de cada habilidad lo dice la base)
+    for (Habilidad const& habilidad : _habilidades)
+    {
+        if (habilidad.NivelMinimo > jugador->GetLevel() || jugador->HasSpell(habilidad.Hechizo))
+            continue;
+
+        jugador->LearnSpell(habilidad.Hechizo, false);
+        TC_LOG_INFO("scripts.vuelo", "vuelo dinamico: {} aprende {} ({})",
+            jugador->GetName(), habilidad.Hechizo, habilidad.Nota);
+    }
+
+    // 2) el modo de vuelo. El core deja el modo ESTABLE en cada login (Player::_LoadAuras hace
+    //    AddAura(404468)), asi que si el servidor dice cielonautica hay que darlo vuelta.
+    Modo porDefecto = ModoPorDefecto();
+    bool tieneCielo = jugador->HasAura(AuraCielonautica());
+    bool tieneEstable = jugador->HasAura(AuraEstable());
+
+    if (tieneCielo && tieneEstable)
+    {
+        if (porDefecto == Modo::Estable)
+        {
+            jugador->RemoveAura(AuraCielonautica());
+            tieneCielo = false;
+        }
+        else
+        {
+            jugador->RemoveAura(AuraEstable());
+            tieneEstable = false;
+        }
+    }
+
+    if (porDefecto == Modo::Cielonautica && !tieneCielo)
+    {
+        if (tieneEstable)
+            jugador->RemoveAura(AuraEstable());
+
+        jugador->CastSpell(jugador, AuraCielonautica(), true);
+        tieneCielo = true;
+        tieneEstable = false;
+    }
+    else if (porDefecto == Modo::Estable && !tieneEstable)
+    {
+        if (tieneCielo)
+            jugador->RemoveAura(AuraCielonautica());
+
+        jugador->CastSpell(jugador, AuraEstable(), true);
+        tieneEstable = true;
+        tieneCielo = false;
+    }
+
+    // 3) el Vigor acompaña al modo: sin el, el cliente no deja castear las habilidades activas
+    //    (SpellAuraRestrictions: CasterAuraSpell = 372773).
+    if (tieneCielo && !jugador->HasAura(AuraVigor()))
+        jugador->CastSpell(jugador, AuraVigor(), true);
+    else if (tieneEstable && jugador->HasAura(AuraVigor()))
+        jugador->RemoveAura(AuraVigor());
+}
+
+std::string Mgr::EstadoJugador(Player* jugador) const
+{
+    if (!jugador)
+        return "sin personaje";
+
+    Modo modo = ModoDe(jugador);
+
+    std::string texto = Trinity::StringFormat("{} | nivel {} | mapa {} | area {} | montado: {} | cap {} | estilo {}",
+        jugador->GetName(), jugador->GetLevel(), jugador->GetMapId(), jugador->GetAreaId(),
+        jugador->IsMounted() ? "si" : "no", jugador->GetFlightCapabilityID(),
+        modo == Modo::Cielonautica ? "cielonautica" : modo == Modo::Estable ? "estable" : "ninguno");
+
+    texto += Trinity::StringFormat("\n  auras: vigor {} | cielonautica {} | estable {}",
+        jugador->HasAura(AuraVigor()) ? "si" : "no",
+        jugador->HasAura(AuraCielonautica()) ? "si" : "no",
+        jugador->HasAura(AuraEstable()) ? "si" : "no");
+
+    texto += Trinity::StringFormat("\n  flags: VOLANDO {} | PUEDE_VOLAR {} | PUEDE_DINAMICO {} | MODO_DINAMICO {} | DOBLE_SALTO {}",
+        jugador->HasUnitMovementFlag(MOVEMENTFLAG_FLYING) ? "si" : "no",
+        jugador->HasUnitMovementFlag(MOVEMENTFLAG_CAN_FLY) ? "si" : "no",
+        jugador->HasUnitMovementFlag(MOVEMENTFLAG_CAN_ADV_FLY) ? "si" : "no",
+        jugador->HasUnitMovementFlag(MOVEMENTFLAG_ADV_FLYING) ? "si" : "no",
+        jugador->HasUnitMovementFlag(MOVEMENTFLAG_CAN_DOUBLE_JUMP) ? "si" : "no");
+
+    // MODO_DINAMICO lo pone el CLIENTE (el servidor solo da permiso con PUEDE_DINAMICO). Y si esta
+    // en ese modo, el cliente manda en su movimiento la velocidad de avance y de subida.
+    if (jugador->m_movementInfo.advFlying)
+        texto += Trinity::StringFormat("\n  el cliente SI reporta vuelo dinamico (avance {:.2f} | subida {:.2f})",
+            jugador->m_movementInfo.advFlying->forwardVelocity, jugador->m_movementInfo.advFlying->upVelocity);
+    else
+        texto += "\n  el cliente NO reporta vuelo dinamico (AdvFlying ausente): esta volando en el modelo viejo";
+
+    return texto;
+}
+
+bool Mgr::AlternarModo(Player* jugador)
+{
+    if (!jugador || !Habilitado())
+        return false;
+
+    bool estabaEnCielonautica = ModoDe(jugador) == Modo::Cielonautica;
+
+    jugador->RemoveAura(AuraCielonautica());
+    jugador->RemoveAura(AuraEstable());
+
+    if (estabaEnCielonautica)
+    {
+        jugador->CastSpell(jugador, AuraEstable(), true);
+        jugador->RemoveAura(AuraVigor());
+
+        if (jugador->IsMounted())
+        {
+            jugador->SetCanAdvFly(false);
+            jugador->SetCanDoubleJump(false);
+            FijarVelocidadDeVuelo(jugador, false);
+            FijarRecorteAero(jugador, false);
+        }
+
+        TC_LOG_INFO("scripts.vuelo", "vuelo dinamico: {} pasa a vuelo ESTABLE", jugador->GetName());
+        return true;
+    }
+
+    jugador->CastSpell(jugador, AuraCielonautica(), true);
+
+    if (!jugador->HasAura(AuraVigor()))
+        jugador->CastSpell(jugador, AuraVigor(), true);
+
+    if (jugador->IsMounted())
+    {
+        jugador->SetCanFly(true);
+        jugador->SetCanAdvFly(true);
+        jugador->SetCanDoubleJump(true);
+        jugador->SetFlightCapabilityID(int32(CapVueloDinamico()), true);
+        FijarVelocidadDeVuelo(jugador, true);
+        FijarRecorteAero(jugador, true);
+    }
+
+    TC_LOG_INFO("scripts.vuelo", "vuelo dinamico: {} pasa a CIELONAUTICA", jugador->GetName());
+    return true;
+}
+
+// Un empujon hacia donde mira el draco, con su inclinacion (pitch). Lo usan avance, giro y el
+// tren del ascenso (en retail los tres apuntan igual: la direccion actual del vuelo).
+void Mgr::EmpujarHaciaDondeVuela(Player* jugador, float velocidad)
+{
+    if (!jugador || velocidad <= 0.0f)
+        return;
+
+    float orientacion = jugador->GetOrientation();
+    float inclinacion = jugador->m_movementInfo.pitch;
+
+    float x = velocidad * std::cos(orientacion) * std::cos(inclinacion);
+    float y = velocidad * std::sin(orientacion) * std::cos(inclinacion);
+    float z = velocidad * std::sin(inclinacion);
+
+    jugador->AddMoveImpulse(Position(x, y, z));
+
+    TC_LOG_DEBUG("scripts.vuelo", "vuelo dinamico: {} empujon (velocidad {} -> {:.1f},{:.1f},{:.1f})",
+        jugador->GetName(), velocidad, x, y, z);
+}
+
+// El recorte del techo aero del modo. Retail, con el vuelo dinamico encendido, no manda la fila del
+// DB2 tal cual: manda MaxVel e impulsoMax al 85% y los devuelve enteros al apagarlo.
+void Mgr::FijarRecorteAero(Unit* objetivo, bool dinamico)
+{
+    if (!objetivo || !Habilitado())
+        return;
+
+    objetivo->SetAdvFlyingSpeedModifier(dinamico ? FactorVelocidadMax() : 1.0f,
+        dinamico ? FactorImpulsoMax() : 1.0f, true);
+
+    // INFO porque es la evidencia de la prueba en vivo: los dos valores que el cliente acaba de
+    // recibir (retail con el modo encendido: 55.25 de 65 y 85 de 100).
+    TC_LOG_INFO("scripts.vuelo", "vuelo dinamico: {} recorte aero {} -> velocidad max {} | impulso max {}",
+        objetivo->GetName(), dinamico ? "PUESTO" : "SACADO",
+        objetivo->GetAdvFlyingSpeed(ADV_FLYING_MAX_VEL),
+        objetivo->GetAdvFlyingSpeed(ADV_FLYING_ADD_IMPULSE_MAX_SPEED));
+}
+
+void Mgr::EnviarImpulso(Player* jugador, uint32 hechizo)
+{
+    Impulso const* impulso = GetImpulso(hechizo);
+    if (!jugador || !impulso)
+        return;
+
+    float velocidad = impulso->Velocidad;
+    if (velocidad <= 0.0f)
+        return;
+
+    if (impulso->Tipo == TipoImpulso::Ascenso)
+    {
+        // FASE 1: el empujon vertical (retail: 45 hacia arriba, en el mismo paquete que el aura
+        // 392752 "Potenciacion de lanzamiento").
+        jugador->AddMoveImpulse(Position(0.0f, 0.0f, velocidad));
+
+        // FASE 2: el tren de empujes suaves hacia donde vuela el draco.
+        uint32 empujes = TrenAscensoEmpujes();
+        if (empujes > 0)
+            jugador->m_Events.AddEvent(new EventoTrenAscenso(jugador->GetGUID(), empujes),
+                Milliseconds(TrenAscensoRetrasoMs()));
+
+        // Una sola linea (INFO, no DEBUG): es la evidencia de la prueba en vivo, y el canal
+        // `scripts.vuelo` ya se usa para esto (montar, cambio de modo). Cada empujon va en DEBUG.
+        TC_LOG_INFO("scripts.vuelo", "vuelo dinamico: {} ascenso {} -> fase 1 {} vertical + fase 2 {} empujes de {} cada {} ms (+{} ms)",
+            jugador->GetName(), hechizo, velocidad, empujes, TrenAscensoVelocidad(),
+            TrenAscensoIntervaloMs(), TrenAscensoRetrasoMs());
+
+        return;
+    }
+
+    // Avance y giro empujan hacia donde mira el draco, con su inclinacion (pitch).
+    EmpujarHaciaDondeVuela(jugador, velocidad);
+    TC_LOG_DEBUG("scripts.vuelo", "vuelo dinamico: {} {} {} (velocidad {})",
+        jugador->GetName(), impulso->Tipo == TipoImpulso::Giro ? "giro" : "avance", hechizo, velocidad);
+}
+
+std::string Mgr::EstadoTexto() const
+{
+    std::string texto = Trinity::StringFormat(
+        "vuelo dinamico: {} | nivel minimo {} | modo por defecto {} | cap {} | vigor {} | cielonautica {} | estable {}",
+        Habilitado() ? "ENCENDIDO" : "APAGADO", NivelMinimo(),
+        ModoPorDefecto() == Modo::Estable ? "estable" : "cielonautica", CapVueloDinamico(),
+        AuraVigor(), AuraCielonautica(), AuraEstable());
+
+    texto += Trinity::StringFormat("\n  habilidades que aprende solo: {} | requisitos de equitacion: {} | impulsos: {} | zonas con regla: {}",
+        _habilidades.size(), _requisitos.size(), _impulsos.size(), _zonas.size());
+
+    for (Habilidad const& habilidad : _habilidades)
+        texto += Trinity::StringFormat("\n   - {} desde nivel {} ({})", habilidad.Hechizo, habilidad.NivelMinimo, habilidad.Nota);
+
+    for (auto const& [hechizo, impulso] : _impulsos)
+        texto += Trinity::StringFormat("\n   - impulso {} ({}) velocidad {}", hechizo,
+            impulso.Tipo == TipoImpulso::Ascenso ? "ascenso" : impulso.Tipo == TipoImpulso::Giro ? "giro" : "avance",
+            impulso.Velocidad);
+
+    texto += Trinity::StringFormat("\n  tren del ascenso (fase 2): {} empujes de {} cada {} ms, +{} ms | recorte aero del modo: x{} velocidad max, x{} impulso max",
+        TrenAscensoEmpujes(), TrenAscensoVelocidad(), TrenAscensoIntervaloMs(), TrenAscensoRetrasoMs(),
+        FactorVelocidadMax(), FactorImpulsoMax());
+
+    for (auto const& [areaId, zona] : _zonas)
+        texto += Trinity::StringFormat("\n   - zona {}: {}", areaId,
+            zona.Regla == ReglaZona::Nada ? "no se vuela" : zona.Regla == ReglaZona::Estable ? "solo vuelo estable" : "vuelo normal");
+
+    return texto;
+}
+} // namespace VueloDinamico
+} // namespace Trinity
