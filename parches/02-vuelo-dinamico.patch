+std::string Mgr::Config(std::string const& clave, std::string const& porDefecto) const
+{
+    auto it = _config.find(clave);
+    return it == _config.end() ? porDefecto : it->second;
+}
+
+uint32 Mgr::ConfigNumero(std::string const& clave, uint32 porDefecto) const
+{
+    auto it = _config.find(clave);
+    if (it == _config.end() || it->second.empty())
+        return porDefecto;
+
+    try
+    {
+        return uint32(std::stoul(it->second));
+    }
+    catch (std::exception const&)
+    {
+        TC_LOG_ERROR("server.loading", "vuelo dinamico: vuelo_config['{}'] = '{}' no es un numero", clave, it->second);
+        return porDefecto;
+    }
+}
+
+float Mgr::ConfigFlotante(std::string const& clave, float porDefecto) const
+{
+    auto it = _config.find(clave);
+    if (it == _config.end() || it->second.empty())
+        return porDefecto;
+
+    try
+    {
+        return std::stof(it->second);
+    }
+    catch (std::exception const&)
+    {
+        TC_LOG_ERROR("server.loading", "vuelo dinamico: vuelo_config['{}'] = '{}' no es un numero", clave, it->second);
+        return porDefecto;
+    }
+}
