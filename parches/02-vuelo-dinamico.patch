+// ----------------------------------------------------------------------------
+// configuracion: todo sale de world.vuelo_* (nada quemado en el codigo)
+// ----------------------------------------------------------------------------
+void Mgr::CargarConfig()
+{
+    _config.clear();
+    _habilidades.clear();
+    _requisitos.clear();
+    _impulsos.clear();
+    _zonas.clear();
+
+    if (QueryResult config = WorldDatabase.Query("SELECT clave, valor FROM vuelo_config"))
+        do
+        {
+            Field* campos = config->Fetch();
+            _config[campos[0].GetString()] = campos[1].GetString();
+        } while (config->NextRow());
+
+    if (QueryResult habilidades = WorldDatabase.Query(
+            "SELECT hechizo, nivel_minimo, nota FROM vuelo_habilidad ORDER BY nivel_minimo, hechizo"))
+        do
+        {
+            Field* campos = habilidades->Fetch();
+            Habilidad h;
+            h.Hechizo = campos[0].GetUInt32();
+            h.NivelMinimo = campos[1].GetUInt32();
+            h.Nota = campos[2].GetString();
+            _habilidades.push_back(h);
+        } while (habilidades->NextRow());
+
+    if (QueryResult requisitos = WorldDatabase.Query("SELECT hechizo FROM vuelo_requisito"))
+        do
+            _requisitos.push_back(requisitos->Fetch()[0].GetUInt32());
+        while (requisitos->NextRow());
+
+    if (QueryResult impulsos = WorldDatabase.Query("SELECT hechizo, tipo, velocidad, nota FROM vuelo_impulso"))
+        do
+        {
+            Field* campos = impulsos->Fetch();
+            std::string tipo = campos[1].GetString();
+            Impulso i;
+            i.Hechizo = campos[0].GetUInt32();
+            i.Tipo = tipo == "ascenso" ? TipoImpulso::Ascenso
+                   : tipo == "giro" ? TipoImpulso::Giro
+                   : TipoImpulso::Avance;
+            i.Velocidad = campos[2].GetFloat();
+            i.Nota = campos[3].GetString();
+            _impulsos[i.Hechizo] = i;
+        } while (impulsos->NextRow());
+
+    if (_config.empty())
+        TC_LOG_ERROR("server.loading", "vuelo dinamico: world.vuelo_config esta vacia (se usan los valores por defecto del codigo); corre la migracion 2026_09_16_29_world.sql");
+
+    // Las zonas con regla propia (vacia = en todas se vuela como dice el estilo de vuelo)
+    if (QueryResult zonas = WorldDatabase.Query("SELECT area_id, permite, nota FROM vuelo_zona"))
+        do
+        {
+            Field* campos = zonas->Fetch();
+            std::string permite = campos[1].GetString();
+            Zona zona;
+            zona.AreaId = campos[0].GetUInt32();
+            zona.Regla = permite == "nada" ? ReglaZona::Nada
+                       : permite == "estable" ? ReglaZona::Estable
+                       : ReglaZona::Todo;
+            zona.Nota = campos[2].GetString();
+            _zonas[zona.AreaId] = zona;
+        } while (zonas->NextRow());
+
+    TC_LOG_INFO("server.loading", "vuelo dinamico: {} claves, {} habilidades, {} requisitos de equitacion, {} impulsos, {} zonas con regla",
+        _config.size(), _habilidades.size(), _requisitos.size(), _impulsos.size(), _zonas.size());
+}
