+// La FASE 2 del ascenso: el tren de empujes suaves que retail manda DESPUES del empujon vertical.
+// Medido en la sesion de vuelo del 21-sep-2026 (437 SMSG_MOVE_ADD_IMPULSE): 5-6 empujes de 5.0 cada
+// 102 ms hacia donde vuela el draco, arrancando 0.71 s despues del 45. Sin esta fase el draco sube y
+// a los ~0.7 s se queda sin empuje: eso era el "casi no tiene fuerza, al medio segundo cae".
+// Va como evento del propio jugador, asi muere con el si se desconecta.
+class EventoTrenAscenso : public BasicEvent
+{
+public:
+    EventoTrenAscenso(ObjectGuid guid, uint32 restantes)
+        : BasicEvent(), _guid(guid), _restantes(restantes) { }
+
+    bool Execute(uint64 /*e_time*/, uint32 /*p_time*/) override
+    {
+        Player* jugador = ObjectAccessor::FindPlayer(_guid);
+        if (!jugador || !jugador->IsInWorld())
+            return true;
+
+        // Si dejo de estar en modo dinamico (desmonto, cambio de zona, se apago el modo) el tren
+        // se corta solo: no queda empujando a alguien que ya esta en vuelo estable.
+        if (!sVueloDinamico->Habilitado() || !jugador->HasUnitMovementFlag(MOVEMENTFLAG_CAN_ADV_FLY))
+            return true;
+
+        sVueloDinamico->EmpujarHaciaDondeVuela(jugador, sVueloDinamico->TrenAscensoVelocidad());
+
+        if (_restantes > 1)
+            jugador->m_Events.AddEvent(new EventoTrenAscenso(_guid, _restantes - 1),
+                Milliseconds(sVueloDinamico->TrenAscensoIntervaloMs()));
+
+        return true;
+    }
+
+private:
+    ObjectGuid _guid;
+    uint32 _restantes;
+};
+} // namespace
