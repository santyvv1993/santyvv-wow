+
+/*
+ * ============================================================================
+ *  VueloDinamicoMgr - el vuelo dinamico (skyriding) propio
+ * ============================================================================
+ *
+ *  POR QUE EXISTE ESTE ARCHIVO
+ *  El core ya trae media pieza: los 13 SMSG_MOVE_SET_ADV_FLYING_*, el campo de
+ *  update FlightCapabilityID (Unit.cpp, SetFlightCapabilityID) y los flags
+ *  SetCanAdvFly / SetCanDoubleJump. Lo que NO trae es quien los encienda, y hay
+ *  una pieza que solo se ve mirando los datos del CLIENTE:
+ *
+ *    En SpellAuraRestrictions.db2 hay 23 filas con CasterAuraSpell = 372773
+ *    (Vigor) que gatean 372608 "Impulso de avance", 372610 "Ascenso al cielo",
+ *    361584 "Aceleracion giratoria" y el widget de la barra de vigor (423624).
+ *    Sin esa aura el cliente rechaza el casteo ("todavia no aprendido") ANTES de
+ *    mandar un paquete, asi que del lado del servidor no se ve ningun error.
+ *
+ *  Segunda pieza: el core fuerza el modo vuelo estable en cada login
+ *  (Player::_LoadAuras hace AddAura(404468)) y las capacidades de montura de
+ *  vuelo estatico exigen justamente esa aura (MountCapability 455/456/457 con
+ *  ReqSpellAuraID = 404468). Por eso un servidor sin tocar vuela "estable" y
+ *  nunca dragonriding: la capacidad dinamica (494, FlightCapabilityID 11) exige
+ *  saber 376777 "Cielonautica basica" y ademas no estar en modo estable.
+ *  Este archivo NO toca Player.cpp: ordena el modo al entrar al mundo.
+ *
+ *  TERCERA pieza, la que hace que se sienta: las habilidades activas empujan al
+ *  jugador (SMSG_MOVE_ADD_IMPULSE), que hasta ahora estaba como STATUS_UNHANDLED.
+ *
+ *  Regla de diseno (la misma del sistema de miticas): TODO lo configurable sale
+ *  de la base. Las tablas `vuelo_*` mandan; este codigo solo las interpreta.
+ *  Cambiar un hechizo, un nivel, una velocidad o un umbral es un INSERT.
+ * ============================================================================
+ */
+
+#ifndef VueloDinamicoMgr_h__
+#define VueloDinamicoMgr_h__
+
+#include "Define.h"
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+class Player;
+class Unit;
+
+namespace Trinity
+{
+namespace VueloDinamico
+{
+// Los dos estilos de vuelo del cliente (auras 404464 y 404468).
+enum class Modo : uint8
+{
+    Ninguno = 0,
+    Cielonautica,   // skyriding: inercia, vigor, habilidades activas
+    Estable         // vuelo estatico de siempre: hover y velocidad constante
+};
+
+// Como empuja cada habilidad activa.
+enum class TipoImpulso : uint8
+{
+    Ascenso = 0,    // hacia arriba (Ascenso al cielo)
+    Avance,         // hacia donde mira el draco (Impulso de avance)
+    Giro            // igual que avance, pero mas fuerte (Aceleracion giratoria)
+};
+
+// Que deja hacer el vuelo en una zona (world.vuelo_zona). Sin fila = Todo.
+enum class ReglaZona : uint8
+{
+    Todo = 0,       // vuelo normal (dinamico o estable, el que tenga puesto)
+    Estable,        // solo vuelo estatico en esa zona (se apaga el dinamico)
+    Nada            // no vuela: la montura queda de tierra
+};
+
+// Una habilidad que el sistema aprende solo (world.vuelo_habilidad)
+struct Habilidad
+{
+    uint32 Hechizo = 0;
+    uint32 NivelMinimo = 1;
+    std::string Nota;
+};
+
+// Una zona con regla propia (world.vuelo_zona)
+struct Zona
+{
+    uint32 AreaId = 0;
+    ReglaZona Regla = ReglaZona::Todo;
+    std::string Nota;
+};
+
+// Un empujon de vuelo (world.vuelo_impulso)
+struct Impulso
+{
+    uint32 Hechizo = 0;
+    TipoImpulso Tipo = TipoImpulso::Avance;
+    float Velocidad = 0.0f;
+    std::string Nota;
+};
+
+class Mgr
+{
+public:
+    static Mgr* instance();
+
+    // --- configuracion (world.vuelo_*) ---
+    void CargarConfig();
+    std::string Config(std::string const& clave, std::string const& porDefecto = "") const;
+    uint32 ConfigNumero(std::string const& clave, uint32 porDefecto) const;
+    float ConfigFlotante(std::string const& clave, float porDefecto) const;
+
+    // Velocidad de vuelo dinamico. Retail manda SMSG_MOVE_SET_FLIGHT_SPEED 29.4 (= 420% de la
+    // base de vuelo 7.0) en el mismo instante en que activa el modo (SMSG_MOVE_SET_CAN_ADV_FLY,
+    // sniff 12.1.0.69875 del 21-sep-2026) y 7.7 al salir. TC trae la base de vuelo en 7.0, asi
+    // que la tasa que produce 29.4 es 4.2. Al salir se RESTAURA la tasa que tenia antes, sin
+    // inventar un valor propio (cada montura/aura de vuelo trae la suya).
+    float VelocidadDinamica() const { return ConfigFlotante("velocidad_dinamica", 4.2f); }
+    void FijarVelocidadDeVuelo(Unit* objetivo, bool dinamico);
+
+    // El tren de empujes del ascenso (la fase 2 de retail, sniff 21-sep-2026): despues del empujon
+    // vertical de 45, un tren de empujes suaves hacia donde vuela el draco. Medido: 5-6 empujes de
+    // 5.0 cada 102 ms, arrancando 0.71 s despues del 45. 0 empujes = sin tren.
+    uint32 TrenAscensoEmpujes() const { return ConfigNumero("tren_ascenso_empujes", 6); }
+    uint32 TrenAscensoRetrasoMs() const { return ConfigNumero("tren_ascenso_retraso_ms", 700); }
+    uint32 TrenAscensoIntervaloMs() const { return ConfigNumero("tren_ascenso_intervalo_ms", 100); }
+    float TrenAscensoVelocidad() const { return ConfigFlotante("tren_ascenso_velocidad", 5.0f); }
+    // El recorte del techo aero con el modo dinamico encendido (retail: 0.85 = 55.25 y 85).
+    float FactorVelocidadMax() const { return ConfigFlotante("factor_velocidad_max", 0.85f); }
+    float FactorImpulsoMax() const { return ConfigFlotante("factor_impulso_max", 0.85f); }
+
+    bool Habilitado() const { return ConfigNumero("habilitado", 1) != 0; }
+    uint32 NivelMinimo() const { return ConfigNumero("nivel_minimo", 10); }
+    uint32 AuraVigor() const { return ConfigNumero("aura_vigor", 372773); }
+    uint32 AuraCielonautica() const { return ConfigNumero("aura_cielonautica", 404464); }
+    uint32 AuraEstable() const { return ConfigNumero("aura_estable", 404468); }
+    uint32 CapVueloDinamico() const { return ConfigNumero("cap_vuelo_dinamico", 1); }
+    Modo ModoPorDefecto() const;
+
+    std::vector<Habilidad> const& GetHabilidades() const { return _habilidades; }
+    Impulso const* GetImpulso(uint32 hechizo) const;
+    bool HayRequisitoEquitacion() const { return !_requisitos.empty(); }
+    std::unordered_map<uint32, Zona> const& GetZonas() const { return _zonas; }
+    // La regla de la zona donde esta el jugador (mira tambien las zonas padre).
+    ReglaZona ReglaDeZona(Player* jugador) const;
+    // La capacidad de montura que trae el hechizo dice si esa montura vuela.
+    bool CapacidadEsVoladora(uint32 capacidadMontura) const;
+
+    // --- lo que hace el sistema ---
+    // Engancha el estado de vuelo al montar/desmontar (lo llama HandleAuraMounted).
+    void AplicarAlMontar(Unit* objetivo, uint32 capacidadMontura);
+    void AplicarAlDesmontar(Unit* objetivo);
+    // Al entrar al mundo o subir de nivel: aprende lo que falte y deja modo y Vigor coherentes.
+    void PonerAlDia(Player* jugador);
+    // Al cambiar de zona: si la zona tiene regla propia, deja la montura como corresponde.
+    void AplicarReglaDeZona(Player* jugador, uint32 areaNueva);
+    // Guarda una regla de zona: la aplica en memoria ya y la persiste en world.vuelo_zona.
+    void FijarReglaDeZona(uint32 areaId, ReglaZona regla, std::string const& nota);
+    // Cambia la velocidad de toda una familia de impulsos (ascenso / avance / giro) en vivo y la
+    // persiste en world.vuelo_impulso. Para calibrar a mano, sin recompilar.
+    void FijarVelocidadImpulso(TipoImpulso tipo, float velocidad);
+    // El estilo de vuelo que tiene puesto ahora mismo.
+    Modo ModoDe(Player* jugador) const;
+    // Radiografia de un jugador para diagnosticar en vivo (lo que imprime `.vuelo pj`): montura,
+    // auras, flags de movimiento y lo que el cliente reporta de vuelo dinamico (AdvFlying).
+    std::string EstadoJugador(Player* jugador) const;
+    // Alterna el estilo (lo que dispara el hechizo "Cambiar estilo de vuelo").
+    bool AlternarModo(Player* jugador);
+    // Empuja al jugador segun la habilidad activa que haya casteado.
+    void EnviarImpulso(Player* jugador, uint32 hechizo);
+    // Un empujon hacia donde vuela el draco (lo usan avance, giro y el tren del ascenso).
+    void EmpujarHaciaDondeVuela(Player* jugador, float velocidad);
+    // Recorte del techo aero del modo: lo pone al montar en cielonautica y lo saca al salir.
+    void FijarRecorteAero(Unit* objetivo, bool dinamico);
+    // Texto de `.vuelo estado` (lo que mando a la pantalla del GM).
+    std::string EstadoTexto() const;
+
+private:
+    // El jugador cumple el requisito de equitacion (world.vuelo_requisito).
+    bool CumpleRequisito(Player* jugador) const;
+
+    std::unordered_map<std::string, std::string> _config;
+    std::vector<Habilidad> _habilidades;
+    std::vector<uint32> _requisitos;
+    std::unordered_map<uint32, Impulso> _impulsos;
+    std::unordered_map<ObjectGuid, float> _velocidadDeVuelo;  // tasa de vuelo previa, para restaurarla al salir del modo dinamico
+    std::unordered_map<uint32, Zona> _zonas;
+};
+} // namespace VueloDinamico
+} // namespace Trinity
+
+#define sVueloDinamico Trinity::VueloDinamico::Mgr::instance()
+
+#endif // VueloDinamicoMgr_h__
diff --git a/src/server/scripts/Custom/vuelo_dinamico_custom.cpp b/src/server/scripts/Custom/vuelo_dinamico_custom.cpp
new file mode 100644
index 0000000000..9770523111
--- /dev/null
+++ b/src/server/scripts/Custom/vuelo_dinamico_custom.cpp
@@ -0,0 +1,438 @@
+/*
+ * ============================================================================
+ *  vuelo_dinamico_custom.cpp - VUELO DINAMICO (skyriding): los enganches del juego
+ * ============================================================================
+ *
+ *  POR QUE EXISTE ESTE ARCHIVO
+ *  El motor (que decide y guarda) es VueloDinamicoMgr; esto es lo que el cliente
+ *  y el jugador tocan:
+ *
+ *   - AL ENTRAR AL MUNDO y al subir de nivel: aprende las habilidades que declare
+ *     world.vuelo_habilidad y deja el estilo de vuelo y el Vigor coherentes. Esto
+ *     es lo que deshace el modo ESTABLE que el core fuerza en cada login.
+ *   - EL HECHIZO DE ALTERNAR ESTILO ("Cambiar estilo de vuelo"): cambia entre
+ *     cielonautica (inercia) y estable. Se registra para TODAS las copias del
+ *     hechizo que trae este build del cliente, porque la barra la maneja el cliente:
+ *       404471 | 436854 | 459987 | 459988 | 460002   (world.vuelo_toggle)
+ *   - LAS HABILIDADES ACTIVAS (Ascenso al cielo, Impulso de avance, Aceleracion
+ *     giratoria): empujan al jugador con SMSG_MOVE_ADD_IMPULSE. La velocidad y el
+ *     tipo de cada una salen de world.vuelo_impulso (nada quemado).
+ *   - LOS COMANDOS de operacion: `.vuelo estado | recargar | ensenar <pj> | modo <pj> [estilo]`.
+ *
+ *  OJO, la mina que costo encontrar: el cliente NO manda el casteo de las
+ *  habilidades activas si no tiene el aura Vigor (372773). En SpellAuraRestrictions
+ *  hay 23 filas con CasterAuraSpell = 372773 que gatean esos hechizos, asi que sin
+ *  el aura el jugador solo ve "todavia no aprendido" y en el log del servidor no
+ *  aparece nada. El modo cielonautica mantiene el Vigor puesto.
+ * ============================================================================
+ */
+
