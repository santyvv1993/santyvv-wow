+// PARCHES-PROPIOS: el cliente necesita SMSG_MOVE_SET_FLIGHT_SPEED con la velocidad del modo.
+// Medido en retail: 29.4 (420%) con el vuelo dinamico encendido, 7.7 al apagarlo, siempre en el
+// mismo instante que el cambio de modo. Sin esto el cliente queda con la velocidad del modo
+// anterior (7.0/7.7) mientras el aero usa un tope de 55.25: la escala de velocidad queda corta y
+// el "sobrepasar velocidad" (la estela de viento al picar) no llega a dispararse nunca.
+void Mgr::FijarVelocidadDeVuelo(Unit* objetivo, bool dinamico)
+{
+    if (!objetivo || !Habilitado())
+        return;
+
+    ObjectGuid guid = objetivo->GetGUID();
+
+    if (dinamico)
+    {
+        auto it = _velocidadDeVuelo.find(guid);
+        if (it == _velocidadDeVuelo.end())
+            _velocidadDeVuelo[guid] = objetivo->GetSpeedRate(MOVE_FLIGHT);
+
+        objetivo->SetSpeed(MOVE_FLIGHT, VelocidadDinamica());
+        TC_LOG_DEBUG("scripts.vuelo", "vuelo dinamico: {} velocidad de vuelo a {} (retail: 29.4)",
+            objetivo->GetName(), objetivo->GetSpeed(MOVE_FLIGHT));
+        return;
+    }
+
+    auto it = _velocidadDeVuelo.find(guid);
+    if (it == _velocidadDeVuelo.end())
+        return;
+
+    objetivo->SetSpeed(MOVE_FLIGHT, it->second);
+    TC_LOG_DEBUG("scripts.vuelo", "vuelo dinamico: {} velocidad de vuelo restaurada a {}",
+        objetivo->GetName(), objetivo->GetSpeed(MOVE_FLIGHT));
+    _velocidadDeVuelo.erase(it);
+}
