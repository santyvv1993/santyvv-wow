+// ----------------------------------------------------------------------------
+// los enganches de juego
+// ----------------------------------------------------------------------------
+class script_vuelo_jugador : public PlayerScript
+{
+public:
+    script_vuelo_jugador() : PlayerScript("script_vuelo_jugador") { }
+
+    void OnLogin(Player* jugador, bool /*primerIngreso*/) override
+    {
+        sVueloDinamico->PonerAlDia(jugador);
+    }
+
+    void OnLevelChanged(Player* jugador, uint8 /*nivelViejo*/) override
+    {
+        sVueloDinamico->PonerAlDia(jugador);
+    }
+
+    // Al cambiar de zona: si la zona tiene regla propia (world.vuelo_zona) y el jugador va montado,
+    // se le ajusta el vuelo ahi mismo (una zona que no vuela baja al draco al piso).
+    void OnUpdateZone(Player* jugador, uint32 /*zonaNueva*/, uint32 areaNueva) override
+    {
+        sVueloDinamico->AplicarReglaDeZona(jugador, areaNueva);
+    }
+};
+
+class script_vuelo_mundo : public WorldScript
+{
+public:
+    script_vuelo_mundo() : WorldScript("script_vuelo_mundo") { }
+
+    void OnStartup() override
+    {
+        sVueloDinamico->CargarConfig();
+    }
+};
+
+// "Cambiar estilo de vuelo": el cliente lo castea desde su propia barra.
+class spell_alternar_estilo_vuelo : public SpellScript
+{
+    PrepareSpellScript(spell_alternar_estilo_vuelo);
+
+    void HandleDespues()
+    {
+        if (Player* jugador = GetCaster()->ToPlayer())
+            sVueloDinamico->AlternarModo(jugador);
+    }
+
+    void Register() override
+    {
+        // Sin dependencia del efecto: la barra del cliente manda copias distintas de este hechizo.
+        AfterCast += SpellCastFn(spell_alternar_estilo_vuelo::HandleDespues);
+    }
+};
+
+// Ascenso al cielo / Impulso de avance / Aceleracion giratoria.
+class spell_impulso_vuelo : public SpellScript
+{
+    PrepareSpellScript(spell_impulso_vuelo);
+
+    void HandleDespues()
+    {
+        if (Player* jugador = GetCaster()->ToPlayer())
+            sVueloDinamico->EnviarImpulso(jugador, GetSpellInfo()->Id);
+    }
+
+    void Register() override
+    {
+        AfterCast += SpellCastFn(spell_impulso_vuelo::HandleDespues);
+    }
+};
+
+// ----------------------------------------------------------------------------
+// los comandos: un comando por tarea, y andan tambien por consola (por SOAP)
+// ----------------------------------------------------------------------------
+class comando_vuelo : public CommandScript
+{
+public:
+    comando_vuelo() : CommandScript("comando_vuelo") { }
+
+    std::span<ChatCommandBuilder const> GetCommands() const override
+    {
+        static ChatCommandTable vueloCommandTable =
+        {
+            // De lectura y de recarga: andan por consola, asi el agente mide sin el cliente abierto.
+            { "estado",   HandleEstadoCommand,   rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            { "recargar", HandleRecargarCommand, rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            // Sobre un personaje: tambien por nombre, por consola.
+            { "ensenar",  HandleEnsenarCommand,  rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            { "modo",     HandleModoCommand,     rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            // Reglas de vuelo por zona (world.vuelo_zona): donde se vuela y donde no.
+            { "zona",     HandleZonaCommand,     rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            // Calibrar la fuerza de un impulso por familia (ascenso / avance / giro).
+            { "impulso",  HandleImpulsoCommand,  rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            // Radiografia de un personaje (para diagnosticar sin adivinar).
+            { "pj",       HandlePjCommand,       rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+        };
+        static ChatCommandTable commandTable =
+        {
+            { "vuelo", vueloCommandTable },
+        };
+        return commandTable;
+    }
+
+    static bool HandleEstadoCommand(ChatHandler* handler)
+    {
+        std::string texto = sVueloDinamico->EstadoTexto();
+        handler->SendSysMessage(texto.c_str());
+        return true;
+    }
+
+    static bool HandleRecargarCommand(ChatHandler* handler)
+    {
+        sVueloDinamico->CargarConfig();
+        handler->SendSysMessage("Vuelo dinamico: configuracion recargada desde world.vuelo_*.");
+        return true;
+    }
+
+    // .vuelo ensenar <personaje>
+    static bool HandleEnsenarCommand(ChatHandler* handler, char const* args)
+    {
+        std::string nombre = args ? args : "";
+        // el nombre puede venir con espacios de mas
+        while (!nombre.empty() && (nombre.back() == ' ' || nombre.back() == '\t'))
+            nombre.pop_back();
+
+        if (nombre.empty())
+        {
+            handler->SendSysMessage("Uso: .vuelo ensenar <personaje>");
+            return false;
+        }
+
+        Player* jugador = BuscarJugador(handler, nombre);
+        if (!jugador)
+            return false;
+
+        sVueloDinamico->PonerAlDia(jugador);
+
+        // PonerAlDia aprende por nivel; aca se fuerza TODO lo que declara la base.
+        uint32 aprendidas = 0;
+        for (Trinity::VueloDinamico::Habilidad const& habilidad : sVueloDinamico->GetHabilidades())
+        {
+            if (jugador->HasSpell(habilidad.Hechizo))
+                continue;
+
+            jugador->LearnSpell(habilidad.Hechizo, false);
+            ++aprendidas;
+        }
+
+        handler->PSendSysMessage("%s: %u hechizos de vuelo aprendidos (estilo %s).",
+            jugador->GetName(), aprendidas,
+            sVueloDinamico->ModoDe(jugador) == Trinity::VueloDinamico::Modo::Cielonautica ? "cielonautica"
+                : sVueloDinamico->ModoDe(jugador) == Trinity::VueloDinamico::Modo::Estable ? "estable" : "ninguno");
+        return true;
+    }
+
+    // .vuelo modo <personaje> [cielonautica|estable]   (sin estilo, alterna)
+    static bool HandleModoCommand(ChatHandler* handler, char const* args)
+    {
+        std::string crudo = args ? args : "";
+        std::vector<char> copia(crudo.begin(), crudo.end());
+        copia.push_back('\0');
+
+        char* nombreArg = strtok(copia.data(), " \t");
+        char* estiloArg = nombreArg ? strtok(nullptr, " \t") : nullptr;
+
+        if (!nombreArg)
+        {
+            handler->SendSysMessage("Uso: .vuelo modo <personaje> [cielonautica|estable] (sin estilo, alterna)");
+            return false;
+        }
+
+        Player* jugador = BuscarJugador(handler, nombreArg);
+        if (!jugador)
+            return false;
+
+        std::string estilo = estiloArg ? estiloArg : "";
+
+        if (estilo == "cielonautica" || estilo == "estable")
+        {
+            Trinity::VueloDinamico::Modo deseado = estilo == "estable"
+                ? Trinity::VueloDinamico::Modo::Estable
+                : Trinity::VueloDinamico::Modo::Cielonautica;
+
+            if (sVueloDinamico->ModoDe(jugador) != deseado)
+                sVueloDinamico->AlternarModo(jugador);
+        }
+        else
+        {
+            sVueloDinamico->AlternarModo(jugador);
+        }
+
+        Trinity::VueloDinamico::Modo quedo = sVueloDinamico->ModoDe(jugador);
+        handler->PSendSysMessage("%s quedo en estilo %s.", jugador->GetName(),
+            quedo == Trinity::VueloDinamico::Modo::Cielonautica ? "cielonautica"
+                : quedo == Trinity::VueloDinamico::Modo::Estable ? "estable" : "ninguno (sin aura de estilo)");
+        return true;
+    }
+
+    // .vuelo zona [<personaje>] [todo|estable|nada|ver]
+    //   sin argumentos -> lista las zonas con regla cargada
+    //   con personaje  -> dice en que zona esta y que regla tiene (o `ver`)
+    //   con regla      -> fija la regla de ESA zona (se aplica en el momento y se guarda en
+    //                     world.vuelo_zona: la base sigue siendo la fuente de verdad).
+    static bool HandleZonaCommand(ChatHandler* handler, char const* args)
+    {
+        std::string crudo = args ? args : "";
+        std::vector<char> copia(crudo.begin(), crudo.end());
+        copia.push_back('\0');
+
+        char* nombreArg = strtok(copia.data(), " \t");
+        char* reglaArg = nombreArg ? strtok(nullptr, " \t") : nullptr;
+
+        if (!nombreArg)
+        {
+            auto const& zonas = sVueloDinamico->GetZonas();
+            if (zonas.empty())
+            {
+                handler->SendSysMessage("No hay zonas con regla: en todas se vuela segun el estilo de vuelo.");
+                handler->SendSysMessage("Uso: .vuelo zona <personaje> todo|estable|nada|ver");
+                return true;
+            }
+
+            handler->PSendSysMessage("%u zonas con regla propia:", uint32(zonas.size()));
+            for (auto const& [areaId, zona] : zonas)
+                handler->PSendSysMessage("  zona %u: %s (%s)", areaId, TextoRegla(zona.Regla), zona.Nota.c_str());
+            return true;
+        }
+
+        Player* jugador = BuscarJugador(handler, nombreArg);
+        if (!jugador)
+            return false;
+
+        uint32 area = jugador->GetAreaId();
+
+        if (!reglaArg || std::string(reglaArg) == "ver")
+        {
+            handler->PSendSysMessage("%s esta en la zona %u (mapa %u): la regla es '%s'.",
+                jugador->GetName(), area, jugador->GetMapId(), TextoRegla(sVueloDinamico->ReglaDeZona(jugador)));
+            return true;
+        }
+
+        std::string regla = reglaArg;
+        if (regla != "todo" && regla != "estable" && regla != "nada")
+        {
+            handler->SendSysMessage("Uso: .vuelo zona <personaje> todo|estable|nada|ver");
+            return false;
+        }
+
+        Trinity::VueloDinamico::ReglaZona nueva = regla == "nada" ? Trinity::VueloDinamico::ReglaZona::Nada
+            : regla == "estable" ? Trinity::VueloDinamico::ReglaZona::Estable
+            : Trinity::VueloDinamico::ReglaZona::Todo;
+
+        sVueloDinamico->FijarReglaDeZona(area, nueva, "puesta desde .vuelo zona");
+        sVueloDinamico->AplicarReglaDeZona(jugador, area);
+
+        handler->PSendSysMessage("Zona %u queda en '%s'. Se aplica al instante y queda en world.vuelo_zona.",
+            area, regla.c_str());
+        return true;
+    }
+
+    // .vuelo impulso <ascenso|avance|giro> <velocidad>
+    //   sin argumentos -> muestra lo que hay cargado
+    //   La velocidad es data pura (world.vuelo_impulso): el codigo no tiene ningun valor quemado,
+    //   solo decide la direccion (ascenso = para arriba, avance/giro = hacia donde mira el draco).
+    static bool HandleImpulsoCommand(ChatHandler* handler, char const* args)
+    {
+        if (!args || !*args)
+        {
+            handler->SendSysMessage(sVueloDinamico->EstadoTexto().c_str());
+            return true;
+        }
+
+        std::string crudo = args;
+        std::vector<char> copia(crudo.begin(), crudo.end());
+        copia.push_back('\0');
+
+        char* tipoArg = strtok(copia.data(), " \t");
+        char* valorArg = tipoArg ? strtok(nullptr, " \t") : nullptr;
+
+        if (!tipoArg || !valorArg)
+        {
+            handler->SendSysMessage("Uso: .vuelo impulso <ascenso|avance|giro> <velocidad>");
+            return false;
+        }
+
+        std::string tipo = tipoArg;
+        if (tipo != "ascenso" && tipo != "avance" && tipo != "giro")
+        {
+            handler->SendSysMessage("Uso: .vuelo impulso <ascenso|avance|giro> <velocidad>");
+            return false;
+        }
+
+        float velocidad = 0.0f;
+        try
+        {
+            velocidad = std::stof(valorArg);
+        }
+        catch (std::exception const&)
+        {
+            handler->SendSysMessage("La velocidad tiene que ser un numero (ejemplo: .vuelo impulso ascenso 18)");
+            return false;
+        }
+
+        if (velocidad <= 0.0f || velocidad > 200.0f)
+        {
+            handler->SendSysMessage("La velocidad tiene que estar entre 0 y 200 (el cliente recorta cerca de 88).");
+            return false;
+        }
+
+        Trinity::VueloDinamico::TipoImpulso elegido = tipo == "ascenso" ? Trinity::VueloDinamico::TipoImpulso::Ascenso
+            : tipo == "giro" ? Trinity::VueloDinamico::TipoImpulso::Giro
+            : Trinity::VueloDinamico::TipoImpulso::Avance;
+
+        sVueloDinamico->FijarVelocidadImpulso(elegido, velocidad);
+
+        handler->PSendSysMessage("Impulsos '%s' quedan en velocidad %.1f (y queda guardado en world.vuelo_impulso).",
+            tipo.c_str(), velocidad);
+        return true;
+    }
+
+    // .vuelo pj <personaje>
+    //   Radiografia para diagnosticar en vivo: montura, auras de estilo y vigor, flags de
+    //   movimiento y si el cliente esta reportando vuelo dinamico (AdvFlying). El modo dinamico lo
+    //   enciende el CLIENTE; esto dice si lo encendio o si esta volando en el modelo viejo.
+    static bool HandlePjCommand(ChatHandler* handler, char const* args)
+    {
+        std::string nombre = args ? args : "";
+        while (!nombre.empty() && (nombre.back() == ' ' || nombre.back() == '\t'))
+            nombre.pop_back();
+
+        if (nombre.empty())
+        {
+            handler->SendSysMessage("Uso: .vuelo pj <personaje>");
+            return false;
+        }
+
+        Player* jugador = BuscarJugador(handler, nombre);
+        if (!jugador)
+            return false;
+
+        handler->SendSysMessage(sVueloDinamico->EstadoJugador(jugador).c_str());
+        return true;
+    }
+
+private:
+    static char const* TextoRegla(Trinity::VueloDinamico::ReglaZona regla)
+    {
+        switch (regla)
+        {
+            case Trinity::VueloDinamico::ReglaZona::Nada:    return "no se vuela";
+            case Trinity::VueloDinamico::ReglaZona::Estable: return "solo vuelo estable";
+            default:                                         return "vuelo normal";
+        }
+    }
+
+    // Acepta el nombre de un personaje conectado (desde la consola no hay "seleccionado").
+    static Player* BuscarJugador(ChatHandler* handler, std::string const& nombre)
+    {
+        ObjectGuid guid = sCharacterCache->GetCharacterGuidByName(nombre);
+        if (!guid)
+        {
+            handler->PSendSysMessage("No existe ningun personaje llamado '%s'.", nombre.c_str());
+            return nullptr;
+        }
+
+        Player* jugador = ObjectAccessor::FindConnectedPlayer(guid);
+        if (!jugador)
+        {
+            handler->PSendSysMessage("El personaje '%s' no esta conectado: el estilo y las habilidades se aplican en vivo.", nombre.c_str());
+            return nullptr;
+        }
+
+        return jugador;
+    }
+};
+} // namespace
+
+void AddSC_vuelo_dinamico()
+{
+    new script_vuelo_jugador();
+    new script_vuelo_mundo();
+    new comando_vuelo();
+
+    RegisterSpellScript(spell_alternar_estilo_vuelo);
+    RegisterSpellScript(spell_impulso_vuelo);
+}
