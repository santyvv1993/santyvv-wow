+#include "ChatCommand.h"
+#include "DatabaseEnv.h"
+#include "Log.h"
+#include "Player.h"
+#include "ScriptMgr.h"
+#include "StringFormat.h"
+#include "World.h"
+#include "WorldSession.h"
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+using namespace Trinity::ChatCommands;
+
+namespace
+{
+// ----------------------------------------------------------------------------
+// configuracion y cache (una sola copia viva en el proceso)
+// ----------------------------------------------------------------------------
+struct MentoriaWarband
+{
+    bool   Activo = true;
+    uint32 PctPorPersonaje = 5;      // retail
+    uint32 PctMax = 25;              // retail
+    uint32 SegundosCache = 300;
+    std::string TextoAviso = "Tutoria de escuadra: +{pct}% de experiencia ({n} personajes al maximo).";
+
+    // guid -> (bono %, cuando se calculo)
+    std::unordered_map<ObjectGuid, std::pair<uint32, uint32>> Cache;
+
+    void CargarConfig()
+    {
+        Activo = true;
+        PctPorPersonaje = 5;
+        PctMax = 25;
+        SegundosCache = 300;
+        TextoAviso = "Tutoria de escuadra: +{pct}% de experiencia ({n} personajes al maximo).";
+        Cache.clear();
+
+        QueryResult resultado = WorldDatabase.Query("SELECT clave, valor FROM mentoria_warband");
+        if (!resultado)
+        {
+            TC_LOG_INFO("scripts.mentoria", "mentoria de escuadra: no hay filas en world.mentoria_warband; se usa el default (activo, +{}% por personaje, tope {}%)",
+                PctPorPersonaje, PctMax);
+            return;
+        }
+
+        do
+        {
+            Field* campos = resultado->Fetch();
+            std::string clave = campos[0].GetString();
+            std::string valor = campos[1].GetString();
+
+            if (clave == "activo")
+                Activo = (valor == "1" || valor == "true" || valor == "si");
+            else if (clave == "pct_por_personaje")
+                PctPorPersonaje = uint32(strtoul(valor.c_str(), nullptr, 10));
+            else if (clave == "pct_max")
+                PctMax = uint32(strtoul(valor.c_str(), nullptr, 10));
+            else if (clave == "segundos_cache")
+                SegundosCache = uint32(strtoul(valor.c_str(), nullptr, 10));
+            else if (clave == "texto_aviso")
+                TextoAviso = valor;
+        }
+        while (resultado->NextRow());
+
+        TC_LOG_INFO("scripts.mentoria", "mentoria de escuadra: {} ({}% por personaje de nivel maximo, tope {}%, cache {} s)",
+            Activo ? "activa" : "apagada", PctPorPersonaje, PctMax, SegundosCache);
+    }
+
+    // Cuenta los personajes de nivel maximo de la MISMA cuenta de battle.net.
+    // Dos consultas porque auth y characters son bases distintas: primero las cuentas de
+    // juego de esa cuenta de battle.net, despues los personajes.
+    uint32 PersonajesAlMaximo(uint32 battlenetAccountId, uint32 nivelMaximo) const
+    {
+        std::string lista;
+        if (QueryResult cuentas = LoginDatabase.PQuery("SELECT id FROM account WHERE battlenet_account = {}", battlenetAccountId))
+        {
+            do
+            {
+                if (!lista.empty())
+                    lista += ",";
+                lista += std::to_string(cuentas->Fetch()[0].GetUInt32());
+            }
+            while (cuentas->NextRow());
+        }
+
+        if (lista.empty())
+            return 0;
+
+        QueryResult personajes = CharacterDatabase.PQuery(
+            "SELECT COUNT(*) FROM characters WHERE account IN ({}) AND level >= {}", lista, nivelMaximo);
+        if (!personajes)
+            return 0;
+
+        return personajes->Fetch()[0].GetUInt32();
+    }
+
+    uint32 BonoDe(Player* jugador, bool recalcular = false)
+    {
+        if (!jugador)
+            return 0;
+
+        if (!Activo || jugador->IsMaxLevel())
+            return 0;
+
+        uint32 ahora = uint32(time(nullptr));
+        auto it = Cache.find(jugador->GetGUID());
+        if (!recalcular && it != Cache.end() && (ahora - it->second.second) < SegundosCache)
+            return it->second.first;
+
+        uint32 nivelMaximo = uint32(sWorld->getIntConfig(CONFIG_MAX_PLAYER_LEVEL));
+        uint32 cuantos = PersonajesAlMaximo(jugador->GetSession()->GetBattlenetAccountId(), nivelMaximo);
+        uint32 pct = cuantos * PctPorPersonaje;
+        if (pct > PctMax)
+            pct = PctMax;
+
+        Cache[jugador->GetGUID()] = { pct, ahora };
+        return pct;
+    }
+
+    void Olvidar(ObjectGuid guid) { Cache.erase(guid); }
+
+    std::string TextoDe(Player* jugador)
+    {
+        uint32 pct = BonoDe(jugador);
+        uint32 cuantos = PctPorPersonaje ? pct / PctPorPersonaje : 0;
+        std::string texto = TextoAviso;
+        auto reemplazar = [&texto](std::string const& de, std::string const& a)
+        {
+            for (size_t p = texto.find(de); p != std::string::npos; p = texto.find(de, p + a.size()))
+                texto.replace(p, de.size(), a);
+        };
+        reemplazar("{pct}", std::to_string(pct));
+        reemplazar("{n}", std::to_string(cuantos));
+        return texto;
+    }
+};
+
+MentoriaWarband& Mentoria()
+{
+    static MentoriaWarband instancia;
+    return instancia;
+}
+
+// ----------------------------------------------------------------------------
+// los enganches de juego
+// ----------------------------------------------------------------------------
+class script_mentoria_jugador : public PlayerScript
+{
+public:
+    script_mentoria_jugador() : PlayerScript("script_mentoria_jugador") { }
+
+    void OnLogin(Player* jugador, bool /*primerIngreso*/) override
+    {
+        uint32 pct = Mentoria().BonoDe(jugador, true);
+        if (!Mentoria().Activo || jugador->IsMaxLevel())
+            return;
+
+        TC_LOG_INFO("scripts.mentoria", "mentoria: {} (nivel {}) tiene +{}% de experiencia", jugador->GetName(), jugador->GetLevel(), pct);
+        if (pct)
+            jugador->GetSession()->SendNotification("%s", Mentoria().TextoDe(jugador).c_str());
+    }
+
+    void OnLevelChanged(Player* jugador, uint8 /*nivelAnterior*/) override
+    {
+        // un personaje que llega al maximo cambia el bono de TODOS los de la cuenta:
+        Mentoria().Cache.clear();
+        Mentoria().BonoDe(jugador, true);
+    }
+
+    void OnLogout(Player* jugador) override
+    {
+        Mentoria().Olvidar(jugador->GetGUID());
+    }
+
+    void OnGiveXP(Player* jugador, uint32& cantidad, Unit* /*victima*/) override
+    {
+        if (!cantidad)
+            return;
+
+        uint32 pct = Mentoria().BonoDe(jugador);
+        if (!pct)
+            return;
+
+        uint32 antes = cantidad;
+        cantidad = uint32(uint64(cantidad) * (100 + pct) / 100);
+        if (cantidad > antes)
+            TC_LOG_DEBUG("scripts.mentoria", "mentoria: {} recibe {} de XP en vez de {} (+{}%)",
+                jugador->GetName(), cantidad, antes, pct);
+    }
+};
+
+class script_mentoria_mundo : public WorldScript
+{
+public:
+    script_mentoria_mundo() : WorldScript("script_mentoria_mundo") { }
+
+    void OnStartup() override
+    {
+        Mentoria().CargarConfig();
+    }
+};
+
+// ----------------------------------------------------------------------------
+// los comandos
+// ----------------------------------------------------------------------------
+class comando_mentoria : public CommandScript
+{
+public:
+    comando_mentoria() : CommandScript("comando_mentoria") { }
+
+    std::span<ChatCommandBuilder const> GetCommands() const override
+    {
+        static ChatCommandTable mentoriaCommandTable =
+        {
+            { "estado",   HandleEstadoCommand,   rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            { "recargar", HandleRecargarCommand, rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            { "pj",       HandlePjCommand,       rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+        };
+        static ChatCommandTable commandTable =
+        {
+            { "mentoria", mentoriaCommandTable },
+        };
+        return commandTable;
+    }
+
+    static bool HandleEstadoCommand(ChatHandler* handler)
+    {
+        MentoriaWarband& m = Mentoria();
+        // PSendSysMessage es estilo printf (%u): con llaves imprime el {} literal. Se arma el texto.
+        handler->SendSysMessage(Trinity::StringFormat(
+            "Tutoria de escuadra: {} | {}% por personaje de nivel maximo | tope {}% | cache {} s",
+            m.Activo ? "ACTIVA" : "APAGADA", m.PctPorPersonaje, m.PctMax, m.SegundosCache));
+        handler->SendSysMessage(Trinity::StringFormat("Nivel maximo del reino: {}",
+            sWorld->getIntConfig(CONFIG_MAX_PLAYER_LEVEL)));
+
+        bool alguno = false;
+        for (auto const& sesion : sWorld->GetAllSessions())
+        {
+            Player* jugador = sesion.second->GetPlayer();
+            if (!jugador)
+                continue;
+            alguno = true;
+            handler->SendSysMessage(Trinity::StringFormat("   {} (nivel {}): +{}%",
+                jugador->GetName(), jugador->GetLevel(), m.BonoDe(jugador, true)));
+        }
+        if (!alguno)
+            handler->SendSysMessage("   (no hay jugadores conectados)");
+        return true;
+    }
+
+    static bool HandleRecargarCommand(ChatHandler* handler)
+    {
+        Mentoria().CargarConfig();
+        handler->SendSysMessage("Tutoria de escuadra: configuracion recargada desde world.mentoria_warband.");
+        return true;
+    }
+
+    // .mentoria pj <personaje>
+    static bool HandlePjCommand(ChatHandler* handler, char const* args)
+    {
+        std::string nombre = args ? args : "";
+        while (!nombre.empty() && (nombre.back() == ' ' || nombre.back() == '\t'))
+            nombre.pop_back();
+
+        if (nombre.empty())
+        {
+            handler->SendSysMessage("Uso: .mentoria pj <personaje>");
+            return false;
+        }
+
+        Player* jugador = nullptr;
+        for (auto const& sesion : sWorld->GetAllSessions())
+        {
+            Player* p = sesion.second->GetPlayer();
+            if (p && p->GetName() == nombre)
+            {
+                jugador = p;
+                break;
+            }
+        }
+
+        if (!jugador)
+        {
+            handler->SendSysMessage(Trinity::StringFormat("El personaje '{}' no esta conectado.", nombre));
+            return false;
+        }
+
+        uint32 nivelMaximo = uint32(sWorld->getIntConfig(CONFIG_MAX_PLAYER_LEVEL));
+        uint32 cuantos = Mentoria().PersonajesAlMaximo(jugador->GetSession()->GetBattlenetAccountId(), nivelMaximo);
+        handler->SendSysMessage(Trinity::StringFormat(
+            "{}: nivel {} (maximo del reino {}), personajes al maximo en la cuenta: {}, bono: +{}%",
+            jugador->GetName(), jugador->GetLevel(), nivelMaximo, cuantos, Mentoria().BonoDe(jugador, true)));
+        return true;
+    }
+};
+} // namespace
+
+void AddSC_mentoria_warband()
+{
+    new script_mentoria_jugador();
+    new script_mentoria_mundo();
+    new comando_mentoria();
+}
