+// Mod propio: grupo de escuadra del warband (los campamentos del char-select).
+// El canal de vuelta (SMSG_ENUM_CHARACTERS_RESULT.WarbandGroups) y el de las escenas
+// ya existen en el core; aca vive solo el guardado y la carga de los grupos.
+
+#include "WarbandGroupMgr.h"
+#include "CharacterPackets.h"
+#include "CollectionMgr.h"
+#include "DB2Stores.h"
+#include "DatabaseEnv.h"
+#include "Log.h"
