+// Mod propio: lectura del CMSG_SETUP_WARBAND_GROUPS (ver mods/warband/REVISION-PLAN-WARBAND.md).
+// Unico dato del formato que no es campo-a-campo en el mismo orden que el SMSG: la cabecera
+// (cantidad de grupos en los 5 bits altos del primer byte) y el nombre (9 bits de tamano + bytes).
+ByteBuffer& operator>>(ByteBuffer& data, WarbandGroupMember& warbandGroupMember)
+{
+    data >> warbandGroupMember.WarbandScenePlacementID;
+    data >> warbandGroupMember.Type;
+    data >> warbandGroupMember.ContentSetID;
+    if (warbandGroupMember.Type == 0)
+        data >> warbandGroupMember.Guid;
+
+    return data;
+}
+
+ByteBuffer& operator>>(ByteBuffer& data, SetupWarbandGroup& warbandGroup)
+{
+    data >> warbandGroup.GroupID;
+    data >> warbandGroup.OrderIndex;
+    data >> warbandGroup.WarbandSceneID;
+    data >> warbandGroup.Flags;
+    data >> warbandGroup.ContentSetID;
+    data >> Size<uint32>(warbandGroup.Members);
+
+    for (WarbandGroupMember& member : warbandGroup.Members)
+        data >> member;
+
+    // ResetBitPos() antes del bloque de bits: deja el lector alineado al byte.
+    // NO se llama FlushBits() al leer: en el camino de lectura FlushBits() agrega un byte
+    // al buffer (append) en vez de descartar bits, e infla el tamano del paquete.
+    data.ResetBitPos();
+    data >> SizedString::BitsSize<9>(warbandGroup.Name);
+    data >> SizedString::Data(warbandGroup.Name);
+
+    return data;
+}
+
+void SetupWarbandGroups::Read()
+{
+    // Cabecera: 5 bits altos del primer byte = cantidad de grupos (sniff 12.0.7: 0x08 = 1 grupo,
+    // 0x10 = 2, 0x18 = 3). Leer los 5 bits MSB-first equivale a header >> 3.
+    uint8 header;
+    _worldPacket >> header;
+
+    uint32 const groupCount = header >> 3;
+    if (groupCount > WarbandGroupMgr::MaxWarbandGroups)
+    {
+        TC_LOG_WARN("network", "SetupWarbandGroups: cabecera 0x{:02X} => {} grupo(s); el maximo es {}. Se ignora el paquete.",
+            header, groupCount, WarbandGroupMgr::MaxWarbandGroups);
+        return;
+    }
+
+    Groups.resize(groupCount);
+    for (uint32 i = 0; i < groupCount; ++i)
+        _worldPacket >> Groups[i];
+
+    // Evidencia para el paso 1 del plan: que mando el cliente, campo a campo.
+    TC_LOG_INFO("network", "SetupWarbandGroups: cabecera 0x{:02X} => {} grupo(s).", header, groupCount);
+    for (SetupWarbandGroup const& group : Groups)
+    {
+        TC_LOG_INFO("network", "  grupo {}: orden {}, escena {}, flags {}, contentSet {}, nombre '{}', {} miembro(s).",
+            group.GroupID, group.OrderIndex, group.WarbandSceneID, group.Flags, group.ContentSetID, group.Name, group.Members.size());
+
+        for (WarbandGroupMember const& member : group.Members)
+            TC_LOG_INFO("network", "    miembro: type {}, ranura {}, contentSet {}, guid {}.",
+                member.Type, member.WarbandScenePlacementID, member.ContentSetID, member.Guid.ToString());
+    }
+}
