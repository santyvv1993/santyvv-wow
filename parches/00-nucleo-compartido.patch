index 1eec121a6a..a27687f9c9 100644
--- a/src/server/database/Database/DatabaseWorkerPool.cpp
+++ b/src/server/database/Database/DatabaseWorkerPool.cpp
@@ -33,8 +33,10 @@
 #include "QueryResult.h"
 #include "Transaction.h"
 #include "MySQLWorkaround.h"
+#include <chrono>
 #include <boost/asio/use_future.hpp>
 #include <mysqld_error.h>
+#include <thread>
 #include <utility>
 #ifdef TRINITY_DEBUG
 #include <boost/stacktrace.hpp>
@@ -524,13 +526,31 @@ T* DatabaseWorkerPool<T>::GetFreeConnection()
     uint8 i = 0;
     auto const num_cons = _connections[IDX_SYNCH].size();
     T* connection = nullptr;
-    //! Block forever until a connection is free
+    //! Block until a connection is free. Every sync connection of this database being busy is the
+    //! only case worth waiting for here, and a bare try_lock loop is not free: it burns a core
+    //! competing with the thread that actually holds the connection, and if a query gets stuck it
+    //! spins forever without saying anything. So: yield while it may be momentary, then back off
+    //! and put it in the log, so a hang leaves a trace instead of a hot CPU.
+    uint32 tries = 0;
     for (;;)
     {
         connection = _connections[IDX_SYNCH][i++ % num_cons].get();
         //! Must be matched with t->Unlock() or you will get deadlocks
         if (connection->LockIfReady())
             break;
+
+        if (++tries < num_cons) // first pass over the connections: they may just be momentarily busy
+        {
+            std::this_thread::yield();
+            continue;
+        }
+
+        if (tries == num_cons)
+            TC_LOG_WARN("sql.performances", "All {} sync connection(s) are busy; waiting with back-off", num_cons);
+        else if (tries % 5000 == 0) // 5000 rounds of 1 ms => roughly every 5 seconds
+            TC_LOG_WARN("sql.performances", "Still no free sync connection ({} tries, ~{} s) - is a sync query stuck?", tries, tries / 5000 * 5);
+
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
     }
 
     return connection;
