+// El oro del banco de cuenta vive en el campo AccountBankCoinage (ActivePlayerData) y el core no
+// lo persiste. Se guarda en `characters.character_account_bank`, una fila por personaje, y se
+// carga ANTES de que el jugador entre al mundo para que venga en el bloque de creacion que recibe
+// el cliente (si se cargara despues, el cliente mostraria 0 hasta la primera operacion).
+void Player::LoadAccountBankMoney()
+{
+    uint64 money = 0;
+
+    // El fork no acepta std::string en Query/Execute: la via con formato es PQuery/PExecute
+    // (Trinity::StringFormat, con {}).
+    if (QueryResult result = CharacterDatabase.PQuery("SELECT money FROM character_account_bank WHERE guid = {}", GetGUID().GetCounter()))
+        money = result->Fetch()[0].GetUInt64();
+
+    SetUpdateFieldValue(m_values.ModifyValue(&Player::m_activePlayerData).ModifyValue(&UF::ActivePlayerData::AccountBankCoinage), money);
+}
+
+void Player::SetAccountBankMoney(uint64 money)
+{
+    SetUpdateFieldValue(m_values.ModifyValue(&Player::m_activePlayerData).ModifyValue(&UF::ActivePlayerData::AccountBankCoinage), money);
+
+    // Se guarda al instante: si el servidor se cae, el oro del banco tiene que estar en disco.
+    CharacterDatabase.PExecute("REPLACE INTO character_account_bank (guid, money) VALUES ({}, {})", GetGUID().GetCounter(), money);
+}
