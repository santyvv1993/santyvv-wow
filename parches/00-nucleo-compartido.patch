+// El nivel que el jugador VE en una criatura escalable no es UNIT_FIELD_LEVEL: el cliente lo calcula
+// con los campos de escalado, igual que ::GetLevelForTarget:
+//     nivel mostrado = clamp(nivelDelJugador, ScalingLevelMin, ScalingLevelMax) + ScalingLevelDelta
+// Por eso, en una mazmorra de una expansion vieja (ContentTuning 502 = min/max 50) subir el nivel del
+// servidor con SetLevel no cambia el rotulo: el clamp sigue topando en 50. Correr el delta es lo que
+// mueve el numero en pantalla. Se dejan Min/Max como los declara el ContentTuning del contenido, de
+// modo que el resultado es el mismo tanto si el cliente los toma de los campos como de su tabla; y de
+// paso GetLevelForTarget pasa a devolver el mismo nivel que ::GetLevel(), con lo que los multiplicadores
+// por objetivo (vida, dano, armadura) quedan en 1.0 en vez de mezclar dos niveles.
+void Creature::SetScaledDisplayLevel(uint8 level)
+{
+    if (!HasScalableLevels())
+        return; // sin ContentTuning el cliente ya dibuja UNIT_FIELD_LEVEL
+
+    SetUpdateFieldValue(m_values.ModifyValue(&Unit::m_unitData).ModifyValue(&UF::UnitData::ScalingLevelDelta),
+        int32(level) - m_unitData->ScalingLevelMax);
+}
