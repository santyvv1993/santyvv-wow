+// Una estancia habilitada (world.mitica_estancia)
+struct Estancia
+{
+    uint32 CmId = 0;
+    uint32 MapId = 0;
+    std::string Nombre;
+    uint32 Temporada = 1;
+    bool Activa = true;
+    uint32 NivelMin = 2;
+    uint32 NivelRec = 5;
+    uint32 NivelMax = 10;
+    uint32 TiempoOro = 0;
+    uint32 TiempoPlata = 0;
+    uint32 TiempoBronce = 0;
+    uint32 FuerzasMin = 100;
+    uint32 CofreGo = 252064;
+    uint32 IlvlTecho = 318;
+    // Entries del jefe que cierra la corrida, separados por espacio (un encuentro puede ser de varios:
+    // Kyrakka y Erkhart, "La Oscuridad"...). Vacio = regla general: la corrida cierra cuando no queda
+    // ningun jefe marcado vivo (que en la TDB actual no sirve: no hay ninguno marcado).
+    std::string JefeFinal;
+
+    // Camino central (como retail): cuando no queda vivo ninguno de estos jefes, se abre el objeto de
+    // paso `CaminoGo` -- la escalera/reja que da al jefe final. Abrirlo dispara la animacion propia del
+    // objeto, que es la "cinematica" del pasillo. El vigilante automatico no lo toca: ese paso lo abre
+    // el diseño, y `.mitica destrabar` (manual) queda como ultima salida si algo falla.
+    std::string CaminoJefes;
+    uint32 CaminoGo = 0;
+
+    // Objetos de COLISION que hay que despenzar cuando se abre el camino (paredes invisibles
+    // genericas, tipo 5, que el destrabar no toca porque no son puertas). Separados por espacio.
+    std::string CaminoQuitar;
+
+    // NPC de salida: aparece junto al grupo al cerrar la corrida y, por gossip, los saca de la
+    // estancia (`SalidaPunto` = "mapa x y z o", tomado del trigger de salida del propio cliente).
+    uint32 SalidaNpc = 0;
+    std::string SalidaPunto;
+
+    // Botin del cofre de recompensa de esta estancia (tabla `mitica_cofre_item`). Sale del diario del
+    // cliente (`JournalEncounterItem`): es lo que el jefe suelta en retail.
+    std::vector<uint32> CofreItems;
+};
+
+// Un afijo de la temporada. `Implementacion` dice como se aplica (hoy solo `estatico` = multiplicador de
+// vida/dano) y `Parametros` lleva los numeros, con la forma "objetivo=jefes|basura;vida=N;dano=N".
+// Todo dato: se ajusta en `world.mitica_afijo` sin recompilar.
+struct Afijo
+{
+    uint32 Id = 0;
+    std::string Nombre;
+    std::string Implementacion;
+    std::string Parametros;
+    bool Activo = false;
+};
+
+// La curva de dificultad (world.mitica_nivel)
+struct Nivel
+{
+    uint32 NivelPiedra = 2;   // (no se llama "Nivel": el miembro no puede repetir el nombre del struct)
+    float VidaPct = 100.0f;
+    float DanoPct = 100.0f;
+    float JefeVidaPct = 100.0f;
+    float JefeDanoPct = 100.0f;
+    uint32 FuerzasObjetivo = 100;
+    uint32 IlvlMin = 0;
+    uint32 IlvlMax = 0;
+};
+
+// Una corrida viva (o cerrada si Estado != en_curso)
+struct Corrida
+{
+    uint64 Id = 0;
+    uint32 CmId = 0;
+    uint32 MapId = 0;
+    uint32 NivelKeystone = 2;
+    std::string Afijos;
+    uint32 Instancia = 0;
+    ObjectGuid Lider;
+    std::vector<ObjectGuid> Miembros;
+    time_t Inicio = 0;
+    uint32 Muertes = 0;
+    float Fuerzas = 0.0f;
+    bool Prueba = false;
+
+    // Estado de la vigilancia (si no, una corrida de prueba con jefes ya muertos cerraria sola)
+    bool JefesVistos = false;        // se vio al menos un jefe vivo en la instancia
+    bool AvisoFuerzas = false;       // ya se aviso que las fuerzas estan completas
+
+    // Camino central: el paso al jefe final se abre cuando mueren los jefes declarados en la estancia.
+    bool CaminoVistos = false;       // se vio vivo al menos uno de esos jefes (una instancia recien cargada no cuenta)
+    bool CaminoAbierto = false;      // ya se abrio (o ya estaba abierto): no se repite
+
+    // Red de seguridad del recorrido: si el lider se queda parado al lado de un objeto de paso
+    // cerrado (una reja comun que nadie abre), el vigilante la abre. No es adorno: es lo que hace
+    // que una corrida no se trabe nunca por un dato que falte.
+    float UltimaX = 0.0f;
+    float UltimaY = 0.0f;
+    float UltimaZ = 0.0f;
+    bool PosicionInicial = false;    // todavia no se guardo la posicion del lider
+    uint32 QuietoSeg = 0;            // segundos acumulados sin moverse (casi)
+    uint32 TrabasAbiertas = 0;       // cuantos objetos abrio el vigilante en esta corrida
+
+    // La corrida ya cerro (piedra devuelta, cofre y guia invocados). Se conserva en memoria un rato
+    // para que el cofre y el guia sigan funcionando: el cierre NO borra el estado.
+    bool Cerrada = false;
+    std::vector<ObjectGuid> CofreLooteado;   // quien ya saco su item del cofre (una vez por cabeza)
+
+    // Puntaje de la corrida (formula NUESTRA, ver `CalcularPuntos`): se guarda en la corrida para que
+    // viaje en el paquete de cierre y en el aviso del chat.
+    uint32 Puntos = 0;
+
+    uint32 SegundosTranscurridos() const
+    {
+        return Inicio ? uint32(time(nullptr) - Inicio) : 0;
+    }
+};
