+// ---------------------------------------------------------------------------
+// Hablar con el cliente
+// ---------------------------------------------------------------------------
+void Mgr::Aviso(Player* jugador, std::string const& texto) const
+{
+    if (jugador && jugador->GetSession())
+        jugador->GetSession()->SendNotification("%s", texto.c_str());
+}
+
+void Mgr::AvisarAlGrupo(Corrida const& corrida, std::string const& texto) const
+{
+    for (ObjectGuid const& guid : corrida.Miembros)
+        if (Player* miembro = ObjectAccessor::FindConnectedPlayer(guid))
+            Aviso(miembro, texto);
+}
+
+std::string Mgr::ResolverValor(std::string const& valor, Corrida const& corrida, Map const* mapa) const
+{
+    if (valor.size() < 4 || valor[0] != '{')
+        return valor;   // literal
+
+    Estancia const* estancia = GetEstancia(corrida.CmId);
+    Nivel const* nivel = GetNivel(corrida.NivelKeystone);
+    std::string clave = valor.substr(2, valor.size() - 4);
+
+    if (clave == "cm_id")        return Trinity::StringFormat("{}", corrida.CmId);
+    if (clave == "map_id")       return Trinity::StringFormat("{}", corrida.MapId);
+    if (clave == "nivel")        return Trinity::StringFormat("{}", corrida.NivelKeystone);
+    if (clave == "instancia")    return Trinity::StringFormat("{}", corrida.Instancia);
+    if (clave == "temporada")    return Trinity::StringFormat("{}", estancia ? estancia->Temporada : 1);
+    if (clave == "t_seg_oro")    return Trinity::StringFormat("{}", estancia ? estancia->TiempoOro : 0);
+    if (clave == "t_seg_plata")  return Trinity::StringFormat("{}", estancia ? estancia->TiempoPlata : 0);
+    if (clave == "t_seg_bronce") return Trinity::StringFormat("{}", estancia ? estancia->TiempoBronce : 0);
+    if (clave == "t_ms_bronce")  return Trinity::StringFormat("{}", estancia ? estancia->TiempoBronce * 1000 : 0);
+    if (clave == "ilvl_max")     return Trinity::StringFormat("{}", nivel ? nivel->IlvlMax : 0);
+    if (clave == "muertes")      return Trinity::StringFormat("{}", corrida.Muertes);
+    if (clave == "segundos")     return Trinity::StringFormat("{}", corrida.SegundosTranscurridos());
+    // El paquete de cierre pide la duracion en MILISEGUNDOS (el motor solo guarda segundos).
+    if (clave == "segundos_ms")  return Trinity::StringFormat("{}", uint64(corrida.SegundosTranscurridos()) * 1000);
+    if (clave == "puntos")       return Trinity::StringFormat("{}", corrida.Puntos);
+    if (clave == "grupo")        return Trinity::StringFormat("{}", uint32(corrida.Miembros.size()));
+    if (clave == "mapa_dificultad")
+        return Trinity::StringFormat("{}", mapa ? uint32(mapa->GetDifficultyID()) : 0);
+    if (clave == "afijos")
+    {
+        // IDs separados por espacio (formato para array_u32)
+        std::string ids;
+        for (uint32 afijo : ListaDeIds(corrida.Afijos))
+            ids += Trinity::StringFormat("{} ", afijo);
+        return ids;
+    }
+    return valor;
+}
+
+void Mgr::EnviarPaquete(Player* jugador, Corrida const& corrida, std::string const& nombre)
+{
+    if (!jugador)
+        return;
+
+    QueryResult cabecera = WorldDatabase.PQuery("SELECT activo FROM mitica_paquete WHERE opcode = '{}'", nombre);
+    if (!cabecera || cabecera->Fetch()[0].GetUInt8() == 0)
+        return;   // apagado en la base: no se manda
+
+    QueryResult campos = WorldDatabase.PQuery(
+        "SELECT tipo, valor FROM mitica_paquete_campo WHERE opcode = '{}' ORDER BY orden", nombre);
+    if (!campos)
+        return;
+
+    OpcodeServer opcode;
+    if (!OpcodeDeNombre(nombre, opcode))
+    {
+        TC_LOG_ERROR("scripts.miticas", "paquete desconocido en la base: {}", nombre);
+        return;
+    }
+
+    WorldPacket paquete(opcode);
+    std::vector<uint8> control;
+
+    do
+    {
+        Field* campo = campos->Fetch();
+        std::string tipo = campo[0].GetString();
+        std::string valor = ResolverValor(campo[1].GetString(), corrida, jugador->GetMap());
+
+        if (tipo == "u8")
+        {
+            uint8 v = uint8(strtoul(valor.c_str(), nullptr, 10));
+            paquete << v;
+            control.push_back(v);
+        }
+        else if (tipo == "u16")
+            paquete << uint16(strtoul(valor.c_str(), nullptr, 10));
+        else if (tipo == "u32")
+            paquete << uint32(strtoul(valor.c_str(), nullptr, 10));
+        else if (tipo == "i32")
+            paquete << int32(strtol(valor.c_str(), nullptr, 10));
+        else if (tipo == "u64")
+            paquete << uint64(strtoull(valor.c_str(), nullptr, 10));
+        else if (tipo == "f32")
+            paquete << float(strtof(valor.c_str(), nullptr));
+        else if (tipo == "cadena")
+            paquete << valor;
+        else if (tipo == "array_u32")
+        {
+            std::vector<uint32> ids = ListaDeIds(valor);
+            paquete << uint32(ids.size());
+            for (uint32 id : ids)
+                paquete << id;
+        }
+        else
+            TC_LOG_ERROR("scripts.miticas", "tipo de campo desconocido '{}' en {}", tipo, nombre);
+    } while (campos->NextRow());
+
+    jugador->SendDirectMessage(&paquete);
+    TC_LOG_INFO("scripts.miticas", "paquete {} ({} bytes) enviado a {} [{}]",
+        nombre, uint32(paquete.size()), jugador->GetName(), AHex(control));
+}
+} // namespace MythicPlus
+} // namespace Trinity
