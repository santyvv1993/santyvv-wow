+    // (como en retail) y la devuelve al cerrar. La tabla characters.mitica_piedra solo recuerda
+    // que modificadores lleva el item, NO es la fuente de verdad de que el item exista.
+    bool Iniciar(Player* lider, Item* piedra, uint32 cmId, uint32 nivelKeystone, bool prueba,
