+
+namespace Trinity
+{
+namespace MythicPlus
+{
+namespace
+{
+// Nombre (base) -> opcode del servidor. Solo los que usamos.
+bool OpcodeDeNombre(std::string const& nombre, OpcodeServer& salida)
+{
+    if (nombre == "SMSG_CHALLENGE_MODE_START")              { salida = SMSG_CHALLENGE_MODE_START; return true; }
+    if (nombre == "SMSG_CHALLENGE_MODE_UPDATE_DEATH_COUNT") { salida = SMSG_CHALLENGE_MODE_UPDATE_DEATH_COUNT; return true; }
+    if (nombre == "SMSG_CHALLENGE_MODE_COMPLETE")           { salida = SMSG_CHALLENGE_MODE_COMPLETE; return true; }
+    // Temporada y afijos: son los que le dicen al cliente que la mitica+ esta ACTIVA. Sin ellos el
+    // cliente puede ocultar toda la UI de miticas+, por mas que el resto de los paquetes llegue.
+    if (nombre == "SMSG_MYTHIC_PLUS_SEASON_DATA")           { salida = SMSG_MYTHIC_PLUS_SEASON_DATA; return true; }
+    if (nombre == "SMSG_MYTHIC_PLUS_CURRENT_AFFIXES")       { salida = SMSG_MYTHIC_PLUS_CURRENT_AFFIXES; return true; }
+    return false;
+}
+
+std::string AHex(std::vector<uint8> const& bytes)
+{
+    std::string salida;
+    for (uint8 b : bytes)
+        salida += Trinity::StringFormat("{:02X} ", b);
+    return salida;
+}
+
+std::vector<uint32> ListaDeIds(std::string const& texto)
+{
+    // Los ids pueden venir separados por espacios (lo que dice la documentacion de la tabla) o por
+    // comas, que es como los escribe uno naturalmente. Se aceptan los dos: si esto no fuera tolerante,
+    // una coma de mas deja la lista VACIA y la regla que la usa simplemente no hace nada, sin error.
+    std::string limpio = texto;
+    for (char& caracter : limpio)
+    {
+        if (caracter == ',' || caracter == ';')
+            caracter = ' ';
+    }
+
+    std::vector<uint32> ids;
+    for (std::string_view parte : Trinity::Tokenize(limpio, ' ', false))
+    {
+        uint32 valor = 0;
+        auto [fin, error] = std::from_chars(parte.data(), parte.data() + parte.size(), valor);
+        if (error == std::errc() && fin == parte.data() + parte.size() && valor)
+            ids.push_back(valor);
+    }
+    return ids;
+}
+} // namespace
+
+// El HUD de la mitica+ NO vive en el paquete: el temporizador sale del campo de update del jugador
+// (`ActivePlayerData.ChallengeModeData`, bit 134, con `StartTime`). Nuestro codigo nunca lo escribia,
+// asi que el cliente veia StartTime = 0: el reloj no corria y el panel de cierre mostraba "se acabo el
+// tiempo" aunque la medalla fuera buena. Las dos puertas viven en `Player` (los setters de update
+// fields son protected en BaseEntity): `MarcarDesafioMythicPlus` / `QuitarDesafioMythicPlus`.
+void MarcarDesafio(Player* jugador, Corrida const& corrida, bool activo)
+{
+    if (!jugador)
+        return;
+
+    if (!activo)
+    {
+        jugador->QuitarDesafioMythicPlus();
+        return;
+    }
+
+    jugador->MarcarDesafioMythicPlus(int32(corrida.MapId), int32(corrida.Miembros.size()),
+        uint64(corrida.Instancia), int64(corrida.Inicio), corrida.Lider, corrida.Prueba);
+}
+
+Mgr* Mgr::instance()
+{
+    static Mgr instancia;
+    return &instancia;
+}
+
+// ---------------------------------------------------------------------------
+// Configuracion: todo sale de world.mitica_*
+// ---------------------------------------------------------------------------
+void Mgr::CargarConfig()
+{
+    _estancias.clear();
+    _porCmId.clear();
+    _niveles.clear();
+    _afijos.clear();
+    _config.clear();
+    _temporadaNombre = "Temporada";
+
+    // 1) la temporada viva: es la que decide QUE estancias entran
+    uint32 temporadaActiva = 0;
+    if (QueryResult temporada = WorldDatabase.Query(
+            "SELECT id, nombre FROM mitica_temporada WHERE activa = 1 ORDER BY desde DESC LIMIT 1"))
+    {
+        Field* campos = temporada->Fetch();
+        temporadaActiva = campos[0].GetUInt32();
+        _temporadaNombre = campos[1].GetString();
+    }
+
+    // 2) los numeros y los textos (nada quemado en el codigo)
+    if (QueryResult config = WorldDatabase.Query("SELECT clave, valor FROM mitica_config"))
+        do
+        {
+            Field* campos = config->Fetch();
+            _config[campos[0].GetString()] = campos[1].GetString();
+        } while (config->NextRow());
+
+    // Los afijos y su EFECTO. `Implementacion` decide como se aplica; hoy el motor entiende `estatico`
+    // (multiplicador de vida/dano, leido de `Parametros`). El resto queda declarado y sin efecto, que es
+    // informacion honesta: en `mitica_afijo` se ve de un vistazo que falta y cual.
+    if (QueryResult afijos = WorldDatabase.Query(
+            "SELECT afijo_id, nombre, implementacion, parametros, activo FROM mitica_afijo"))
+    {
+        do
+        {
+            Field* campos = afijos->Fetch();
+            Afijo a;
+            a.Id = campos[0].GetUInt32();
+            a.Nombre = campos[1].GetString();
+            a.Implementacion = campos[2].GetString();
+            a.Parametros = campos[3].GetString();
+            a.Activo = campos[4].GetUInt32() != 0;
+            _afijos[a.Id] = a;
+        } while (afijos->NextRow());
+
+        uint32 conEfecto = 0;
+        for (auto const& [id, afijo] : _afijos)
+            if (afijo.Activo && afijo.Implementacion != "sin_implementar")
+                ++conEfecto;
+
+        TC_LOG_INFO("scripts.miticas", "afijos cargados: {} declarados, {} activos con efecto", _afijos.size(), conEfecto);
+    }
+
+    // 3) las estancias de esa temporada (sin temporada declarada entran todas)
+    std::string filtro = temporadaActiva
+        ? Trinity::StringFormat("WHERE temporada = {}", temporadaActiva)
+        : std::string();
+
+    if (QueryResult resultado = WorldDatabase.Query(
+            Trinity::StringFormat(
+                "SELECT cm_id, map_id, nombre, temporada, activa, nivel_min, nivel_rec, nivel_max, "
+                "tiempo_oro, tiempo_plata, tiempo_bronce, fuerzas_min, cofre_go, ilvl_techo, jefe_final, "
+                "camino_jefes, camino_go, camino_quitar, salida_npc, salida_punto "
+                "FROM mitica_estancia {} ORDER BY cm_id", filtro).c_str()))
+    {
+        do
+        {
+            Field* campos = resultado->Fetch();
+            Estancia e;
+            e.CmId = campos[0].GetUInt32();
+            e.MapId = campos[1].GetUInt32();
+            e.Nombre = campos[2].GetString();
+            e.Temporada = campos[3].GetUInt32();
+            e.Activa = campos[4].GetUInt8() != 0;
+            e.NivelMin = campos[5].GetUInt32();
+            e.NivelRec = campos[6].GetUInt32();
+            e.NivelMax = campos[7].GetUInt32();
+            e.TiempoOro = campos[8].GetUInt32();
+            e.TiempoPlata = campos[9].GetUInt32();
+            e.TiempoBronce = campos[10].GetUInt32();
+            e.FuerzasMin = campos[11].GetUInt32();
+            e.CofreGo = campos[12].GetUInt32();
+            e.IlvlTecho = campos[13].GetUInt32();
+            e.JefeFinal = campos[14].GetString();
+            e.CaminoJefes = campos[15].GetString();
+            e.CaminoGo = campos[16].GetUInt32();
+            e.CaminoQuitar = campos[17].GetString();
+            e.SalidaNpc = campos[18].GetUInt32();
+            e.SalidaPunto = campos[19].GetString();
+            _porCmId[e.CmId] = e;
+            _estancias.push_back(e);
+        } while (resultado->NextRow());
+    }
+
+    // Botin del cofre por estancia (dato plano: cm_id -> item). El cofre lo entrega NUESTRO codigo,
+    // porque el core no tiene logica para el tipo 51 (GAMEOBJECT_TYPE_CHALLENGE_MODE_REWARD).
+    if (QueryResult resultado = WorldDatabase.Query("SELECT cm_id, item FROM mitica_cofre_item ORDER BY cm_id, item"))
+    {
+        uint32 total = 0;
+        do
+        {
+            Field* campos = resultado->Fetch();
+            uint32 cmId = campos[0].GetUInt32();
+            uint32 item = campos[1].GetUInt32();
+            if (!item)
+                continue;
+
+            for (Estancia& estancia : _estancias)
+                if (estancia.CmId == cmId)
+                {
+                    estancia.CofreItems.push_back(item);
+                    ++total;
+                    break;
+                }
+
+            auto itr = _porCmId.find(cmId);
+            if (itr != _porCmId.end())
+                itr->second.CofreItems.push_back(item);
+        } while (resultado->NextRow());
+
+        TC_LOG_INFO("scripts.miticas", "botin de cofres cargado: {} item(s) en {} estancia(s)", total, _estancias.size());
+    }
+
+    if (QueryResult resultado = WorldDatabase.Query(
+            "SELECT nivel, vida_pct, dano_pct, jefe_vida_pct, jefe_dano_pct, fuerzas_objetivo, "
+            "ilvl_min, ilvl_max FROM mitica_nivel"))
+    {
+        do
+        {
+            Field* campos = resultado->Fetch();
+            Nivel n;
+            n.NivelPiedra = campos[0].GetUInt32();
+            n.VidaPct = campos[1].GetFloat();
+            n.DanoPct = campos[2].GetFloat();
+            n.JefeVidaPct = campos[3].GetFloat();
+            n.JefeDanoPct = campos[4].GetFloat();
+            n.FuerzasObjetivo = campos[5].GetUInt32();
+            n.IlvlMin = campos[6].GetUInt32();
+            n.IlvlMax = campos[7].GetUInt32();
+            _niveles[n.NivelPiedra] = n;
+        } while (resultado->NextRow());
+    }
+
+    _configCargada = true;
+    TC_LOG_INFO("scripts.miticas", "config de miticas cargada: temporada '{}' con {} estancias, "
+        "{} niveles y {} claves de config", _temporadaNombre, uint32(_estancias.size()),
+        uint32(_niveles.size()), uint32(_config.size()));
+}
+
+Estancia const* Mgr::GetEstancia(uint32 cmId) const
+{
+    auto itr = _porCmId.find(cmId);
+    return itr == _porCmId.end() ? nullptr : &itr->second;
+}
+
+Nivel const* Mgr::GetNivel(uint32 nivelKeystone) const
+{
+    auto itr = _niveles.find(nivelKeystone);
+    return itr == _niveles.end() ? nullptr : &itr->second;
+}
