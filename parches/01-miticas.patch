+uint32 Mgr::ItemPiedra() const           { return ConfigNumero("piedra_item", 180653); }
+uint32 Mgr::AfijosMax() const            { return ConfigNumero("afijos_max", 4); }
+std::string Mgr::TemporadaNombre() const { return _temporadaNombre; }
+
+std::string Mgr::Plantilla(std::string const& clave, Corrida const& corrida,
+    std::initializer_list<std::pair<std::string, std::string>> extras) const
+{
+    std::string texto = Config(clave, clave);   // si falta la clave, se ve el nombre de la clave
+
+    Estancia const* estancia = GetEstancia(corrida.CmId);
+    auto reemplazar = [&texto](std::string const& claveValor, std::string const& valor)
+    {
+        std::string marca = "{" + claveValor + "}";
+        for (std::size_t pos = texto.find(marca); pos != std::string::npos; pos = texto.find(marca, pos))
+            texto.replace(pos, marca.size(), valor);
+    };
+
+    reemplazar("estancia", estancia ? estancia->Nombre : "?");
+    reemplazar("temporada", _temporadaNombre);
+    reemplazar("nivel", Trinity::StringFormat("{}", corrida.NivelKeystone));
+    reemplazar("oro", Trinity::StringFormat("{}", estancia ? estancia->TiempoOro / 60 : 0));
+    reemplazar("plata", Trinity::StringFormat("{}", estancia ? estancia->TiempoPlata / 60 : 0));
+    reemplazar("bronce", Trinity::StringFormat("{}", estancia ? estancia->TiempoBronce / 60 : 0));
+    reemplazar("muertes", Trinity::StringFormat("{}", corrida.Muertes));
+    reemplazar("fuerzas", Trinity::StringFormat("{:.0f}", corrida.Fuerzas));
+    reemplazar("tiempo", Trinity::StringFormat("{} min {} s",
+        corrida.SegundosTranscurridos() / 60, corrida.SegundosTranscurridos() % 60));
+    reemplazar("medalla", Medalla(corrida));
+
+    for (auto const& [claveExtra, valorExtra] : extras)
+        reemplazar(claveExtra, valorExtra);
+
+    return texto;
+}
+
+// ---------------------------------------------------------------------------
+// Ciclo de vida
+// ---------------------------------------------------------------------------
+bool Mgr::Iniciar(Player* lider, Item* piedra, uint32 cmId, uint32 nivelKeystone, bool prueba,
+    std::string& motivo)
+{
+    if (!_configCargada)
+        CargarConfig();
+
+    Estancia const* estancia = GetEstancia(cmId);
+    if (!estancia)
+    {
+        motivo = "esa estancia no esta en la temporada";
+        return false;
+    }
+    if (!estancia->Activa)
+    {
+        motivo = Trinity::StringFormat("{} esta apagada en la temporada", estancia->Nombre);
+        return false;
+    }
+    if (nivelKeystone < estancia->NivelMin || nivelKeystone > estancia->NivelMax)
+    {
+        motivo = Trinity::StringFormat("{} pide nivel de piedra entre {} y {} (la tuya es {})",
+            estancia->Nombre, estancia->NivelMin, estancia->NivelMax, nivelKeystone);
+        return false;
+    }
+
+    Map* mapa = lider->GetMap();
+    if (!mapa || !mapa->IsDungeon())
+    {
+        motivo = "hay que estar dentro de la mazmorra";
+        return false;
+    }
+    if (mapa->GetId() != estancia->MapId)
+    {
+        motivo = Trinity::StringFormat("estas en otra mazmorra (mapa {}), no en {}",
+            mapa->GetId(), estancia->Nombre);
+        return false;
+    }
+    if (Corrida* existente = GetCorridaPorInstancia(mapa->GetId(), mapa->GetInstanceId()))
+    {
+        motivo = Trinity::StringFormat("ya hay una corrida en curso aca (id {})", existente->Id);
+        return false;
+    }
+
+    // La piedra tiene que estar de verdad en el inventario del lider: el ITEM manda, no la tabla
+    // (la tabla solo recuerda que modificadores lleva). Si no esta, la corrida no arranca.
+    if (!piedra || piedra->GetEntry() != ItemPiedra() || !lider->GetItemByGuid(piedra->GetGUID()))
+    {
+        motivo = "la piedra no esta en tu inventario";
+        return false;
+    }
+
+    uint64 nuevoId = 1;
+    if (QueryResult maximo = CharacterDatabase.Query("SELECT COALESCE(MAX(corrida_id), 0) + 1 FROM mitica_corrida"))
+        if (Field* campo = maximo->Fetch())
+            nuevoId = campo[0].GetUInt64();
+
+    // Afijos que entran a este nivel: el calendario del cliente (mitica_afijo_nivel) filtrado por los
+    // que tenemos activos en mitica_afijo. Se materializa antes de tocar otras consultas.
+    std::string afijos;
+    {
+        std::vector<uint32> ids;
+        if (QueryResult res = WorldDatabase.PQuery(
+                "SELECT an.afijo_id FROM mitica_afijo_nivel an JOIN mitica_afijo a ON a.afijo_id = an.afijo_id "
+                "WHERE an.desde_nivel <= {} AND an.desde_nivel > 0 AND a.activo = 1 ORDER BY an.afijo_id",
+                nivelKeystone))
+            do
+            {
+                ids.push_back(res->Fetch()[0].GetUInt32());
+            } while (res->NextRow());
+
+        for (uint32 id : ids)
+            afijos += Trinity::StringFormat("{} ", id);
+    }
+
+    Corrida corrida;
+    corrida.Id = nuevoId;
+    corrida.CmId = cmId;
+    corrida.MapId = estancia->MapId;
+    corrida.NivelKeystone = nivelKeystone;
+    corrida.Afijos = afijos;
+    corrida.Instancia = mapa->GetInstanceId();
+    corrida.Lider = lider->GetGUID();
+    corrida.Inicio = time(nullptr);
+    corrida.Prueba = prueba;
+
+    if (Group* grupo = lider->GetGroup())
+        for (GroupReference const& referencia : grupo->GetMembers())
+            if (Player* miembro = referencia.GetSource())
+                corrida.Miembros.push_back(miembro->GetGUID());
+    if (corrida.Miembros.empty())
+        corrida.Miembros.push_back(lider->GetGUID());
+
+    std::string miembros;
+    for (ObjectGuid const& guid : corrida.Miembros)
+        miembros += Trinity::StringFormat("{} ", guid.GetCounter());
+
+    // La piedra se consume al arrancar (como en retail): sale del inventario y su fila se borra.
+    // Vuelve al cerrar la corrida; si el mundo se reinicia en medio, la corrida queda con
+    // piedra_devuelta = 0 y se le devuelve al entrar (DevolverPiedrasPendientes).
+    uint64 guidPiedra = piedra->GetGUID().GetCounter();
+    uint32 cuantas = 1;
+    lider->DestroyItemCount(piedra, cuantas, true);
+    CharacterDatabase.PExecute("DELETE FROM mitica_piedra WHERE item_guid = {}", guidPiedra);
+
+    // Arranca sabiendo si la mazmorra tiene jefes vivos: asi el cierre por jefes no depende de que
+    // la vigilancia alcance a verlos antes de la ultima muerte.
+    corrida.JefesVistos = JefesVivos(mapa, estancia) > 0;
+
+    // Si no hay jefe declarado NI la TDB marca ninguno, o el jefe declarado no esta spawneado, esta
+    // corrida no va a cerrar sola: mejor decirlo en el log que dejar al jugador esperando un cierre
+    // que no llega (se cierra a mano con `.mitica cerrar`).
+    if (!corrida.JefesVistos)
+    {
+        if (estancia->JefeFinal.empty())
+            TC_LOG_WARN("scripts.miticas", "la estancia {} (cm {}) no declara jefe_final y la TDB no marca "
+                "ningun jefe en el mapa {}: la corrida {} no va a cerrar sola (se cierra con .mitica cerrar)",
+                estancia->Nombre, estancia->CmId, estancia->MapId, corrida.Id);
+        else
+            TC_LOG_WARN("scripts.miticas", "el jefe final declarado de {} ({}) no esta vivo (ni spawneado) en "
+                "el mapa {}: la corrida {} no va a cerrar sola (se cierra con .mitica cerrar)",
+                estancia->Nombre, estancia->JefeFinal, estancia->MapId, corrida.Id);
+    }
+
+    CharacterDatabase.PExecute(
+        "INSERT INTO mitica_corrida (corrida_id, cm_id, map_id, nivel, afijos, instancia, lider, miembros, estado) "
+        "VALUES ({}, {}, {}, {}, '{}', {}, {}, '{}', '{}')",
+        corrida.Id, corrida.CmId, corrida.MapId, corrida.NivelKeystone, corrida.Afijos, corrida.Instancia,
+        corrida.Lider.GetCounter(), miembros, prueba ? "prueba" : "en_curso");
+
+    _corridas[corrida.Id] = corrida;
+
+    // Escalado por nivel: se aplica a lo que ya esta cargado en la instancia (vida y dano)
+    EscalarPorNivel(mapa, corrida);
+
+    TC_LOG_INFO("scripts.miticas", "corrida {} ARRANCADA: {} (cm {}, mapa {}, instancia {}) nivel {} por {} "
+        "con {} miembro(s){}", corrida.Id, estancia->Nombre, corrida.CmId, corrida.MapId,
+        corrida.Instancia, corrida.NivelKeystone, lider->GetName(),
+        uint32(corrida.Miembros.size()), prueba ? " [PRUEBA]" : "");
+
+    // Avisos por texto propio (plantillas de mitica_config: se cambian sin recompilar)
+    AvisarAlGrupo(corrida, Plantilla("aviso_arranque", corrida));
+    AvisarAlGrupo(corrida, Plantilla("aviso_tiempos", corrida));
+
+    // Y el paquete del HUD, armado desde la base (formato en reconstruccion), mas el campo de update
+    // del temporizador. Va a TODO el grupo: el HUD es de cada jugador. Los dos paquetes de MYTHIC_PLUS
+    // son los que le avisan al cliente que la temporada esta viva (si no, puede ocultar la UI entera).
+    for (ObjectGuid const& guid : corrida.Miembros)
+        if (Player* miembro = ObjectAccessor::FindConnectedPlayer(guid))
+        {
+            EnviarPaquete(miembro, corrida, "SMSG_MYTHIC_PLUS_SEASON_DATA");
+            EnviarPaquete(miembro, corrida, "SMSG_MYTHIC_PLUS_CURRENT_AFFIXES");
+            EnviarPaquete(miembro, corrida, "SMSG_CHALLENGE_MODE_START");
+            MarcarDesafio(miembro, corrida, true);
+        }
+
+    motivo.clear();
+    return true;
+}
+
+Corrida* Mgr::GetCorridaDe(Player const* jugador)
+{
+    for (auto& [id, corrida] : _corridas)
+        for (ObjectGuid const& guid : corrida.Miembros)
+            if (guid == jugador->GetGUID())
+                return &corrida;
+    return nullptr;
+}
+
+Corrida* Mgr::GetCorridaPorInstancia(uint32 mapId, uint32 instancia)
+{
+    for (auto& [id, corrida] : _corridas)
+        if (corrida.MapId == mapId && corrida.Instancia == instancia)
+            return &corrida;
+    return nullptr;
+}
+
+void Mgr::AgregarMuerte(Player* jugador)
+{
+    Corrida* corrida = GetCorridaDe(jugador);
+    if (!corrida)
+        return;
+
+    ++corrida->Muertes;
+    CharacterDatabase.PExecute("UPDATE mitica_corrida SET muertes = {} WHERE corrida_id = {}",
+        corrida->Muertes, corrida->Id);
+
+    AvisarAlGrupo(*corrida, Plantilla("aviso_muerte", *corrida));
+    EnviarPaquete(jugador, *corrida, "SMSG_CHALLENGE_MODE_UPDATE_DEATH_COUNT");
+}
+
+void Mgr::AgregarFuerzas(Player* jugador, float pct)
+{
+    Corrida* corrida = GetCorridaDe(jugador);
+    if (!corrida || pct <= 0.0f)
+        return;
+
+    corrida->Fuerzas += pct;
+    if (corrida->Fuerzas > 100.0f)
+        corrida->Fuerzas = 100.0f;
+
+    CharacterDatabase.PExecute("UPDATE mitica_corrida SET fuerzas = {} WHERE corrida_id = {}",
+        corrida->Fuerzas, corrida->Id);
+
+    Estancia const* estancia = GetEstancia(corrida->CmId);
+    if (estancia && corrida->Fuerzas >= float(estancia->FuerzasMin))
+        AvisarAlGrupo(*corrida, Plantilla("aviso_fuerzas", *corrida));
+}
+
+std::string Mgr::Medalla(Corrida const& corrida) const
+{
+    Estancia const* estancia = GetEstancia(corrida.CmId);
+    if (!estancia)
+        return "ninguna";
+
+    uint32 tiempo = corrida.SegundosTranscurridos();
+    if (estancia->TiempoOro && tiempo <= estancia->TiempoOro)
+        return "oro";
+    if (estancia->TiempoPlata && tiempo <= estancia->TiempoPlata)
+        return "plata";
+    if (estancia->TiempoBronce && tiempo <= estancia->TiempoBronce)
+        return "bronce";
+    return "ninguna";
+}
+
+// ---------------------------------------------------------------------------
+// Escalado y fuerzas (Fase 1)
+// ---------------------------------------------------------------------------
+// Aplica vida_pct/dano_pct del nivel a las criaturas que YA estan en la instancia (las que spawnean
+// despues, por evento o respawn, todavia no se escalan: esta anotado como pendiente).
+void Mgr::EscalarPorNivel(Map* mapa, Corrida const& corrida) const
+{
+    if (!mapa || ConfigNumero("escalado_vida", 1) == 0)
+        return;
+
+    Nivel const* nivel = GetNivel(corrida.NivelKeystone);
+    if (!nivel)
+        return;
+
+    float factorVida = nivel->VidaPct / 100.0f;
+    float factorDano = nivel->DanoPct / 100.0f;
+    float factorVidaJefe = nivel->JefeVidaPct / 100.0f;
+    float factorDanoJefe = nivel->JefeDanoPct / 100.0f;
+
+    // Paso previo: subir el contenido al nivel del grupo. Las mazmorras de expansiones viejas
+    // traen a sus criaturas en el nivel de esa expansion (p.ej. BfA = 50), asi que una corrida
+    // con personajes del nivel actual se sentiria trivial. Se sube el nivel de cada criatura al
+    // del miembro mas alto del grupo y el core recalcula vida, dano, mana y armadura por nivel.
+    uint8 nivelGrupo = 0;
+    if (ConfigNumero("subir_nivel_grupo", 1) != 0)
+        for (auto const& ref : mapa->GetPlayers())
+            if (Player* jugador = ref.GetSource())
+                if (jugador->GetLevel() > nivelGrupo)
+                    nivelGrupo = jugador->GetLevel();
+
+    // Afijos ESTATICOS de esta corrida: los que son un multiplicador y no un hechizo. Tiránico pega en
+    // los jefes y Reforzado en la chusma; los numeros son NUESTROS y viven en `mitica_afijo.parametros`
+    // ("objetivo=jefes|basura;vida=N;dano=N"), asi que se ajustan sin recompilar. Un afijo sin
+    // `parametros` NO se aplica: no se adivina.
+    float afijoVidaJefe = 1.0f, afijoDanoJefe = 1.0f, afijoVidaBasura = 1.0f, afijoDanoBasura = 1.0f;
+    std::string afijosAplicados;
+
+    for (uint32 afijoId : ListaDeIds(corrida.Afijos))
+    {
+        auto itr = _afijos.find(afijoId);
+        if (itr == _afijos.end() || !itr->second.Activo || itr->second.Implementacion != "estatico")
+            continue;
+
+        std::string const& texto = itr->second.Parametros;
+        float vidaPct = 0.0f, danoPct = 0.0f;
+        if (size_t pos = texto.find("vida="); pos != std::string::npos)
+            vidaPct = float(strtod(texto.c_str() + pos + 5, nullptr));
+        if (size_t pos = texto.find("dano="); pos != std::string::npos)
+            danoPct = float(strtod(texto.c_str() + pos + 5, nullptr));
+
+        bool aJefes = texto.find("objetivo=jefes") != std::string::npos;
+        bool aChusma = texto.find("objetivo=basura") != std::string::npos;
+        if (!aJefes && !aChusma)
+            continue;
+
+        if (aJefes)
+        {
+            afijoVidaJefe *= 1.0f + vidaPct / 100.0f;
+            afijoDanoJefe *= 1.0f + danoPct / 100.0f;
+        }
+        if (aChusma)
+        {
+            afijoVidaBasura *= 1.0f + vidaPct / 100.0f;
+            afijoDanoBasura *= 1.0f + danoPct / 100.0f;
+        }
+
+        if (!afijosAplicados.empty())
+            afijosAplicados += ", ";
+        afijosAplicados += Trinity::StringFormat("{} (vida {}%, dano {}%, {})", itr->second.Nombre,
+            uint32(vidaPct), uint32(danoPct), aJefes ? "jefes" : "chusma");
+    }
+
+    if (!afijosAplicados.empty())
+        TC_LOG_INFO("scripts.miticas", "afijos estaticos de la estancia {}: {}", corrida.CmId, afijosAplicados);
+
+    uint32 escaladas = 0;
+    uint32 subidas = 0;
+    uint32 rotuladas = 0;
+    for (auto const& [spawnId, criatura] : mapa->GetCreatureBySpawnIdStore())
+    {
+        if (!criatura || !criatura->IsAlive())
+            continue;
+
+        // Solo los enemigos de la mazmorra: ni mascotas/invocaciones de jugadores, ni critters, ni
+        // la gente amiga del campamento (escalarlos romperia el contenido de la instancia).
+        if (criatura->IsCritter() || criatura->IsSummon() || criatura->IsPet() || criatura->IsGuardian()
+            || !criatura->GetCharmerOrOwnerGUID().IsEmpty() || !criatura->IsHostileToPlayers())
+            continue;
+
+        if (nivelGrupo && criatura->GetLevel() != nivelGrupo)
+        {
+            criatura->SetLevel(nivelGrupo);
+            criatura->UpdateLevelDependantStats();
+            ++subidas;
+        }
+
+        // El nivel que el cliente ROTULA la criatura no sale de UNIT_FIELD_LEVEL sino del escalado del
+        // contenido (clamp(nivelDelJugador, ScalingLevelMin, ScalingLevelMax) + ScalingLevelDelta), y el
+        // ContentTuning de una expansion vieja topa en su propio nivel (BfA = 50). Sin esta linea el
+        // servidor tiene al bicho en 90 y el jugador lo sigue leyendo en 50.
+        if (nivelGrupo)
+        {
+            criatura->SetScaledDisplayLevel(nivelGrupo);
+            ++rotuladas;
+        }
+
+        bool jefe = criatura->IsDungeonBoss();
+        float vida = factorVida * (jefe ? factorVidaJefe : 1.0f) * (jefe ? afijoVidaJefe : afijoVidaBasura);
+        float dano = factorDano * (jefe ? factorDanoJefe : 1.0f) * (jefe ? afijoDanoJefe : afijoDanoBasura);
+
+        uint64 vidaMaxima = uint64(double(criatura->GetMaxHealth()) * vida);
+        criatura->SetMaxHealth(vidaMaxima);
+        criatura->SetHealth(vidaMaxima);
+
+        for (WeaponAttackType tipo : { BASE_ATTACK, OFF_ATTACK, RANGED_ATTACK })
+        {
+            criatura->SetBaseWeaponDamage(tipo, MINDAMAGE, criatura->GetWeaponDamageRange(tipo, MINDAMAGE) * dano);
+            criatura->SetBaseWeaponDamage(tipo, MAXDAMAGE, criatura->GetWeaponDamageRange(tipo, MAXDAMAGE) * dano);
+            criatura->UpdateDamagePhysical(tipo);
+        }
+        ++escaladas;
+    }
+
+    TC_LOG_INFO("scripts.miticas", "escalado del nivel {} aplicado a {} criaturas (vida x{:.2f}, dano x{:.2f}); {} criaturas subidas al nivel {} del grupo y {} con el nivel del cliente ajustado",
+        corrida.NivelKeystone, escaladas, factorVida, factorDano, subidas, uint32(nivelGrupo), rotuladas);
+}
+
+// Fuerzas que aporta una criatura al morir: primero la tabla por criatura, si no la regla por
+// clasificacion (todo configurable en mitica_config).
+float Mgr::FuerzasDeCriatura(Creature* criatura, Corrida const* corrida) const
+{
+    if (!criatura)
+        return 0.0f;
+
+    if (QueryResult explicito = WorldDatabase.PQuery(
+            "SELECT pct FROM mitica_fuerzas WHERE entry = {}", criatura->GetEntry()))
+        return explicito->Fetch()[0].GetFloat();
+
+    // El jefe final declarado no aporta fuerzas (en retail los jefes no cuentan para el % de fuerzas).
+    // OJO: NO se puede confiar en IsDungeonBoss() para esto: la TDB no marca como jefe a NINGUNA
+    // criatura de estas mazmorras (flags_extra = 0 en las 3.264 spawneadas de las 8 estancias), asi
+    // que el unico dato confiable es el que declaramos en mitica_estancia.jefe_final.
+    Estancia const* estancia = corrida ? GetEstancia(corrida->CmId) : nullptr;
+    if (EsJefeFinal(estancia, criatura->GetEntry()))
+        return 0.0f;
+
+    if (criatura->IsDungeonBoss())
+        return 0.0f;
+
+    // Regla por clasificacion: es lo que promete el DDL de `mitica_fuerzas` ("lo no listado usa la regla
+    // por clasificacion") y lo que estaban declarando sin efecto las claves `fuerzas_elite`, `fuerzas_rare`
+    // y `fuerzas_rareelite` de `mitica_config`: hasta ahora TODO lo que no era jefe aportaba
+    // `fuerzas_normal` (1), asi que una elite aportaba lo mismo que un mob suelto.
+    // Ojo: no existe una clasificacion "jefe" en este enum (Normal/Elite/RareElite/Obsolete/Rare/...): los
+    // jefes de estas mazmorras no se pueden distinguir por clasificacion, y es por eso que los jefes van
+    // declarados a mano en `mitica_fuerzas` con pct = 0.
+    switch (criatura->GetCreatureClassification())
+    {
+        case CreatureClassifications::RareElite: return float(ConfigNumero("fuerzas_rareelite", 3));
+        case CreatureClassifications::Rare:      return float(ConfigNumero("fuerzas_rare", 2));
+        case CreatureClassifications::Elite:     return float(ConfigNumero("fuerzas_elite", 2));
+        default:                                 return float(ConfigNumero("fuerzas_normal", 1));
+    }
+}
+
+bool Mgr::Cerrar(Corrida& corrida, bool fueraDeTiempo, std::string& motivo)
+{
+    uint32 tiempo = corrida.SegundosTranscurridos();
+    std::string medalla = fueraDeTiempo ? "ninguna" : Medalla(corrida);
+    char const* estado = fueraDeTiempo ? "fuera_de_tiempo" : "completada";
+
+    GuardarCorrida(corrida, estado, medalla.c_str(), tiempo);
+
+    AvisarAlGrupo(corrida, Plantilla("aviso_cierre", corrida,
+        { { "tiempo", Trinity::StringFormat("{} min {} s", tiempo / 60, tiempo % 60) },
+          { "medalla", medalla } }));
+
+    // El puntaje de la corrida. Retail usa una formula propia (base por calabozo, escalado por nivel,
+    // bono por tiempo y penalizacion por muertes, comparada contra la mejor corrida de ese calabozo).
+    // Aca va UNA formula nuestra, simple y explicita, con todas las constantes en `mitica_config` para
+    // ajustarla sin recompilar:  base + nivel x por_nivel + bono de medalla - muertes x por_muerte.
+    corrida.Puntos = CalcularPuntos(corrida, medalla);
+
+    // El paquete de cierre va a TODO el grupo (antes iba solo a quien lo disparaba), y con el se quita
+    // el campo del temporizador: si queda marcado, el cliente cree que la mítica+ sigue corriendo.
+    for (ObjectGuid const& guid : corrida.Miembros)
+        if (Player* miembro = ObjectAccessor::FindConnectedPlayer(guid))
+        {
+            EnviarPaquete(miembro, corrida, "SMSG_CHALLENGE_MODE_COMPLETE");
+            MarcarDesafio(miembro, corrida, false);
+        }
+
+    TC_LOG_INFO("scripts.miticas", "corrida {} CERRADA: {} nivel {} en {} s (medalla {}, {} muertes, fuerzas {:.1f}%, {} puntos)",
+        corrida.Id, GetEstancia(corrida.CmId) ? GetEstancia(corrida.CmId)->Nombre : "?",
+        corrida.NivelKeystone, tiempo, medalla, corrida.Muertes, corrida.Fuerzas, corrida.Puntos);
+
+    // El NPC de salida: aparece junto al lider para que el grupo pueda volver a la ciudad sin
+    // caminar toda la mazmorra. El destino sale de `salida_punto` (el trigger de salida del cliente).
+    if (Estancia const* estancia = GetEstancia(corrida.CmId))
+    {
+        if (estancia->SalidaNpc)
+        {
+            Map* mapa = sMapMgr->FindMap(corrida.MapId, corrida.Instancia);
+            Player* lider = ObjectAccessor::FindConnectedPlayer(corrida.Lider);
+            if (mapa && lider)
+            {
+                Position pos(lider->GetPositionX(), lider->GetPositionY(), lider->GetPositionZ(), lider->GetOrientation());
+                if (TempSummon* guia = mapa->SummonCreature(estancia->SalidaNpc, pos))
+                {
+                    guia->SetFaction(35);
+                    TC_LOG_INFO("scripts.miticas", "corrida {}: aparecio el guia de salida (entry {}) junto al lider en {}",
+                        corrida.Id, estancia->SalidaNpc, estancia->Nombre);
+                }
+                else
+                    TC_LOG_ERROR("scripts.miticas", "corrida {}: no se pudo invocar el guia de salida {}", corrida.Id, estancia->SalidaNpc);
+            }
+        }
+    }
+
+    // La piedra vuelve a quien la puso, y sube de nivel si la medalla fue oro y la config lo pide.
+    DevolverPiedra(corrida, corrida.NivelKeystone,
+        medalla == "oro" && ConfigNumero("piedra_sube_con_oro", 1) != 0);
+
+    // El cofre de recompensa: aparece junto al grupo al cerrar. El botin lo entrega nuestra IA cuando
+    // el jugador le hace clic (el core no tiene logica para el tipo 51; el objeto pasa a goober).
+    if (uint32 cofreGo = ConfigNumero("cofre_go", 0))
+    {
+        Map* mapa = sMapMgr->FindMap(corrida.MapId, corrida.Instancia);
+        Player* lider = ObjectAccessor::FindConnectedPlayer(corrida.Lider);
+        if (mapa && lider)
+        {
+            Position pos(lider->GetPositionX(), lider->GetPositionY(), lider->GetPositionZ(), lider->GetOrientation());
+            // Ojo con el tiempo: `SummonGameObject` hace `SetRespawnTime(respawnTime)`, y con 0 el
+            // objeto queda con el respawn vencido y desaparece en el tick siguiente. Una hora alcanza:
+            // la instancia se descarga mucho antes y el objeto no se guarda en la base.
+            if (GameObject* cofre = lider->SummonGameObject(cofreGo, pos, QuaternionData(), Seconds(3600),
+                    GO_SUMMON_TIMED_DESPAWN))
+                TC_LOG_INFO("scripts.miticas", "corrida {}: aparecio el cofre de recompensa ({}) con el grupo", corrida.Id, cofreGo);
+            else
+                TC_LOG_ERROR("scripts.miticas", "corrida {}: no se pudo invocar el cofre {}", corrida.Id, cofreGo);
+        }
+    }
+
+    // NO se borra: el cofre y el guia de salida siguen vivos despues del cierre y necesitan esta
+    // corrida (de aca sale el nivel de la piedra con el que se escalona el botin).
+    corrida.Cerrada = true;
+    motivo.clear();
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// Cierre por jefes: NO depende de quien mato al jefe
+// ---------------------------------------------------------------------------
+// El gancho de TrinityCore (PlayerScript::OnCreatureKill) solo se dispara cuando la muerte se le
+// puede atribuir a un jugador. Una muerte por comando de GM (`.die`), por una trampa del entorno o
+// por un tercero no pasa por ahi, y la corrida se quedaba abierta aunque el jefe estuviera muerto
+// (visto en vivo: fuerzas al 100 %, Yazma muerto con .die y la corrida sin cerrar). Por eso el
+// cierre se decide MIRANDO la instancia, no el evento.
+uint32 Mgr::JefesVivos(Map* mapa, Estancia const* estancia) const
+{
+    if (!mapa)
+        return 0;
+
+    std::vector<uint32> declarados = estancia ? ListaDeIds(estancia->JefeFinal) : std::vector<uint32>();
+    uint32 vivos = 0;
+    for (auto const& [spawnId, criatura] : mapa->GetCreatureBySpawnIdStore())
+    {
+        if (!criatura)
+            continue;
+
+        // Con jefe_final declarado manda esa lista (un encuentro puede ser de varias criaturas);
+        // sin el, cualquier jefe de la mazmorra marcado como tal vale.
+        bool cuenta = declarados.empty() ? criatura->IsDungeonBoss() : EsJefeFinal(estancia, criatura->GetEntry());
+        if (!cuenta)
+            continue;
+
+        if (criatura->IsAlive())
+            ++vivos;
+    }
+    return vivos;
+}
+
+bool Mgr::EsJefeFinal(Estancia const* estancia, uint32 entry) const
+{
+    if (!estancia || estancia->JefeFinal.empty())
+        return false;
+
+    for (uint32 declarado : ListaDeIds(estancia->JefeFinal))
+        if (declarado == entry)
+            return true;
+
+    return false;
+}
+
+void Mgr::Vigilar()
+{
+    if (!_configCargada || _corridas.empty() || ConfigNumero("cierre_por_jefes", 1) == 0)
+        return;
+
+    std::vector<uint64> cerrar;
+    for (auto& [id, corrida] : _corridas)
+    {
+        if (corrida.Cerrada)
+            continue;   // ya cerro: el cofre y el guia siguen vivos, pero no hay nada mas que vigilar
+
+        Map* mapa = sMapMgr->FindMap(corrida.MapId, corrida.Instancia);
+        if (!mapa)
+            continue;   // la instancia no esta cargada: no hay jefes que mirar
+
+        // Red de seguridad del recorrido: si el lider se quedo parado al lado de una reja cerrada,
+        // se abre (es lo unico que garantiza que la corrida no se trabe por un dato que falte).
+        if (VigilarRecorrido(corrida, mapa))
+            TC_LOG_INFO("scripts.miticas", "recorrido: la corrida {} lleva {} objeto(s) abiertos por el vigilante",
+                corrida.Id, corrida.TrabasAbiertas);
+
+        // Camino central (como retail): cuando mueren los jefes de antes se abre el paso al jefe
+        // final. Abrir esa puerta dispara el movimiento de la escalera: esa es la "cinematica".
+        if (AbrirCaminoCentral(corrida, mapa))
+            TC_LOG_INFO("scripts.miticas", "camino central abierto en la corrida {}", corrida.Id);
+
+        Estancia const* estancia = GetEstancia(corrida.CmId);
+
+        // "Fuerzas completas" no cierra la corrida en retail: habilita el jefe final. Se avisa una
+        // sola vez y se dice que falta, que es la duda que quedaba en la prueba en vivo.
+        if (estancia && !corrida.AvisoFuerzas && corrida.Fuerzas >= float(estancia->FuerzasMin))
+        {
+            corrida.AvisoFuerzas = true;
+            AvisarAlGrupo(corrida, Plantilla("aviso_fuerzas_falta", corrida));
+        }
+
+        uint32 vivos = JefesVivos(mapa, estancia);
+        if (vivos)
+        {
+            corrida.JefesVistos = true;
+            continue;
+        }
+
+        if (corrida.JefesVistos)
+            cerrar.push_back(id);
+    }
+
+    for (uint64 id : cerrar)
+    {
+        auto itr = _corridas.find(id);
+        if (itr == _corridas.end())
+            continue;
+
+        std::string motivo;
+        if (Cerrar(itr->second, false, motivo))
+            TC_LOG_INFO("scripts.miticas", "corrida {} cerrada por la vigilancia: no queda ningun jefe vivo en la instancia", id);
+        else
+            TC_LOG_ERROR("scripts.miticas", "la corrida {} no se pudo cerrar: {}", id, motivo);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Red de seguridad del recorrido
+// ---------------------------------------------------------------------------
+namespace
+{
+    // Tipos de gameobject que pueden TRABAR el paso. Los demas (palancas `GOOBER`, focos de hechizo,
+    // cofres) son mecanica del encuentro: abrirlos a lo bruto cambiaria la pelea, asi que no se tocan.
+    bool EsObjetoDePaso(GameObject const* objeto)
+    {
+        if (!objeto)
+            return false;
+
+        GameobjectTypes tipo = objeto->GetGoType();
+        return tipo == GAMEOBJECT_TYPE_DOOR || tipo == GAMEOBJECT_TYPE_DESTRUCTIBLE_BUILDING;
+    }
+
+    // Esta cerrado? Para una puerta, `GO_STATE_READY` = cerrada; para un muro destructible, intacto.
+    bool EstaCerrado(GameObject const* objeto)
+    {
+        if (!objeto)
+            return false;
+
+        if (objeto->GetGoType() == GAMEOBJECT_TYPE_DOOR)
+            return objeto->GetGoState() == GO_STATE_READY;
+
+        return objeto->GetDestructibleState() == GO_DESTRUCTIBLE_INTACT;
+    }
+
+    // Abre el paso con el MISMO camino que usa un jugador (para la puerta) o lo da por destruido.
+    void AbrirPaso(GameObject* objeto)
+    {
+        if (objeto->GetGoType() == GAMEOBJECT_TYPE_DOOR)
+            objeto->UseDoorOrButton();
+        else
+            objeto->SetDestructibleState(GO_DESTRUCTIBLE_DESTROYED);
+    }
+
+    std::string NombreObjeto(GameObject const* objeto, uint32 spawnId)
+    {
+        return Trinity::StringFormat("{} (spawnId {})", objeto->GetName(), spawnId);
+    }
+
+    float Distancia(float ax, float ay, float az, float bx, float by, float bz)
+    {
+        float dx = ax - bx;
+        float dy = ay - by;
+        float dz = az - bz;
+        return std::sqrt(dx * dx + dy * dy + dz * dz);
+    }
+}
+
+uint32 Mgr::ContarTrabas(Map* mapa, std::string& detalle) const
+{
+    detalle.clear();
+    if (!mapa)
+        return 0;
+
+    uint32 cerrados = 0;
+    for (auto const& [spawnId, objeto] : mapa->GetGameObjectBySpawnIdStore())
+    {
+        if (!EsObjetoDePaso(objeto) || !EstaCerrado(objeto))
+            continue;
+
+        ++cerrados;
+        if (cerrados > 1)
+            detalle += ", ";
+        detalle += NombreObjeto(objeto, spawnId);
+    }
+    return cerrados;
+}
+
+uint32 Mgr::Destrabar(Map* mapa, std::string& detalle) const
+{
+    detalle.clear();
+    if (!mapa)
+        return 0;
+
+    uint32 abiertos = 0;
+    for (auto const& [spawnId, objeto] : mapa->GetGameObjectBySpawnIdStore())
+    {
+        if (!EsObjetoDePaso(objeto) || !EstaCerrado(objeto))
+            continue;
+
+        AbrirPaso(objeto);
+        ++abiertos;
+        if (abiertos > 1)
+            detalle += ", ";
+        detalle += NombreObjeto(objeto, spawnId);
+        TC_LOG_INFO("scripts.miticas", "recorrido: destrabado {} en el mapa {}", NombreObjeto(objeto, spawnId), mapa->GetId());
+    }
+
+    // El destrabar manual es la ULTIMA salida: ademas de las puertas, saca las paredes de colision
+    // declaradas para ese mapa (gameobjects genericos, tipo 5, que el resto de la red no toca).
+    for (Estancia const& estancia : _estancias)
+    {
+        if (estancia.MapId != mapa->GetId() || estancia.CaminoQuitar.empty())
+            continue;
+
+        std::string paredes;
+        if (uint32 quitadas = QuitarParedes(mapa, ListaDeIds(estancia.CaminoQuitar), paredes))
+        {
+            abiertos += quitadas;
+            if (!detalle.empty())
+                detalle += ", ";
+            detalle += "pared(es) de colision: " + paredes;
+        }
+    }
+
+    return abiertos;
+}
+
+// --- camino central (como retail) ---------------------------------------------------------------
+// El paso al jefe final se abre cuando mueren los jefes declarados en la estancia (`camino_jefes`),
+// igual que en retail. Abrir la puerta dispara la animacion propia del objeto -- eso ES la
+// "cinematica" del pasillo (el movimiento de la escalera): no hay ninguna pelicula que mandar.
+uint32 Mgr::JefesVivosDeLista(Map* mapa, std::vector<uint32> const& entries) const
+{
+    if (!mapa || entries.empty())
+        return 0;
+
+    uint32 vivos = 0;
+    for (auto const& [spawnId, criatura] : mapa->GetCreatureBySpawnIdStore())
+    {
+        if (!criatura || !criatura->IsAlive())
+            continue;
+
+        for (uint32 entry : entries)
+        {
+            if (criatura->GetEntry() == entry)
+            {
+                ++vivos;
+                break;
+            }
+        }
+    }
+    return vivos;
+}
+
+uint32 Mgr::QuitarParedes(Map* mapa, std::vector<uint32> const& spawnIds, std::string& detalle) const
+{
+    detalle.clear();
+    if (!mapa || spawnIds.empty())
+        return 0;
+
+    uint32 quitados = 0;
+    auto const& objetos = mapa->GetGameObjectBySpawnIdStore();
+    for (uint32 spawnId : spawnIds)
+    {
+        auto itr = objetos.find(spawnId);
+        if (itr == objetos.end() || !itr->second)
+            continue;
+
+        GameObject* objeto = itr->second;
+        if (quitados)
+            detalle += ", ";
+        detalle += NombreObjeto(objeto, spawnId);
+        TC_LOG_INFO("scripts.miticas", "camino central: despenzado {} en el mapa {}",
+            NombreObjeto(objeto, spawnId), mapa->GetId());
+        objeto->Delete();
+        ++quitados;
+    }
+    return quitados;
+}
+
+bool Mgr::AbrirCaminoCentral(Corrida& corrida, Map* mapa)
+{
+    if (!mapa || corrida.CaminoAbierto || ConfigNumero("camino_central", 1) == 0)
+        return false;
+
+    Estancia const* estancia = GetEstancia(corrida.CmId);
+    if (!estancia || !estancia->CaminoGo)
+        return false;
+
+    std::vector<uint32> jefes = ListaDeIds(estancia->CaminoJefes);
+    if (jefes.empty())
+        return false;
+
+    if (JefesVivosDeLista(mapa, jefes) > 0)
+    {
+        corrida.CaminoVistos = true;
+        return false;
+    }
+
+    // La instancia acaba de cargar y todavia no se vio a ninguno vivo: no se adelanta el diseño.
+    if (!corrida.CaminoVistos)
+        return false;
+
+    // Las paredes de colision del paso (gameobjects genericos tipo 5) no las toca ni el vigilante ni
+    // `.mitica destrabar` salvo que esten declaradas: se despenzan ACA, cuando el camino al jefe final
+    // queda efectivamente abierto. OJO: va ANTES del `return` del objeto ya abierto -- la escalera de
+    // Atal'Dazar arranca abierta (`state = 1`), asi que aquel return se iba sin quitar la pared y la
+    // corrida terminaba trabada contra una pared invisible con la escalera abierta (visto en vivo).
+    std::string paredes;
+    uint32 quitadas = QuitarParedes(mapa, ListaDeIds(estancia->CaminoQuitar), paredes);
+    if (quitadas)
+        TC_LOG_INFO("scripts.miticas", "camino central: {} pared(es) de colision despenzadas: {}",
+            quitadas, paredes);
+
+    auto itr = mapa->GetGameObjectBySpawnIdStore().find(estancia->CaminoGo);
+    if (itr == mapa->GetGameObjectBySpawnIdStore().end() || !itr->second)
+    {
+        TC_LOG_ERROR("scripts.miticas", "camino central: la corrida {} no encuentra el objeto {} en el mapa {}",
+            corrida.Id, estancia->CaminoGo, mapa->GetId());
+        return quitadas > 0;
+    }
+
+    GameObject* objeto = itr->second;
+    if (!EstaCerrado(objeto))
+    {
+        corrida.CaminoAbierto = true;   // ya estaba abierto: lo dejo anotado y no repito
+        if (quitadas)
+        {
+            std::string texto = Plantilla("aviso_camino", corrida);
+            if (!texto.empty() && texto != "aviso_camino")
+                AvisarAlGrupo(corrida, texto);
+        }
+        return quitadas > 0;
+    }
+
+    AbrirPaso(objeto);
+    corrida.CaminoAbierto = true;
+    TC_LOG_INFO("scripts.miticas", "camino central: la corrida {} abrio {} (spawnId {}) al morir los jefes [{}]",
+        corrida.Id, objeto->GetName(), estancia->CaminoGo, estancia->CaminoJefes);
+
+    std::string texto = Plantilla("aviso_camino", corrida);
+    if (!texto.empty() && texto != "aviso_camino")
+        AvisarAlGrupo(corrida, texto);
+
+    return true;
+}
+
+uint32 Mgr::VigilarRecorrido(Corrida& corrida, Map* mapa)
+{
+    if (!mapa || ConfigNumero("recorrido_vigilar", 1) == 0)
+        return 0;
+
+    Player* lider = ObjectAccessor::FindConnectedPlayer(corrida.Lider);
+    if (!lider || lider->GetMap() != mapa)
+        return 0;
+
+    uint32 cada = ConfigNumero("vigilancia_seg", 5);
+    if (!cada)
+        cada = 5;
+
+    float x = lider->GetPositionX();
+    float y = lider->GetPositionY();
+    float z = lider->GetPositionZ();
+
+    if (!corrida.PosicionInicial)
+    {
+        corrida.UltimaX = x;
+        corrida.UltimaY = y;
+        corrida.UltimaZ = z;
+        corrida.PosicionInicial = true;
+        return 0;
+    }
+
+    if (Distancia(x, y, z, corrida.UltimaX, corrida.UltimaY, corrida.UltimaZ) > 2.0f)
+    {
+        corrida.UltimaX = x;
+        corrida.UltimaY = y;
+        corrida.UltimaZ = z;
+        corrida.QuietoSeg = 0;
+        return 0;
+    }
+
+    corrida.QuietoSeg += cada;
+    uint32 quieto = corrida.QuietoSeg;
+    if (quieto < ConfigNumero("recorrido_quieto_seg", 20))
+        return 0;
+
+    corrida.QuietoSeg = 0;   // si sigue trabado, se vuelve a mirar en la proxima vuelta
+
+    float radio = float(ConfigNumero("recorrido_radio_yd", 10));
+    Estancia const* estancia = GetEstancia(corrida.CmId);
+    for (auto const& [spawnId, objeto] : mapa->GetGameObjectBySpawnIdStore())
+    {
+        if (!EsObjetoDePaso(objeto) || !EstaCerrado(objeto))
+            continue;
+
+        // El paso al jefe final lo abre el DISEÑO (AbrirCaminoCentral, cuando mueren los jefes de
+        // antes). Si el vigilante lo abriera solo, el jugador pasaria al jefe final sin pelear nada:
+        // mientras quede VIVO alguno de los jefes de `camino_jefes`, esa puerta es del diseño. Cuando
+        // ya no queda ninguno, la puerta deja de estar protegida y el vigilante tambien la puede abrir
+        // (es la red: si el diseño fallo -- objeto mal declarado, jefe que no muere -- la corrida no
+        // se traba igual).
+        if (estancia && estancia->CaminoGo && spawnId == estancia->CaminoGo)
+        {
+            std::vector<uint32> jefesCamino = ListaDeIds(estancia->CaminoJefes);
+            if (!jefesCamino.empty() && JefesVivosDeLista(mapa, jefesCamino) > 0)
+                continue;
+        }
+
+        float d = Distancia(x, y, z, objeto->GetPositionX(), objeto->GetPositionY(), objeto->GetPositionZ());
+        if (d > radio)
+            continue;
+
+        AbrirPaso(objeto);
+        ++corrida.TrabasAbiertas;
+        TC_LOG_INFO("scripts.miticas",
+            "recorrido: la corrida {} estuvo {} s parada a {:.1f} yd de {}; el vigilante la abrio (lleva {})",
+            corrida.Id, quieto, d, NombreObjeto(objeto, spawnId), corrida.TrabasAbiertas);
+
+        std::string texto = Plantilla("aviso_destrabado", corrida);
+        if (!texto.empty() && texto != "aviso_destrabado")
+            AvisarAlGrupo(corrida, texto);
+
+        return 1;
+    }
+
+    // Las paredes de colision declaradas (gameobjects genericos tipo 5) NO son objetos de paso para el
+    // vigilante, pero son las que mas traban (visto en vivo en Atal'Dazar: la escalera abierta y una
+    // pared invisible delante). Si el grupo queda parado al lado de una, se despenza igual que una
+    // puerta: es la misma red, un paso mas. El comando manual tambien las quita.
+    if (estancia && !estancia->CaminoQuitar.empty())
+    {
+        for (uint32 spawnId : ListaDeIds(estancia->CaminoQuitar))
+        {
+            auto itr = mapa->GetGameObjectBySpawnIdStore().find(spawnId);
+            if (itr == mapa->GetGameObjectBySpawnIdStore().end() || !itr->second)
+                continue;
+
+            GameObject* pared = itr->second;
+            float d = Distancia(x, y, z, pared->GetPositionX(), pared->GetPositionY(), pared->GetPositionZ());
+            if (d > radio)
+                continue;
+
+            std::string nombre = NombreObjeto(pared, spawnId);
+            pared->Delete();
+            ++corrida.TrabasAbiertas;
+            TC_LOG_INFO("scripts.miticas",
+                "recorrido: la corrida {} estuvo {} s parada a {:.1f} yd de una pared de colision {}; el vigilante la despenzo (lleva {})",
+                corrida.Id, quieto, d, nombre, corrida.TrabasAbiertas);
+
+            std::string texto = Plantilla("aviso_destrabado", corrida);
+            if (!texto.empty() && texto != "aviso_destrabado")
+                AvisarAlGrupo(corrida, texto);
+
+            return 1;
+        }
+    }
+
+    return 0;
+}
+
+// Punto de salida declarado para la estancia de ese mapa (formato "mapa x y z o"). Es el que usa el
+// NPC de salida; sale del propio trigger de salida del cliente, no de una invencion nuestra.
+bool Mgr::PuntoDeSalida(uint32 mapId, uint32& mapaDestino, float& x, float& y, float& z, float& o) const
+{
+    for (Estancia const& estancia : _estancias)
+    {
+        if (estancia.MapId != mapId || estancia.SalidaPunto.empty())
+            continue;
+
+        if (sscanf(estancia.SalidaPunto.c_str(), "%u %f %f %f %f", &mapaDestino, &x, &y, &z, &o) == 5 && mapaDestino)
+            return true;
+    }
+    return false;
+}
+
+// El puntaje de la corrida, con una formula NUESTRA (retail usa la suya y es bastante mas compleja:
+// compara contra la mejor corrida del calabozo, ajusta por el nivel del grupo, etc.). Importa que sea
+// explicita y ajustable: todas las constantes viven en `mitica_config`.
+uint32 Mgr::CalcularPuntos(Corrida const& corrida, std::string const& medalla) const
+{
+    uint32 base = uint32(ConfigNumero("puntos_base", 25));
+    uint32 porNivel = uint32(ConfigNumero("puntos_por_nivel", 12));
+    uint32 porMuerte = uint32(ConfigNumero("puntos_por_muerte", 3));
+
+    uint32 bono = 0;
+    if (medalla == "oro")
+        bono = uint32(ConfigNumero("puntos_oro", 15));
+    else if (medalla == "plata")
+        bono = uint32(ConfigNumero("puntos_plata", 8));
+    else if (medalla == "bronce")
+        bono = uint32(ConfigNumero("puntos_bronce", 0));
+
+    int64 puntos = int64(base) + int64(corrida.NivelKeystone) * int64(porNivel) + int64(bono)
+        - int64(corrida.Muertes) * int64(porMuerte);
+
+    return puntos > 0 ? uint32(puntos) : 0;
+}
+
+// El cofre de recompensa. Lo llama la IA del gameobject (go_cofre_mitica) cuando un jugador le hace
+// clic. Entrega UN item del botin de la estancia, escalado con el NIVEL DE LA PIEDRA de esa corrida:
+// el nivel no sale del DB2, sale del contexto + el nivel (`ItemBonusGenerationParams`), que es lo que
+// hace que el objeto no llegue "pelado" (mismo error que hacia `.send items` a nivel base).
+bool Mgr::AbrirCofre(Player* jugador)
+{
+    if (!jugador)
+        return false;
+
+    Corrida* corrida = nullptr;
+    for (auto& [id, c] : _corridas)
+        if (c.MapId == jugador->GetMapId() && (c.Instancia == 0 || c.Instancia == jugador->GetInstanceId()))
+        {
+            corrida = &c;
+            break;
+        }
+
+    // El cofre solo reparte despues del cierre: ahi ya se sabe la medalla, el tiempo y el nivel.
+    if (!corrida || !corrida->Cerrada)
+        return false;
+
+    if (std::find(corrida->CofreLooteado.begin(), corrida->CofreLooteado.end(), jugador->GetGUID()) != corrida->CofreLooteado.end())
+    {
+        jugador->GetSession()->SendNotification("Ya sacaste tu recompensa de esta corrida.");
+        return true;
+    }
+
+    Estancia const* estancia = GetEstancia(corrida->CmId);
+    if (!estancia || estancia->CofreItems.empty())
+    {
+        TC_LOG_ERROR("scripts.miticas", "cofre: la corrida {} no tiene botin declarado en mitica_cofre_item", corrida->Id);
+        jugador->GetSession()->SendNotification("Este cofre no tiene recompensa configurada.");
+        return true;
+    }
+
+    uint32 itemId = estancia->CofreItems[urand(0, uint32(estancia->CofreItems.size()) - 1)];
+    std::vector<int32> bonos = ItemBonusMgr::GetBonusListsForItem(itemId,
+        ItemBonusMgr::ItemBonusGenerationParams(ItemContext::MythicPlus_End_of_Run, int32(corrida->NivelKeystone)));
+
+    bool entregado = false;
+
+    // 1) a la mochila. StoreItem se lleva el item YA armado, asi que los bonus calculados con el nivel
+    //    de piedra viajan tal cual (StoreNewItem por id volveria a calcularlos sin el nivel).
+    ItemPosCountVec destino;
+    if (jugador->CanStoreNewItem(NULL_BAG, NULL_SLOT, destino, itemId, 1) == EQUIP_ERR_OK)
+    {
+        if (Item* nuevo = Item::CreateItem(itemId, 1, ItemContext::MythicPlus_End_of_Run, jugador, false))
+        {
+            nuevo->SetBonuses(bonos);
+            if (Item* guardado = jugador->StoreItem(destino, nuevo, true))
+            {
+                jugador->SendNewItem(guardado, 1, true, false);
+                entregado = true;
+            }
+            else
+                delete nuevo;
+        }
+    }
+
+    // 2) sin espacio: por correo, el mismo camino que `.mitica obsequio`.
+    if (!entregado)
+    {
+        if (Item* item = Item::CreateItem(itemId, 1, ItemContext::MythicPlus_End_of_Run, jugador, false))
+        {
+            item->SetBonuses(bonos);
+
+            CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+            MailSender remitente(MAIL_NORMAL, 0, MAIL_STATIONERY_GM);
+            MailDraft("Recompensa de la mitica+", "El cofre de la expedicion: lo que no entro en tus bolsas.")
+                .AddItem(item).SendMailTo(trans, MailReceiver(jugador), remitente);
+            CharacterDatabase.CommitTransaction(trans);
+
+            entregado = true;
+            TC_LOG_INFO("scripts.miticas", "cofre: a {} le fue por correo el item {} (sin espacio en las bolsas)",
+                jugador->GetName(), itemId);
+        }
+    }
+
+    if (entregado)
+    {
+        corrida->CofreLooteado.push_back(jugador->GetGUID());
+        TC_LOG_INFO("scripts.miticas", "cofre: {} saco el item {} (nivel de piedra {}) en la corrida {}",
+            jugador->GetName(), itemId, corrida->NivelKeystone, corrida->Id);
+    }
+
+    return entregado;
+}
