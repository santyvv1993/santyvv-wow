+    void Aviso(Player* jugador, std::string const& texto) const;
+
+    // Medalla segun los tiempos de la estancia (0 = ninguna).
+    std::string Medalla(Corrida const& corrida) const;
+
+private:
+    void GuardarCorrida(Corrida const& corrida, char const* estado, char const* medalla, uint32 tiempoSeg);
+    void AvisarAlGrupo(Corrida const& corrida, std::string const& texto) const;
+    std::string ResolverValor(std::string const& valor, Corrida const& corrida, Map const* mapa) const;
+
+    // Devuelve la piedra de la corrida al lider si esta conectado; si no, deja la corrida marcada
+    // para devolverla cuando entre (asi un reinicio no se come la piedra de nadie).
+    void DevolverPiedra(Corrida const& corrida, uint32 nivel, bool subir);
+    // Jefes de la instancia que siguen vivos (0 = la mazmorra esta terminada).
+    uint32 JefesVivos(Map* mapa, Estancia const* estancia) const;
+    // La criatura es parte del jefe final declarado por la estancia?
+    bool EsJefeFinal(Estancia const* estancia, uint32 entry) const;
+
+    std::unordered_map<std::string, std::string> _config;   // world.mitica_config
+    std::string _temporadaNombre = "Temporada";
+    std::vector<Estancia> _estancias;
+    std::unordered_map<uint32, Estancia> _porCmId;
+    std::unordered_map<uint32, Nivel> _niveles;
+    std::unordered_map<uint32, Afijo> _afijos;          // world.mitica_afijo (efecto de cada afijo)
+    std::unordered_map<uint64, Corrida> _corridas;      // por corrida_id
+    uint64 _siguienteId = 1;
+    bool _configCargada = false;
+};
+} // namespace MythicPlus
+} // namespace Trinity
