+++ b/src/server/scripts/Custom/miticas_custom.cpp
@@ -0,0 +1,622 @@
+/*
+ * ============================================================================
+ *  miticas_custom.cpp - Sistema de miticas+ propio: EL ENGANCHES DEL JUEGO
+ * ============================================================================
+ *
+ *  POR QUE EXISTE ESTE ARCHIVO
+ *  El core sabe crear el item 180653 (Piedra angular mitica) pero NO tiene forma
+ *  de decirle AL CLIENTE de que mazmorra es ni de que nivel. Ese dato viaja en
+ *  MODIFICADORES del item, que el servidor manda junto con el item
+ *  (ver ItemPacketsCommon.cpp:49, que los vuelca al paquete):
+ *
+ *      17 = ITEM_MODIFIER_CHALLENGE_MAP_CHALLENGE_MODE_ID    -> id de MapChallengeMode
+ *      18 = ITEM_MODIFIER_CHALLENGE_KEYSTONE_LEVEL           -> nivel de la piedra
+ *      19..22 = ITEM_MODIFIER_CHALLENGE_KEYSTONE_AFFIX_ID_1..4 (afijos)
+ *      (ItemDefines.h:242-248)
+ *
+ *  Verificado en vivo: con el item pelado (sin modificadores) el receptaculo del
+ *  calabozo contesta "es una piedra de otra mazmorra"; la lista de bonus del cliente
+ *  por si sola no alcanza.
+ *
+ *  QUE HACE ESTE ARCHIVO (las piezas de juego; el motor es MythicPlusMgr)
+ *   - Al ENTRAR al mundo: reaplica los modificadores a las piedras del inventario
+ *     (el core no los persiste), borra las filas que apuntan a items que ya no existen,
+ *     y devuelve la piedra de las corridas que cerraron sin poder darsela.
+ *   - Cada muerte del grupo suma al contador de la corrida; cada enemigo muerto aporta
+ *     fuerzas.
+ *   - La corrida se CIERRA por reloj de mundo (WorldScript::OnUpdate -> Mgr::Vigilar),
+ *     mirando si queda algun jefe vivo en la instancia. No depende del gancho del
+ *     asesino, asi que tambien cuenta la muerte por `.die`, por una trampa o por un
+ *     tercero.
+ *   - Los comandos de operacion: `.mitica piedra | estancias | estado | cerrar`.
+ * ============================================================================
+ */
+
+#include "Chat.h"
+#include "ChatCommand.h"
+#include "Cache/CharacterCache.h"
+#include "CreatureAI.h"
+#include "DatabaseEnv.h"
+#include "EscaladoEstanciaMgr.h"
+#include "GameObjectAI.h"
