+namespace WorldPackets
+{
+namespace ChallengeMode
+{
+// CMSG_START_CHALLENGE_MODE: el cliente lo manda cuando el lider inserta la piedra en el receptaculo.
+// El FORMATO esta medido a medias: los dos primeros bytes son la ubicacion de la piedra en las bolsas
+// (en vivo llego FF 24 = bolsa 255 = mochila, ranura 36) y los 13 bytes que siguen no estan
+// documentados. En vez de inventar campos se parsea lo que se sabe y el resto se guarda crudo, para
+// poder aprenderlo con datos.
+class StartChallengeMode final : public ClientPacket
+{
+public:
+    explicit StartChallengeMode(WorldPacket&& packet) : ClientPacket(CMSG_START_CHALLENGE_MODE, std::move(packet)) { }
+
+    void Read() override
+    {
+        _worldPacket >> Bolsa;
+        _worldPacket >> Ranura;
+
+        Crudo.reserve(_worldPacket.size() - _worldPacket.rpos());
+        while (_worldPacket.rpos() < _worldPacket.size())
+        {
+            uint8 byte = 0;
+            _worldPacket >> byte;
+            Crudo.push_back(byte);
+        }
+    }
+
+    uint8 Bolsa = 0;
+    uint8 Ranura = 0;
+    std::vector<uint8> Crudo;
+};
+
+// CMSG_REQUEST_MYTHIC_PLUS_SEASON_DATA: el cliente pide los datos de la temporada al abrir el panel
+// (y al entrar al mundo). El paquete viene VACIO - medido dos veces contra el servidor oficial
+// (19-sep y 21-sep 11:46:20, longitud 0) - y el oficial contesta SMSG_MYTHIC_PLUS_SEASON_DATA de UN
+// byte con `IsMythicPlusActive: True`. No hay nada que leer.
+class RequestMythicPlusSeasonData final : public ClientPacket
+{
+public:
+    explicit RequestMythicPlusSeasonData(WorldPacket&& packet) : ClientPacket(CMSG_REQUEST_MYTHIC_PLUS_SEASON_DATA, std::move(packet)) { }
+
+    void Read() override { }
+};
+} // namespace ChallengeMode
+} // namespace WorldPackets
+
+#endif // ChallengeModePackets_h__
diff --git a/src/server/scripts/Custom/miticas_custom.cpp b/src/server/scripts/Custom/miticas_custom.cpp
