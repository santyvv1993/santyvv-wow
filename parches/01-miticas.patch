+Map* Mgr::MapaDeEstancia(uint32 cmId) const
+{
+    for (auto const& [id, corrida] : _corridas)
+    {
+        if (corrida.CmId != cmId)
+            continue;
+
+        if (Map* mapa = sMapMgr->FindMap(corrida.MapId, corrida.Instancia))
+            return mapa;
+    }
+    return nullptr;
+}
+
+std::string Mgr::DiagnosticoRecorrido(Map* mapa, Estancia const* estancia,
+    float desdeX, float desdeY, float desdeZ) const
+{
+    if (!mapa)
+        return "No hay instancia cargada para esa estancia (nadie esta adentro ahora).";
+
+    std::string salida = Trinity::StringFormat("Recorrido de {} (mapa {}):\n",
+        estancia ? estancia->Nombre : "la instancia", mapa->GetId());
+
+    std::string detalle;
+    uint32 cerrados = ContarTrabas(mapa, detalle);
+    salida += Trinity::StringFormat("  objetos de paso CERRADOS: {}", cerrados);
+    salida += cerrados ? Trinity::StringFormat(" -> {}\n", detalle) : "\n";
+
+    float radio = float(ConfigNumero("traba_radio_yd", 6));
+
+    std::vector<uint32> jefes = estancia ? ListaDeIds(estancia->JefeFinal) : std::vector<uint32>();
+    if (jefes.empty())
+        salida += "  (la estancia no tiene jefe_final declarado: no hay destino que medir)\n";
+
+    for (uint32 entry : jefes)
+    {
+        Creature* jefe = nullptr;
+        for (auto const& [spawnId, criatura] : mapa->GetCreatureBySpawnIdStore())
+        {
+            if (criatura && criatura->GetEntry() == entry)
+            {
+                jefe = criatura;
+                break;
+            }
+        }
+
+        if (!jefe)
+        {
+            salida += Trinity::StringFormat("  jefe {}: NO esta en la instancia\n", entry);
+            continue;
+        }
+
+        // El generador de caminos se apoya en un objeto del mundo: da igual la direccion, asi que
+        // se usa al propio jefe y se calcula el camino hasta el punto de partida.
+        PathGenerator camino(jefe);
+        if (!camino.CalculatePath(desdeX, desdeY, desdeZ, false))
+        {
+            salida += Trinity::StringFormat("  jefe {} ({}): el generador NO encontro ruta (tipo {})\n",
+                entry, jefe->GetName(), uint32(camino.GetPathType()));
+            continue;
+        }
+
+        auto const& puntos = camino.GetPath();
+        uint32 trabas = 0;
+        std::string cuales;
+        for (auto const& [spawnId, objeto] : mapa->GetGameObjectBySpawnIdStore())
+        {
+            if (!EsObjetoDePaso(objeto) || !EstaCerrado(objeto))
+                continue;
+
+            float mejor = 1.0e9f;
+            for (G3D::Vector3 const& p : puntos)
+            {
+                float d = Distancia(p.x, p.y, p.z, objeto->GetPositionX(), objeto->GetPositionY(), objeto->GetPositionZ());
+                if (d < mejor)
+                    mejor = d;
+            }
+
+            if (mejor > radio)
+                continue;
+
+            ++trabas;
+            if (trabas > 1)
+                cuales += ", ";
+            cuales += Trinity::StringFormat("{} a {:.0f} yd del camino", NombreObjeto(objeto, spawnId), mejor);
+        }
+
+        salida += Trinity::StringFormat("  jefe {} ({}): ruta OK con {} punto(s), {} traba(s){} {}\n",
+            entry, jefe->GetName(), uint32(puntos.size()), trabas,
+            trabas ? ":" : ".", trabas ? cuales : "");
+    }
+
+    return salida;
+}
+
+void Mgr::DevolverPiedra(Corrida const& corrida, uint32 nivel, bool subir)
+{
+    if (ConfigNumero("devolver_piedra", 1) == 0)
+    {
+        CharacterDatabase.PExecute("UPDATE mitica_corrida SET piedra_devuelta = 1 WHERE corrida_id = {}", corrida.Id);
+        return;
+    }
+
+    Estancia const* estancia = GetEstancia(corrida.CmId);
+    uint32 nivelDevuelto = nivel;
+    if (subir && estancia && nivelDevuelto < estancia->NivelMax)
+        ++nivelDevuelto;
+
+    // Si el lider no esta conectado la corrida queda con piedra_devuelta = 0: se le devuelve cuando
+    // entre al mundo (DevolverPiedrasPendientes). Asi un reinicio no se come la piedra.
+    Player* lider = ObjectAccessor::FindConnectedPlayer(corrida.Lider);
+    if (!lider)
+        return;
+
+    std::string motivo;
+    if (!DarPiedra(lider, corrida.CmId, nivelDevuelto, motivo))
+    {
+        TC_LOG_ERROR("scripts.miticas", "no se pudo devolver la piedra de la corrida {} ({})",
+            corrida.Id, motivo);
+        return;
+    }
+
+    CharacterDatabase.PExecute("UPDATE mitica_corrida SET piedra_devuelta = 1 WHERE corrida_id = {}", corrida.Id);
+
+    if (nivelDevuelto != nivel)
+        Aviso(lider, Plantilla("aviso_piedra_subida", corrida,
+            { { "nivel", Trinity::StringFormat("{}", nivelDevuelto) } }));
+}
+
+void Mgr::GuardarCorrida(Corrida const& corrida, char const* estado, char const* medalla, uint32 tiempoSeg)
+{
+    CharacterDatabase.PExecute(
+        "UPDATE mitica_corrida SET fin = NOW(), tiempo_seg = {}, muertes = {}, fuerzas = {}, "
+        "estado = '{}', medalla = '{}', puntos = {} WHERE corrida_id = {}",
+        tiempoSeg, corrida.Muertes, corrida.Fuerzas, estado, medalla, corrida.Puntos, corrida.Id);
+}
+
+void Mgr::MarcarCorridasViejas()
+{
+    // Al arrancar el mundo: lo que quedo "en curso" ya no existe (la instancia murio con el proceso).
+    // La piedra de esas corridas NO se pierde: quedan con piedra_devuelta = 0 y se les devuelve al
+    // entrar al mundo (DevolverPiedrasPendientes).
+    if (QueryResult resultado = CharacterDatabase.Query(
+            "SELECT COUNT(*) FROM mitica_corrida WHERE estado IN ('en_curso', 'prueba')"))
+    {
+        uint64 cuantas = resultado->Fetch()[0].GetUInt64();
+        if (cuantas)
+        {
+            CharacterDatabase.Execute("UPDATE mitica_corrida SET estado = 'interrumpida', fin = NOW() "
+                                      "WHERE estado IN ('en_curso', 'prueba')");
+            TC_LOG_INFO("scripts.miticas", "{} corrida(s) de mitica quedaron interrumpidas por el reinicio "
+                                           "(la piedra se devuelve al entrar al mundo)", cuantas);
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// La piedra angular: el ITEM manda, la tabla solo recuerda
+// ---------------------------------------------------------------------------
+// La regla que costo una prueba en vivo: si el sistema confia en sus propias anotaciones en vez del
+// inventario real, termina creyendo en piedras que ya no existen (fila huerfana que gana porque la
+// consulta no ordenaba) y le dice al jugador "la piedra no esta en tu inventario" teniendola en la
+// mano. Al re-crear un item el guid cambia, asi que una fila vieja nunca se "arregla" sola.
+void Mgr::AplicarPiedra(Item* piedra, uint32 cmId, uint32 nivel, std::string const& afijos) const
+{
+    if (!piedra)
+        return;
+
+    piedra->SetModifier(ITEM_MODIFIER_CHALLENGE_MAP_CHALLENGE_MODE_ID, cmId);
+    piedra->SetModifier(ITEM_MODIFIER_CHALLENGE_KEYSTONE_LEVEL, nivel);
+
+    uint32 tope = AfijosMax();
+    uint32 puestos = 0;
+    for (uint32 afijo : ListaDeIds(afijos))
+    {
+        if (puestos >= tope)
+            break;
+        piedra->SetModifier(ItemModifier(ITEM_MODIFIER_CHALLENGE_KEYSTONE_AFFIX_ID_1 + puestos), afijo);
+        ++puestos;
+    }
+}
+
+Item* Mgr::PiedraEnInventario(Player* jugador) const
+{
+    if (!jugador)
+        return nullptr;
+
+    uint32 entrada = ItemPiedra();
+    Item* encontrada = nullptr;
+    jugador->ForEachItem(ItemSearchLocation::Everywhere, [&encontrada, entrada](Item* item)
+    {
+        if (item->GetEntry() != entrada)
+            return ItemSearchCallbackResult::Continue;
+
+        encontrada = item;
+        return ItemSearchCallbackResult::Stop;
+    });
+    return encontrada;
+}
+
+bool Mgr::DarPiedra(Player* jugador, uint32 cmId, uint32 nivel, std::string& motivo)
+{
+    if (!jugador)
+    {
+        motivo = "no hay personaje";
+        return false;
+    }
+
+    Estancia const* estancia = GetEstancia(cmId);
+    if (!estancia)
+    {
+        motivo = "esa estancia no esta en la temporada (mira .mitica estancias)";
+        return false;
+    }
+    if (nivel < estancia->NivelMin || nivel > estancia->NivelMax)
+    {
+        motivo = Trinity::StringFormat("{} pide nivel de piedra entre {} y {}",
+            estancia->Nombre, estancia->NivelMin, estancia->NivelMax);
+        return false;
+    }
+
+    // Una sola piedra a la vez (el item tiene MaxCount = 1): la anterior se destruye Y se borra su
+    // fila. Antes la fila quedaba y despues se leia como si la piedra siguiera existiendo.
+    uint32 entrada = ItemPiedra();
+    jugador->DestroyItemCount(entrada, 10, true);
+    CharacterDatabase.PExecute("DELETE FROM mitica_piedra WHERE personaje = {}",
+        jugador->GetGUID().GetCounter());
+
+    Item* piedra = Item::CreateItem(entrada, 1, ItemContext::NONE, jugador);
+    if (!piedra)
+    {
+        motivo = "no se pudo crear la piedra";
+        return false;
+    }
+    AplicarPiedra(piedra, cmId, uint8(nivel), std::string());
+
+    ItemPosCountVec destino;
+    InventoryResult resultado = jugador->CanStoreItem(NULL_BAG, NULL_SLOT, destino, piedra, false);
+    if (resultado != EQUIP_ERR_OK)
+    {
+        delete piedra;
+        motivo = "no hay lugar en las bolsas";
+        return false;
+    }
+
+    piedra = jugador->StoreItem(destino, piedra, true);
+    if (!piedra)
+    {
+        motivo = "no se pudo guardar la piedra";
+        return false;
+    }
+
+    // El inventario manda: si el item no quedo de verdad en la mochila, NO se anota nada (una fila
+    // anotada sin item es una piedra fantasma).
+    if (!jugador->GetItemByGuid(piedra->GetGUID()))
+    {
+        motivo = "la piedra no entro a la mochila";
+        return false;
+    }
+
+    CharacterDatabase.PExecute(
+        "REPLACE INTO mitica_piedra (item_guid, personaje, cm_id, nivel, afijos) VALUES ({}, {}, {}, {}, '')",
+        piedra->GetGUID().GetCounter(), jugador->GetGUID().GetCounter(), cmId, nivel);
+
+    jugador->SendNewItem(piedra, 1, true, false);
+
+    TC_LOG_INFO("scripts.miticas", "piedra entregada a {}: {} nivel {} (item {})",
+        jugador->GetName(), estancia->Nombre, nivel, piedra->GetGUID().GetCounter());
+    motivo.clear();
+    return true;
+}
+
+uint32 Mgr::RecordarPiedras(Player* jugador)
+{
+    if (!jugador)
+        return 0;
+
+    QueryResult filas = CharacterDatabase.PQuery(
+        "SELECT item_guid, cm_id, nivel, afijos FROM mitica_piedra WHERE personaje = {} ORDER BY item_guid DESC",
+        jugador->GetGUID().GetCounter());
+    if (!filas)
+        return 0;
+
+    uint32 aplicadas = 0;
+    std::vector<uint64> huerfanas;
+
+    do
+    {
+        Field* campos = filas->Fetch();
+        ObjectGuid guidPiedra = ObjectGuid::Create<HighGuid::Item>(campos[0].GetUInt64());
+
+        Item* piedra = jugador->GetItemByGuid(guidPiedra);
+        if (!piedra)
+        {
+            huerfanas.push_back(campos[0].GetUInt64());
+            continue;
+        }
+
+        AplicarPiedra(piedra, campos[1].GetUInt32(), campos[2].GetUInt8(), campos[3].GetString());
+        ++aplicadas;
+    } while (filas->NextRow());
+
+    // Limpieza: la fila de una piedra que ya no existe se borra (al consumirla en una corrida, al
+    // destruirla, o al reemplazarla). Se hace despues de leer, no durante.
+    for (uint64 guidHuerfano : huerfanas)
+    {
+        CharacterDatabase.PExecute("DELETE FROM mitica_piedra WHERE item_guid = {}", guidHuerfano);
+        TC_LOG_INFO("scripts.miticas", "piedra fantasma borrada: la fila {} de {} apuntaba a un item que ya no existe",
+            guidHuerfano, jugador->GetName());
+    }
+
+    return aplicadas;
+}
+
+void Mgr::DevolverPiedrasPendientes(Player* jugador)
+{
+    if (!jugador || ConfigNumero("devolver_piedra", 1) == 0)
+        return;
+
+    QueryResult pendientes = CharacterDatabase.PQuery(
+        "SELECT corrida_id, cm_id, nivel, medalla FROM mitica_corrida "
+        "WHERE lider = {} AND piedra_devuelta = 0 AND estado <> 'en_curso' ORDER BY corrida_id",
+        jugador->GetGUID().GetCounter());
+    if (!pendientes)
+        return;
+
+    std::vector<std::tuple<uint64, uint32, uint32, std::string>> lista;
+    do
+    {
+        Field* campos = pendientes->Fetch();
+        lista.emplace_back(campos[0].GetUInt64(), campos[1].GetUInt32(), campos[2].GetUInt32(),
+            campos[3].GetString());
+    } while (pendientes->NextRow());
+
+    for (auto const& [corridaId, cmId, nivel, medalla] : lista)
+    {
+        Estancia const* estancia = GetEstancia(cmId);
+        uint32 nivelDevuelto = nivel;
+        if (medalla == "oro" && ConfigNumero("piedra_sube_con_oro", 1) != 0 && estancia && nivelDevuelto < estancia->NivelMax)
+            ++nivelDevuelto;
+
+        std::string motivo;
+        if (!DarPiedra(jugador, cmId, nivelDevuelto, motivo))
+        {
+            TC_LOG_ERROR("scripts.miticas", "no se pudo devolver la piedra de la corrida {} a {}: {}",
+                corridaId, jugador->GetName(), motivo);
+            continue;
+        }
+
+        CharacterDatabase.PExecute("UPDATE mitica_corrida SET piedra_devuelta = 1 WHERE corrida_id = {}", corridaId);
+        TC_LOG_INFO("scripts.miticas", "piedra devuelta a {} por la corrida {} ({} nivel {})",
+            jugador->GetName(), corridaId, estancia ? estancia->Nombre : "?", nivelDevuelto);
+    }
+}
