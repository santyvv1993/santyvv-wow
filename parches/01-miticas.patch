+
+namespace
+{
+class script_piedras_miticas : public PlayerScript
+{
+public:
+    script_piedras_miticas() : PlayerScript("script_piedras_miticas") { }
+
+    void OnLogin(Player* jugador, bool /*primerIngreso*/) override
+    {
+        // Se reaplica lo que el core no persiste (los modificadores de la piedra) y se limpian las
+        // filas huerfanas: el inventario real manda sobre lo que el sistema anoto.
+        if (uint32 aplicadas = sMythicPlus->RecordarPiedras(jugador))
+            TC_LOG_INFO("scripts.miticas", "Piedra(s) de mitica aplicada(s) a {}: {}", jugador->GetName(), aplicadas);
+
+        sMythicPlus->DevolverPiedrasPendientes(jugador);
+    }
+
+    // Cada muerte del grupo suma al contador de la corrida (y se lo cuenta al cliente).
+    void OnPlayerKilledByCreature(Creature* /*killer*/, Player* muerto) override
+    {
+        sMythicPlus->AgregarMuerte(muerto);
+    }
+
+    // Cada enemigo que muere aporta sus fuerzas. El cierre NO se decide aca: se mira la instancia
+    // (Mgr::Vigilar), porque una muerte por comando de GM no se le atribuye a ningun jugador.
+    // Después de cada muerte se dispara la vigilancia para que el cierre sea inmediato.
+    void OnCreatureKill(Player* asesino, Creature* muerto) override
+    {
+        if (!asesino || !muerto)
+            return;
+
+        if (float pct = sMythicPlus->FuerzasDeCriatura(muerto, sMythicPlus->GetCorridaDe(asesino)))
+            sMythicPlus->AgregarFuerzas(asesino, pct);
+
+        sMythicPlus->Vigilar();
+    }
+};
+
+class script_miticas_mundo : public WorldScript
+{
+public:
+    script_miticas_mundo() : WorldScript("script_miticas_mundo") { }
+
+    void OnStartup() override
+    {
+        sMythicPlus->CargarConfig();
+        sMythicPlus->MarcarCorridasViejas();
+
+        // Fase 2 (estancias escalables): la perilla por estancia. Se carga aca, con el mundo ya
+        // inicializado y las migraciones de la base aplicadas. Sin filas, el sistema no hace nada.
+        sEscaladoInstancia->Cargar();
+    }
+
+    // El reloj de la vigilancia: cada `vigilancia_seg` segundos (mitica_config) se mira si la
+    // corrida ya no tiene jefes vivos. Es un reloj del mundo y no del evento de muerte justamente
+    // para no depender de quien mato al jefe.
+    void OnUpdate(uint32 diff) override
+    {
+        _acumulado += diff;
+
+        uint32 cada = sMythicPlus->ConfigNumero("vigilancia_seg", 5);
+        if (!cada)
+            cada = 5;
+        if (_acumulado < cada * IN_MILLISECONDS)
+            return;
+
+        _acumulado = 0;
+        sMythicPlus->Vigilar();
+    }
+
+private:
+    uint32 _acumulado = 0;
+};
+
+// --- entrega de items por correo con el CONTEXTO correcto -------------------------
+// El nivel de objeto que ve el cliente NO es el del DB2 (ItemSparse.ItemLevel: el botin
+// del Abismo Venenoso tiene 219 de base), sino ese mas los bonus de la dificultad: la
+// guia de aventura muestra 302 en normal. Esos bonus los aplica el core a partir del
+// ItemContext, y `.send items` crea los items con ItemContext::NONE -> salen a 219.
+// Aca se usa Item::CreateItem(id, cantidad, contexto) con addDefaultBonuses = true, que
+// es EL MISMO camino que usa el botin (Player::StoreNewItem), asi que el nivel lo
+// calcula el servidor y el cliente lo dibuja igual que si hubiera caido en la raid.
+static Optional<ItemContext> ContextoPorNombre(std::string const& nombre)
+{
+    if (nombre == "NONE")                  return ItemContext::NONE;
+    if (nombre == "Dungeon_Normal")        return ItemContext::Dungeon_Normal;
+    if (nombre == "Dungeon_Heroic")        return ItemContext::Dungeon_Heroic;
+    if (nombre == "Dungeon_Mythic")        return ItemContext::Dungeon_Mythic;
+    if (nombre == "Raid_Normal")           return ItemContext::Raid_Normal;
+    if (nombre == "Raid_Raid_Finder")      return ItemContext::Raid_Raid_Finder;
+    if (nombre == "Raid_Heroic")           return ItemContext::Raid_Heroic;
+    if (nombre == "Raid_Mythic")           return ItemContext::Raid_Mythic;
+    if (nombre == "Quest_Reward")          return ItemContext::Quest_Reward;
+    if (nombre == "Vendor")                return ItemContext::Vendor;
+    if (nombre == "Timewalking")           return ItemContext::Timewalking;
+    if (nombre == "MythicPlus_End_of_Run") return ItemContext::MythicPlus_End_of_Run;
+    return {};
+}
+
+// --- comandos de operacion: un comando por tarea ---------------------------------
+using namespace Trinity::ChatCommands;
+
+class comando_mitica : public CommandScript
+{
+public:
+    comando_mitica() : CommandScript("comando_mitica") { }
+
+    std::span<ChatCommandBuilder const> GetCommands() const override
+    {
+        static ChatCommandTable miticaCommandTable =
+        {
+            { "piedra",    HandlePiedraCommand,    rbac::RBAC_PERM_COMMAND_ADDITEM, Console::No },
+            { "estancias", HandleEstanciasCommand, rbac::RBAC_PERM_COMMAND_ADDITEM, Console::No },
+            { "estado",    HandleEstadoCommand,    rbac::RBAC_PERM_COMMAND_ADDITEM, Console::No },
+            { "cerrar",    HandleCerrarCommand,    rbac::RBAC_PERM_COMMAND_ADDITEM, Console::No },
+            // Red de seguridad del recorrido: los dos andan tambien por consola (Console::Yes), asi
+            // que el agente puede medir y destrabar sin tener el cliente abierto.
+            { "destrabar", HandleDestrabarCommand, rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            { "trabas",    HandleTrabasCommand,    rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            // Entrega por correo con el contexto de dificultad (el nivel de objeto real). Anda por
+            // consola, asi que el agente manda el obsequio sin tener el cliente abierto.
+            { "obsequio",  HandleObsequioCommand,  rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+            // Escalado por estancia (Fase 2): la perilla de `instancia_escalado`. Anda por consola
+            // porque el agente tiene que poder verificar sin el cliente abierto, y se recarga en
+            // caliente porque ajustar una banda no deberia costar un reinicio del mundo.
+            { "escalado",  HandleEscaladoCommand,  rbac::RBAC_PERM_COMMAND_ADDITEM, Console::Yes },
+        };
+        static ChatCommandTable commandTable =
+        {
+            { "mitica", miticaCommandTable },
+        };
+        return commandTable;
+    }
+
+    static bool HandlePiedraCommand(ChatHandler* handler, Optional<uint32> cmId, Optional<uint32> nivel)
+    {
+        Player* jugador = handler->GetPlayer();
+        if (!jugador)
+        {
+            handler->SendSysMessage("Este comando necesita un personaje en el mundo.");
+            return false;
+        }
+
+        uint32 elegida = cmId.value_or(0);
+        if (!elegida)
+        {
+            auto const& estancias = sMythicPlus->GetEstancias();
+            if (estancias.empty())
+            {
+                handler->SendSysMessage("No hay estancias cargadas: revisa world.mitica_estancia.");
+                return false;
+            }
+            elegida = estancias[urand(0, uint32(estancias.size()) - 1)].CmId;
+        }
+
+        uint32 pedido = nivel.value_or(0) ? *nivel : 2;
+        std::string motivo;
+        if (!sMythicPlus->DarPiedra(jugador, elegida, pedido, motivo))
+        {
+            handler->SendSysMessage(motivo.c_str());
+            return false;
+        }
+
+        handler->PSendSysMessage("Piedra entregada (estancia %u, nivel %u). Anda al receptaculo de esa mazmorra.",
+            elegida, pedido);
+        return true;
+    }
+
+    static bool HandleEstanciasCommand(ChatHandler* handler)
+    {
+        auto const& estancias = sMythicPlus->GetEstancias();
+        handler->PSendSysMessage("Miticas+ | temporada activa: %s | %u estancias",
+            sMythicPlus->TemporadaNombre().c_str(), uint32(estancias.size()));
+        for (Trinity::MythicPlus::Estancia const& e : estancias)
+            handler->PSendSysMessage("  cm %u | mapa %u | %s | nivel %u-%u | oro %u min | jefe final %s | %s",
+                e.CmId, e.MapId, e.Nombre.c_str(), e.NivelMin, e.NivelMax,
+                e.TiempoOro / 60, e.JefeFinal.empty() ? "cualquiera" : e.JefeFinal.c_str(),
+                e.Activa ? "activa" : "APAGADA");
+        return true;
+    }
+
+    // Escalado por estancia (Fase 2). `.mitica escalado` muestra la perilla cargada; con `recargar`
+    // vuelve a leer `world.instancia_escalado` sin reiniciar el mundo (ajustar una banda o un modo es
+    // un UPDATE, y ahora no cuesta nada verlo).
+    static bool HandleEscaladoCommand(ChatHandler* handler, char const* args)
+    {
+        std::string accion = args ? args : "";
+        while (!accion.empty() && accion.front() == ' ')
+            accion.erase(accion.begin());
+
+        if (accion == "recargar")
+        {
+            sEscaladoInstancia->Cargar();
+            handler->SendSysMessage(Trinity::StringFormat(
+                "escalado por estancia recargado: {} regla(s).", sEscaladoInstancia->GetReglas()));
+            return true;
+        }
+
+        // OJO: PSendSysMessage es estilo printf (%u), no de llaves: con {} imprime el {} literal.
+        // Para el estilo del proyecto se arma el texto con StringFormat y se manda como cadena.
+        handler->SendSysMessage(Trinity::StringFormat(
+            "escalado por estancia: {} regla(s) cargada(s). Reglas que hacen algo:",
+            sEscaladoInstancia->GetReglas()));
+
+        std::vector<std::string> lineas = sEscaladoInstancia->DescribirReglas();
+        if (lineas.empty())
+            handler->SendSysMessage("   (ninguna: todo queda como lo declara el cliente)");
+        for (std::string const& linea : lineas)
+            handler->SendSysMessage(linea);
+
+        handler->SendSysMessage("uso: .mitica escalado recargar   (relee world.instancia_escalado)");
+        return true;
+    }
+
+    static bool HandleEstadoCommand(ChatHandler* handler)
+    {
+        Player* jugador = handler->GetPlayer();
+        if (!jugador)
+            return false;
+
+        Trinity::MythicPlus::Corrida* corrida = sMythicPlus->GetCorridaDe(jugador);
+        if (!corrida)
+        {
+            handler->SendSysMessage("No hay una corrida de mitica+ en curso para tu personaje.");
+            return true;
+        }
+
+        Trinity::MythicPlus::Estancia const* estancia = sMythicPlus->GetEstancia(corrida->CmId);
+        handler->PSendSysMessage("Corrida %llu | %s | nivel %u | %u s | %u muertes | %.1f%% fuerzas%s",
+            corrida->Id, estancia ? estancia->Nombre.c_str() : "?", corrida->NivelKeystone,
+            corrida->SegundosTranscurridos(), corrida->Muertes, corrida->Fuerzas,
+            corrida->Prueba ? " [PRUEBA]" : "");
+        return true;
+    }
+
+    // Cierra la corrida de la instancia en la que esta el personaje. Existe porque una prueba puede
+    // quedar con los jefes ya muertos antes de arrancar (la vigilancia no cierra lo que nunca vio).
+    static bool HandleCerrarCommand(ChatHandler* handler)
+    {
+        Player* jugador = handler->GetPlayer();
+        if (!jugador || !jugador->GetMap())
+        {
+            handler->SendSysMessage("Este comando necesita un personaje en el mundo.");
+            return false;
+        }
+
+        Trinity::MythicPlus::Corrida* corrida = sMythicPlus->GetCorridaPorInstancia(
+            jugador->GetMap()->GetId(), jugador->GetMap()->GetInstanceId());
+        if (!corrida)
+        {
+            handler->SendSysMessage("No hay una corrida de mitica+ en esta instancia.");
+            return false;
+        }
+
+        std::string motivo;
+        if (!sMythicPlus->Cerrar(*corrida, false, motivo))
+        {
+            handler->PSendSysMessage("No se pudo cerrar la corrida: %s", motivo.c_str());
+            return false;
+        }
+
+        handler->SendSysMessage("Corrida cerrada. La piedra vuelve a tu inventario.");
+        return true;
+    }
+
+    // === Red de seguridad del recorrido ===================================================
+    // Abre los objetos de paso CERRADOS de la instancia (puertas y muros destructibles). Es el
+    // boton de panico: si el dato o el guion fallaran y una reja queda trabada, esto la abre.
+    // Funciona tambien por consola: sin jugador resuelve la instancia con el cm de la estancia.
+    static bool HandleDestrabarCommand(ChatHandler* handler, Optional<uint32> cmId)
+    {
+        Map* mapa = nullptr;
+        if (Player* jugador = handler->GetPlayer())
+            mapa = jugador->GetMap();
+        else if (cmId)
+            mapa = sMythicPlus->MapaDeEstancia(*cmId);
+
+        if (!mapa)
+        {
+            handler->SendSysMessage("Necesito estar dentro de la instancia, o pasar el cm de una estancia con corrida en curso.");
+            TC_LOG_INFO("scripts.miticas", "recorrido (destrabar): no hay instancia cargada para el cm {}", cmId ? *cmId : 0);
+            return false;
+        }
+
+        std::string detalle;
+        uint32 abiertos = sMythicPlus->Destrabar(mapa, detalle);
+        if (!abiertos)
+        {
+            handler->SendSysMessage("No habia ningun objeto de paso cerrado en la instancia.");
+            TC_LOG_INFO("scripts.miticas", "recorrido (destrabar): no habia objetos de paso cerrados en el mapa {}", mapa->GetId());
+            return true;
+        }
+
+        // Por consola (SOAP) el texto de `SendSysMessage` no siempre vuelve; el log si.
+        handler->PSendSysMessage("Destrabados %u objeto(s): %s", abiertos, detalle.c_str());
+        TC_LOG_INFO("scripts.miticas", "recorrido (destrabar): {} objeto(s) abiertos en el mapa {}: {}",
+            abiertos, mapa->GetId(), detalle);
+        return true;
+    }
+
+    // Diagnostico de recorrido: para cada jefe declarado, calcula el camino con los mmaps y dice
+    // que objetos CERRADOS caen encima. Es la medicion de "esto no se puede trabar": si una reja
+    // sin logica esta sobre el camino, aca sale con su nombre.
+    static bool HandleTrabasCommand(ChatHandler* handler, Optional<uint32> cmId)
+    {
+        Map* mapa = nullptr;
+        Trinity::MythicPlus::Estancia const* estancia = nullptr;
+        float x = 0.0f, y = 0.0f, z = 0.0f;
+
+        if (Player* jugador = handler->GetPlayer())
+        {
+            mapa = jugador->GetMap();
+            x = jugador->GetPositionX();
+            y = jugador->GetPositionY();
+            z = jugador->GetPositionZ();
+
+            if (Trinity::MythicPlus::Corrida* corrida = sMythicPlus->GetCorridaDe(jugador))
+                estancia = sMythicPlus->GetEstancia(corrida->CmId);
+        }
+
+        if (!mapa && cmId)
+        {
+            mapa = sMythicPlus->MapaDeEstancia(*cmId);
+            estancia = sMythicPlus->GetEstancia(*cmId);
+
+            // Sin jugador no hay posicion: se arranca desde la ENTRADA del calabozo (el punto
+            // seguro que la base ya tiene para esa mazmorra).
+            if (mapa)
+            {
+                if (QueryResult punto = WorldDatabase.Query(
+                    Trinity::StringFormat(
+                        "SELECT LocX, LocY, LocZ FROM world_safe_locs WHERE MapID = {} AND Comment LIKE '%ntrance%' ORDER BY ID LIMIT 1",
+                        mapa->GetId()).c_str()))
+                {
+                    Field* campos = punto->Fetch();
+                    x = campos[0].GetFloat();
+                    y = campos[1].GetFloat();
+                    z = campos[2].GetFloat();
+                }
+            }
+        }
+
+        if (!mapa)
+        {
+            handler->SendSysMessage("Necesito estar dentro de la instancia, o pasar el cm de una estancia con corrida en curso (nadie adentro = no hay mapa).");
+            TC_LOG_INFO("scripts.miticas", "recorrido (trabas): no hay instancia cargada para el cm {}", cmId ? *cmId : 0);
+            return false;
+        }
+
+        std::string informe = sMythicPlus->DiagnosticoRecorrido(mapa, estancia, x, y, z);
+        // Por consola (SOAP) el texto de `SendSysMessage` no siempre vuelve; el log si.
+        handler->PSendSysMessage("%s", informe.c_str());
+        TC_LOG_INFO("scripts.miticas", "recorrido (diagnostico): {}", informe);
+        return true;
+    }
+
+    // Entrega por CORREO un obsequio declarado en la base, con el contexto de dificultad que
+    // tenga anotado: asi el item sale con el nivel de objeto que le toca (ver ContextoPorNombre).
+    //   .mitica obsequio <personaje> <conjunto>
+    // El personaje puede estar desconectado (el correo queda esperandolo) y anda por consola/SOAP.
+    static bool HandleObsequioCommand(ChatHandler* handler, char const* args)
+    {
+        std::string crudo = args ? args : "";
+        std::vector<char> copia(crudo.begin(), crudo.end());
+        copia.push_back('\0');
+
+        char* nombreArg = strtok(copia.data(), " ");
+        char* conjuntoArg = nombreArg ? strtok(nullptr, " ") : nullptr;
+        if (!nombreArg || !conjuntoArg)
+        {
+            handler->SendSysMessage("Uso: .mitica obsequio <personaje> <conjunto> (los conjuntos estan en world.mitica_obsequio).");
+            return false;
+        }
+        std::string nombre = nombreArg;
+        std::string conjunto = conjuntoArg;
+
+        ObjectGuid guid = sCharacterCache->GetCharacterGuidByName(nombre);
+        if (!guid)
+        {
+            handler->PSendSysMessage("No existe ningun personaje llamado '%s'.", nombre.c_str());
+            return false;
+        }
+
+        QueryResult cabecera = WorldDatabase.Query(Trinity::StringFormat(
+            "SELECT contexto, asunto, cuerpo FROM mitica_obsequio WHERE conjunto = '{}'", conjunto).c_str());
+        if (!cabecera)
+        {
+            handler->PSendSysMessage("No hay ningun obsequio llamado '%s' en world.mitica_obsequio.", conjunto.c_str());
+            return false;
+        }
+        Field* datos = cabecera->Fetch();
+        std::string contextoNombre = datos[0].GetString();
+        std::string asunto = datos[1].GetString();
+        std::string cuerpo = datos[2].GetString();
+
+        Optional<ItemContext> contexto = ContextoPorNombre(contextoNombre);
+        if (!contexto)
+        {
+            handler->PSendSysMessage("El contexto '%s' no lo conozco: revisa la lista en ContextoPorNombre (miticas_custom.cpp).", contextoNombre.c_str());
+            return false;
+        }
+
+        QueryResult filas = WorldDatabase.Query(Trinity::StringFormat(
+            "SELECT item_id, cantidad, etiqueta FROM mitica_obsequio_item WHERE conjunto = '{}' ORDER BY item_id", conjunto).c_str());
+        if (!filas)
+        {
+            handler->PSendSysMessage("El obsequio '%s' no tiene items anotados.", conjunto.c_str());
+            return false;
+        }
+
+        CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+        MailSender remitente(MAIL_NORMAL, 0, MAIL_STATIONERY_GM);
+        std::vector<Item*> lote;
+        uint32 enviados = 0, correos = 0;
+
+        auto mandarLote = [&]()
+        {
+            if (lote.empty())
+                return;
+            MailDraft borrador(asunto, cuerpo);
+            for (Item* pieza : lote)
+                borrador.AddItem(pieza);
+            borrador.SendMailTo(trans, MailReceiver(guid.GetCounter()), remitente);
+            lote.clear();
+            ++correos;
+        };
+
+        do
+        {
+            Field* fila = filas->Fetch();
+            uint32 itemId = fila[0].GetUInt32();
+            uint32 cantidad = fila[1].GetUInt32();
+            std::string etiqueta = fila[2].GetString();
+
+            Item* item = Item::CreateItem(itemId, cantidad, *contexto);
+            if (!item)
+            {
+                TC_LOG_ERROR("scripts.miticas", "obsequio {}: el item {} no se pudo crear", conjunto, itemId);
+                continue;
+            }
+
+            ItemTemplate const* proto = item->GetTemplate();
+            uint32 nivelObjeto = Item::GetItemLevel(proto, *item->GetBonus(), 0,
+                uint32(item->GetRequiredLevel()), 0, 0, 0, false, 0, 0);
+            TC_LOG_INFO("scripts.miticas", "obsequio {} -> {} | item {} x{} | contexto {} | nivel de objeto calculado por el core: {}",
+                conjunto, etiqueta, itemId, cantidad, contextoNombre, nivelObjeto);
+
+            item->SaveToDB(trans);
+            lote.push_back(item);
+            ++enviados;
+
+            if (lote.size() >= MAX_MAIL_ITEMS)
+                mandarLote();
+        } while (filas->NextRow());
+
+        mandarLote();
+        CharacterDatabase.CommitTransaction(trans);
+
+        handler->PSendSysMessage("Obsequio '%s' -> %s: %u items de nivel real en %u correo(s) (contexto %s). El nivel calculado quedo en el log.",
+            conjunto.c_str(), nombre.c_str(), enviados, correos, contextoNombre.c_str());
+        TC_LOG_INFO("scripts.miticas", "obsequio {}: enviados {} items a {} en {} correo(s), contexto {}",
+            conjunto, enviados, nombre, correos, contextoNombre);
+        return true;
+    }
+}; // fin de comando_mitica
+
+// --- NPC de salida: aparece al cerrar la corrida y saca al grupo de la estancia -------------------
+// Todo lo del NPC es DATO (entry y punto de salida en `mitica_estancia.salida_npc`/`salida_punto`,
+// el menu y el texto en `gossip_menu*`/`hotfixes.broadcast_text`); aca solo vive lo que el dato no
+// puede hacer: el teleport. El destino es el que usa el propio cliente para salir de la mazmorra.
+constexpr uint32 MENU_SALIDA_MITICA = 900244;
+
+// El gossip en este core vive en la IA de la criatura (CreatureAI::OnGossipHello/OnGossipSelect):
+// el `CreatureScript` solo elige la IA.
+class npc_mitica_salida_AI : public CreatureAI
+{
+public:
+    explicit npc_mitica_salida_AI(Creature* criatura) : CreatureAI(criatura) { }
+
+    // El guia no hace nada por si solo: solo atiende el gossip.
+    void UpdateAI(uint32 /*diff*/) override { }
+
+    bool OnGossipHello(Player* jugador) override
+    {
+        jugador->PrepareGossipMenu(me, MENU_SALIDA_MITICA);
+        jugador->SendPreparedGossip(me);
+        return true;
+    }
+
+    bool OnGossipSelect(Player* jugador, uint32 /*menuId*/, uint32 /*gossipListId*/) override
+    {
+        uint32 mapaDestino = 0;
+        float x = 0.0f, y = 0.0f, z = 0.0f, o = 0.0f;
+
+        jugador->PlayerTalkClass->SendCloseGossip();
+
+        if (!sMythicPlus->PuntoDeSalida(jugador->GetMapId(), mapaDestino, x, y, z, o))
+        {
+            jugador->GetSession()->SendNotification("Esta estancia no tiene punto de salida configurado.");
+            return true;
+        }
+
+        TC_LOG_INFO("scripts.miticas", "salida: {} pidio salir de la mazmorra {} -> mapa {} ({:.1f} {:.1f} {:.1f})",
+            jugador->GetName(), jugador->GetMapId(), mapaDestino, x, y, z);
+
+        jugador->TeleportTo(mapaDestino, x, y, z, o);
+        return true;
+    }
+};
+
+class npc_mitica_salida : public CreatureScript
+{
+public:
+    npc_mitica_salida() : CreatureScript("npc_mitica_salida") { }
+
+    CreatureAI* GetAI(Creature* criatura) const override
+    {
+        return new npc_mitica_salida_AI(criatura);
+    }
+};
+
+// --- Cofre de recompensa de la mitica+ -----------------------------------------------------------
+// El objeto (goober con gossip, ScriptName `go_cofre_mitica`) NO hace nada por si solo: el botin lo
+// calcula el motor (`sMythicPlus->AbrirCofre`), que sabe el nivel de la piedra de la corrida y arma
+// el item con el contexto y el nivel correctos. Aca solo se atiende el clic.
+class go_cofre_mitica_AI : public GameObjectAI
+{
+public:
+    explicit go_cofre_mitica_AI(GameObject* objeto) : GameObjectAI(objeto) { }
+
+    // El clic del cliente sobre un objeto usable llega por aca (WorldSession::HandleGameobjectReportUse)
+    // y tambien por OnGossipHello si el objeto tiene menu; los dos caminos entregan lo mismo.
+    bool OnReportUse(Player* jugador) override
+    {
+        return sMythicPlus->AbrirCofre(jugador);
+    }
+
+    bool OnGossipHello(Player* jugador) override
+    {
+        return sMythicPlus->AbrirCofre(jugador);
+    }
+};
+
+class go_cofre_mitica : public GameObjectScript
+{
+public:
+    go_cofre_mitica() : GameObjectScript("go_cofre_mitica") { }
+
+    GameObjectAI* GetAI(GameObject* objeto) const override
+    {
+        return new go_cofre_mitica_AI(objeto);
+    }
+};
+} // namespace
+
+void AddSC_miticas_custom()
+{
+    new script_piedras_miticas();
+    new script_miticas_mundo();
+    new comando_mitica();
+    new npc_mitica_salida();
+    new go_cofre_mitica();
+}
