+/*
+ * El arranque de la mitica+: el cliente manda CMSG_START_CHALLENGE_MODE cuando el lider inserta
+ * la piedra en el receptaculo. La fuente de verdad es EL INVENTARIO: el cliente dice donde esta la
+ * piedra y aca se mira el item real (no la tabla characters.mitica_piedra, que solo recuerda que
+ * modificadores lleva el item). Si el item no esta, no hay corrida.
+ */
+
+#include "ChallengeModePackets.h"
+#include "DatabaseEnv.h"
+#include "Item.h"
+#include "Log.h"
+#include "MythicPlusMgr.h"
+#include "Player.h"
+#include "StringFormat.h"
+#include "WorldSession.h"
+
+void WorldSession::HandleStartChallengeMode(WorldPackets::ChallengeMode::StartChallengeMode& packet)
+{
+    Player* jugador = GetPlayer();
+    if (!jugador || !jugador->IsInWorld())
+        return;
+
+    std::string crudo;
+    for (uint8 byte : packet.Crudo)
+        crudo += Trinity::StringFormat("{:02X} ", byte);
+    TC_LOG_INFO("scripts.miticas", "CMSG_START_CHALLENGE_MODE de {} ({} bytes): {} | bolsa {} ranura {}",
+        jugador->GetName(), uint32(packet.Crudo.size()), crudo, packet.Bolsa, packet.Ranura);
+
+    // La piedra que el cliente señala, verificada contra el inventario real.
+    Item* piedra = jugador->GetItemByPos(packet.Bolsa, packet.Ranura);
+    if (!piedra || piedra->GetEntry() != sMythicPlus->ItemPiedra())
+        piedra = sMythicPlus->PiedraEnInventario(jugador);   // sin posicion util: la que haya
+
+    if (!piedra)
+    {
+        SendNotification("%s", "No tenes una piedra angular mitica en el inventario.");
+        return;
+    }
+
+    QueryResult fila = CharacterDatabase.PQuery(
+        "SELECT cm_id, nivel FROM mitica_piedra WHERE item_guid = {}", piedra->GetGUID().GetCounter());
+    if (!fila)
+    {
+        SendNotification("%s", "El servidor no sabe de que mazmorra es esa piedra: pedila con .mitica piedra.");
+        return;
+    }
+
+    Field* campos = fila->Fetch();
+    uint32 cmId = campos[0].GetUInt32();
+    uint32 nivel = campos[1].GetUInt32();
+
+    std::string motivo;
+    bool prueba = jugador->IsGameMaster();   // las corridas de GM no ensucian el historial
+    if (!sMythicPlus->Iniciar(jugador, piedra, cmId, nivel, prueba, motivo))
+        SendNotification("No se pudo arrancar la mitica+: %s", motivo.c_str());
+}
+
+/*
+ * El panel de temporada de miticas+. El cliente pide los datos con un paquete VACIO y el oficial
+ * contesta SMSG_MYTHIC_PLUS_SEASON_DATA de UN byte (`IsMythicPlusActive: True`) - medido dos veces en
+ * la captura del oficial: 19-sep y 21-sep (pedido 11:46:20.637, respuesta 11:46:21.688).
+ *
+ * El formato NO se escribe aca: sale de la base (`mitica_paquete` + `mitica_paquete_campo`), el mismo
+ * paquete que ya se manda al arrancar una corrida. Asi se corrige sin recompilar.
+ */
+void WorldSession::HandleRequestMythicPlusSeasonData(WorldPackets::ChallengeMode::RequestMythicPlusSeasonData& /*packet*/)
+{
+    Player* jugador = GetPlayer();
+    if (!jugador)
+        return;
+
+    if (Trinity::MythicPlus::Corrida* corrida = sMythicPlus->GetCorridaDe(jugador))
+    {
+        sMythicPlus->EnviarPaquete(jugador, *corrida, "SMSG_MYTHIC_PLUS_SEASON_DATA");
+        return;
+    }
+
+    // Sin corrida en curso el panel se abre igual (temporada, afijos y puntaje): el paquete es un dato
+    // constante declarado en la base y no depende de la corrida. Se manda con una corrida vacia para
+    // que el camino sea el mismo que en una corrida real.
+    Trinity::MythicPlus::Corrida sinCorrida;
+    sMythicPlus->EnviarPaquete(jugador, sinCorrida, "SMSG_MYTHIC_PLUS_SEASON_DATA");
+}
diff --git a/src/server/game/MythicPlus/EscaladoEstanciaMgr.cpp b/src/server/game/MythicPlus/EscaladoEstanciaMgr.cpp
new file mode 100644
index 0000000000..d3bc9e6e2c
--- /dev/null
+++ b/src/server/game/MythicPlus/EscaladoEstanciaMgr.cpp
@@ -0,0 +1,188 @@
+#include "EscaladoEstanciaMgr.h"
+
+#include "Creature.h"
+#include "DatabaseEnv.h"
+#include "Log.h"
+#include "Map.h"
+#include "Player.h"
+#include "StringFormat.h"
+
+namespace Trinity
+{
+namespace Instancias
+{
+namespace
+{
+constexpr uint16 CUALQUIER_DIFICULTAD = 0xFFFF;
+
+uint64 Clave(uint32 mapa, uint16 dificultad)
+{
+    return (uint64(mapa) << 16) | dificultad;
+}
+
+ModoEscalado ModoDesdeTexto(std::string const& texto)
+{
+    if (texto == "rango")
+        return ModoEscalado::Rango;
+    if (texto == "grupo")
+        return ModoEscalado::Grupo;
+    return ModoEscalado::Cliente;
+}
+
+char const* TextoDe(ModoEscalado modo)
+{
+    switch (modo)
+    {
+        case ModoEscalado::Rango: return "rango";
+        case ModoEscalado::Grupo: return "grupo";
+        default:                  return "cliente";
+    }
+}
+} // namespace
+
+EscaladoMgr* EscaladoMgr::instance()
+{
+    static EscaladoMgr instancia;
+    return &instancia;
+}
+
+void EscaladoMgr::Cargar()
+{
+    _reglas.clear();
+    _porMapaYDificultad.clear();
+    _avisados.clear();
+
+    if (QueryResult resultado = WorldDatabase.Query(
+            "SELECT map, difficulty, modo, nivel_min, nivel_max, nota FROM instancia_escalado "
+            "ORDER BY map, difficulty"))
+    {
+        do
+        {
+            Field* campos = resultado->Fetch();
+
+            ReglaEscalado regla;
+            regla.MapId = campos[0].GetUInt32();
+            regla.Difficulty = campos[1].GetUInt16();
+            regla.Modo = ModoDesdeTexto(campos[2].GetString());
+            regla.NivelMin = uint8(campos[3].GetUInt32());
+            regla.NivelMax = uint8(campos[4].GetUInt32());
+            regla.Nota = campos[5].GetString();
+
+            _porMapaYDificultad[Clave(regla.MapId, regla.Difficulty)] = _reglas.size();
+            _reglas.push_back(regla);
+        } while (resultado->NextRow());
+    }
+
+    // El logger es `scripts.miticas` a proposito: los loggers propios solo llegan a Server.log si
+    // tienen su linea en worldserver.conf (Logger.scripts.miticas=3) y `Logger.root=5` filtra los INFO,
+    // asi que un `scripts.escalado` nuevo caeria en el olvido sin avisar. Este ya esta configurado.
+    uint32 porModo[3] = { 0, 0, 0 };
+    for (ReglaEscalado const& regla : _reglas)
+        ++porModo[uint8(regla.Modo)];
+
+    TC_LOG_INFO("scripts.miticas",
+        "escalado por estancia cargado: {} regla(s) (cliente {}, rango {}, grupo {})",
+        _reglas.size(), porModo[0], porModo[1], porModo[2]);
+}
+
+std::vector<std::string> EscaladoMgr::DescribirReglas() const
+{
+    std::vector<std::string> lineas;
+    for (ReglaEscalado const& regla : _reglas)
+    {
+        // Las de modo 'cliente' no se listan: son la mayoria y no cambian nada.
+        if (regla.Modo == ModoEscalado::Cliente)
+            continue;
+
+        std::string banda = regla.Modo == ModoEscalado::Rango
+            ? StringFormat(" banda {}-{}", regla.NivelMin, regla.NivelMax)
+            : std::string();
+
+        lineas.push_back(StringFormat("mapa {} dificultad {} modo '{}'{}{}{}",
+            regla.MapId, regla.Difficulty, TextoDe(regla.Modo), banda,
+            regla.Nota.empty() ? "" : " :: ", regla.Nota));
+    }
+    return lineas;
+}
+
+ReglaEscalado const* EscaladoMgr::Buscar(uint32 mapId, uint16 difficulty) const
+{
+    // La regla exacta manda; si no hay, vale la de "cualquier dificultad" del mismo mapa.
+    if (auto it = _porMapaYDificultad.find(Clave(mapId, difficulty)); it != _porMapaYDificultad.end())
+        return &_reglas[it->second];
+
+    if (auto it = _porMapaYDificultad.find(Clave(mapId, CUALQUIER_DIFICULTAD));
+        it != _porMapaYDificultad.end())
+        return &_reglas[it->second];
+
+    return nullptr;
+}
+
+void EscaladoMgr::AplicarAlSpawn(Creature* criatura) const
+{
+    if (!criatura)
+        return;
+
+    Map* mapa = criatura->GetMap();
+    if (!mapa)
+        return;
+
+    uint16 dificultad = uint16(mapa->GetDifficultyID());
+    ReglaEscalado const* regla = Buscar(mapa->GetId(), dificultad);
+    if (!regla || regla->Modo == ModoEscalado::Cliente)
+        return;
+
+    switch (regla->Modo)
+    {
+        case ModoEscalado::Rango:
+        {
+            // Sin banda declarada no se adivina: una regla a medio llenar es un error de dato, no una
+            // excusa para inventar un nivel.
+            if (!regla->NivelMin || !regla->NivelMax || regla->NivelMin > regla->NivelMax)
+            {
+                TC_LOG_ERROR("scripts.miticas",
+                    "regla de rango invalida en el mapa {} dificultad {}: min {} max {} (se ignora)",
+                    regla->MapId, regla->Difficulty, regla->NivelMin, regla->NivelMax);
+                return;
+            }
+
+            // El delta no se toca: sigue siendo el del dato de la criatura (jefes +2, chusma 0).
+            criatura->SetScalingLevelRange(regla->NivelMin, regla->NivelMax);
+            break;
+        }
+        case ModoEscalado::Grupo:
+        {
+            uint8 nivelGrupo = 0;
+            for (auto const& referencia : mapa->GetPlayers())
+                if (Player* jugador = referencia.GetSource())
+                    if (jugador->GetLevel() > nivelGrupo)
+                        nivelGrupo = jugador->GetLevel();
+
+            if (!nivelGrupo)
+                return; // nadie adentro todavia: no hay nivel al que subir
+
+            if (criatura->HasScalableLevels())
+            {
+                // SelectLevel() tomara ScalingLevelMax + delta, asi que con este delta queda en el
+                // nivel del grupo sin tocar el nivel a mano.
+                criatura->SetScaledDisplayLevel(nivelGrupo);
+            }
+            else
+            {
+                // Criatura sin escalado del cliente (contenido viejo): se sube como en la corrida.
+                criatura->SetLevel(nivelGrupo);
+                criatura->UpdateLevelDependantStats();
+            }
+            break;
+        }
+        default:
+            return;
+    }
+
+    if (_avisados.insert(Clave(mapa->GetId(), dificultad)).second)
+        TC_LOG_INFO("scripts.miticas",
+            "escalado aplicado: mapa {} dificultad {} modo '{}' (regla: {})",
+            mapa->GetId(), dificultad, TextoDe(regla->Modo), regla->Nota);
+}
+} // namespace Instancias
+} // namespace Trinity
diff --git a/src/server/game/MythicPlus/EscaladoEstanciaMgr.h b/src/server/game/MythicPlus/EscaladoEstanciaMgr.h
new file mode 100644
index 0000000000..f3e1e9e105
--- /dev/null
+++ b/src/server/game/MythicPlus/EscaladoEstanciaMgr.h
@@ -0,0 +1,91 @@
+/*
+ * Escalado por estancia (Fase 2 del diseno: docs/sistemas/miticas/DISENO-DUNGEONS-ESCALABLES.md).
+ *
+ * VIVE EN MythicPlus/ POR UNA RAZON DE BUILD, no de tema: el CMake del core recolecta las fuentes con
+ * GLOB en el momento del configure (cmake/macros/AutoCollect.cmake, sin CONFIGURE_DEPENDS), asi que una
+ * carpeta nueva -y su cabecera en la ruta de include- no entra al build sin volver a configurar. Si el
+ * sistema crece, se muda a su propia carpeta y se re-configura el build de una vez.
+ *
+ * QUE HACE
+ *   Cuando una criatura entra al mundo (Creature::SelectLevel -> Creature::ApplyLevelScaling), mira si
+ *   su mapa y su dificultad tienen una regla en `world.instancia_escalado` y, si la tienen, ajusta los
+ *   campos de escalado que el cliente usa para ROTULAR (clamp(nivelDelJugador, ScalingLevelMin,
+ *   ScalingLevelMax) + ScalingLevelDelta) y que el core usa para la vida, el dano y la armadura.
+ *
+ *   El enganche es ese y no el arranque de la corrida a proposito: asi tambien quedan escaladas las
+ *   criaturas que APARECEN DESPUES del arranque (oleadas, invocadas, jefes que se suman a mitad), que
+ *   era el limite conocido de la Fase 1.
+ *
+ * MODOS (la perilla es DATO: se cambia con un UPDATE, no recompilando)
+ *   cliente : no se toca nada. Es el defecto y es el comportamiento medido del oficial: el rango sale
+ *             del ContentTuning del mapa/dificultad y el delta del dato de la criatura.
+ *             Medido en vivo el 21-sep-2026 en los calabozos de cronoviaje: jefes +2, notables +1,
+ *             chusma 0, ayudantes de mecanica en negativo.
+ *   rango   : la estancia juega en una banda declarada [nivel_min, nivel_max]. Es el "en la mazmorra
+ *             normal, un nivel 50" del pedido, y tambien el "heroica/mitica al tope de la expansion"
+ *             (declarando la banda, ej. 85-90).
+ *   grupo   : el contenido sube al nivel del miembro mas alto del grupo presente. Es lo que ya hacia
+ *             la corrida de miticas+ al arrancar.
+ *
+ * SI NO HAY FILA, NO PASA NADA: sin regla declarada el sistema es transparente y manda el cliente.
+ */
+#ifndef TRINITY_ESCALADO_ESTANCIA_MGR_H
+#define TRINITY_ESCALADO_ESTANCIA_MGR_H
+
+#include "Define.h"
+#include <cstdint>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+class Creature;
+
+namespace Trinity
+{
+namespace Instancias
+{
+enum class ModoEscalado : uint8
+{
+    Cliente = 0,
+    Rango,
+    Grupo
+};
+
+// Una regla de `world.instancia_escalado`. Difficulty 65535 = cualquier dificultad del mapa.
+struct ReglaEscalado
+{
+    uint32 MapId = 0;
+    uint16 Difficulty = 0;
+    ModoEscalado Modo = ModoEscalado::Cliente;
+    uint8 NivelMin = 0;
+    uint8 NivelMax = 0;
+    std::string Nota;
+};
+
+class EscaladoMgr
+{
+public:
+    static EscaladoMgr* instance();
+
+    void Cargar();                                    // lee world.instancia_escalado
+    void AplicarAlSpawn(Creature* criatura) const;    // enganche: al escalar la criatura recien creada
+    uint32 GetReglas() const { return uint32(_reglas.size()); }
+
+    // Lineas legibles para el comando de consola: las reglas que HACEN algo (las de modo 'cliente' no
+    // se listan una por una: son la mayoria y no cambian nada).
+    std::vector<std::string> DescribirReglas() const;
+
+private:
+    ReglaEscalado const* Buscar(uint32 mapId, uint16 difficulty) const;
+
+    std::vector<ReglaEscalado> _reglas;
+    std::map<uint64, size_t> _porMapaYDificultad;
+    mutable std::set<uint64> _avisados;               // una linea de log por (mapa, dificultad)
+};
+} // namespace Instancias
+} // namespace Trinity
+
+#define sEscaladoInstancia Trinity::Instancias::EscaladoMgr::instance()
+
+#endif
